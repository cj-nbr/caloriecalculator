---
import Layout from "./Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";
import Button from "../components/ui/Button.astro";
import ReviewBadge from "../components/ui/ReviewBadge.astro";
import ExpertBio from "../components/ui/ExpertBio.astro";
import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, faqSchema, articleSchema } from "../lib/seo";
import { DEFAULT_AUTHOR, DEFAULT_REVIEWER } from "../data/authors";
import type { Expert } from "../data/authors";

interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  category?: string;
  categoryPath?: string;
  lead?: string;
  updated?: string;
  faqs?: FaqItem[];
  showCta?: boolean;
  author?: Expert;
  reviewer?: Expert;
}

const {
  title,
  h1,
  description,
  path,
  category,
  categoryPath,
  lead,
  updated,
  faqs = [],
  showCta = true,
  author = DEFAULT_AUTHOR,
  reviewer = DEFAULT_REVIEWER,
} = Astro.props;

const crumbs = [
  { name: "Home", path: "/" },
  ...(category && categoryPath ? [{ name: category, path: categoryPath }] : []),
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  ...(category ? [articleSchema({ headline: h1, description, path, dateModified: updated, author, reviewer })] : []),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---

<Layout title={title} description={description} canonical={path} ogType="article" jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="container-page flex flex-wrap items-center gap-2 py-3 text-xs text-mute">
      {
        crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? (
              <a href={c.path} class="transition-colors hover:text-ink">{c.name}</a>
            ) : (
              <span class="text-body" aria-current="page">{c.name}</span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page max-w-3xl py-12 sm:py-16">
      {category && <p class="text-sm font-medium text-brand">{category}</p>}
      <h1 class="mt-2 text-display-lg text-ink">{h1}</h1>
      {lead && <p class="mt-4 text-lg text-body">{lead}</p>}
      <ReviewBadge updatedDate={updated || "August 2026"} />
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-mute">
         <div class="flex items-center gap-2"><img src={author.image} alt={author.name} class="w-6 h-6 rounded-full object-cover" /> <span>Written by <span class="font-medium text-ink">{author.name}</span></span></div>
         <div class="flex items-center gap-2"><img src={reviewer.image} alt={reviewer.name} class="w-6 h-6 rounded-full object-cover" /> <span>Reviewed by <span class="font-medium text-ink">{reviewer.name}</span></span></div>
      </div>
    </div>
  </header>

  <div class="container-page py-12 sm:py-16">
    <article class="prose-content mx-auto max-w-3xl">
      <slot />
      
      <ExpertBio expert={reviewer} title="Medically Reviewed By" />
      <ExpertBio expert={author} title="Written By" />
    </article>
  </div>

  {
    faqs.length > 0 && (
      <Section class="border-t border-hairline">
        <FaqSection items={faqs} />
      </Section>
    )
  }

  {
    showCta && (
      <Section class="border-t border-hairline">
        <div class="card relative overflow-hidden p-8 text-center sm:p-12">
          <div class="pointer-events-none absolute inset-0 opacity-[0.1]" style="background: linear-gradient(120deg,#007cf0,#00dfd8,#7928ca,#ff0080);" aria-hidden="true" />
          <div class="relative">
            <h2 class="text-display-sm text-ink">Calculate your numbers</h2>
            <p class="mx-auto mt-2 max-w-md text-body">Put this into practice - get your personalized calorie and macro targets free.</p>
            <div class="mt-6"><Button href="/#calculator" size="lg">Open the calculator</Button></div>
          </div>
        </div>
      </Section>
    )
  }
  {
    showCta && (
      <Section class="border-t border-hairline bg-canvas-soft">
        <div class="container-page">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-ink">Explore Popular Tools</h2>
            <p class="text-body mt-2">Discover more free calculators to optimize your fitness journey.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <a href="/tdee-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">TDEE Calculator</h3><p class="text-sm text-mute mt-1">Find your total daily energy expenditure.</p></a>
            <a href="/macro-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">Macro Calculator</h3><p class="text-sm text-mute mt-1">Calculate your perfect macro split.</p></a>
            <a href="/protein-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">Protein Calculator</h3><p class="text-sm text-mute mt-1">Find your optimal daily protein target.</p></a>
            <a href="/weight-loss-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">Weight Loss Calculator</h3><p class="text-sm text-mute mt-1">Map out your calorie deficit timeline.</p></a>
            <a href="/bmi-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">BMI Calculator</h3><p class="text-sm text-mute mt-1">Check your Body Mass Index score.</p></a>
            <a href="/body-fat-calculator/" class="card p-4 hover:border-ink transition-colors block"><h3 class="font-bold text-ink text-base">Body Fat Calculator</h3><p class="text-sm text-mute mt-1">Estimate your body fat percentage.</p></a>
          </div>
        </div>
      </Section>
    )
  }
</Layout>

