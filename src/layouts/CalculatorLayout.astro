---
import Layout from "./Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";
import ReviewBadge from "../components/ui/ReviewBadge.astro";
import ExpertBio from "../components/ui/ExpertBio.astro";
import { NAV, FOOTER, ALL_CALCULATORS } from "../data/site";
import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, calculatorSchema, faqSchema } from "../lib/seo";
import { DEFAULT_AUTHOR, DEFAULT_REVIEWER } from "../data/authors";
import type { Expert } from "../data/authors";

interface Props {
  title: string;
  h1: string;
  description: string;
  intro: string;
  path: string;
  faqs?: FaqItem[];
  author?: Expert;
  reviewer?: Expert;
}

const { 
  title, 
  h1, 
  description, 
  intro, 
  path, 
  faqs = [],
  author = DEFAULT_AUTHOR,
  reviewer = DEFAULT_REVIEWER
} = Astro.props;

const crumbs = [
  { name: "Home", path: "/" },
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  calculatorSchema(h1, description, path, reviewer),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];

const related = ALL_CALCULATORS.filter((c) => c.href !== path).slice(0, 6);
---

<Layout title={title} description={description} canonical={path} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="container-page flex items-center gap-2 py-3 text-xs text-mute">
      {
        crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">/</span>}
            {i < crumbs.length - 1 ? (
              <a href={c.path} class="transition-colors hover:text-ink">{c.name}</a>
            ) : (
              <span class="text-body" aria-current="page">{c.name}</span>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <h1 class="max-w-3xl text-display-lg text-ink">{h1}</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">{intro}</p>
      <ReviewBadge updatedDate="August 2026" />
      <div class="mt-4 flex flex-wrap gap-4 text-sm text-mute">
         <div class="flex items-center gap-2"><img src={author.image} alt={author.name} class="w-6 h-6 rounded-full object-cover" /> <span>Built & written by <span class="font-medium text-ink">{author.name}</span></span></div>
         <div class="flex items-center gap-2"><img src={reviewer.image} alt={reviewer.name} class="w-6 h-6 rounded-full object-cover" /> <span>Medically reviewed by <span class="font-medium text-ink">{reviewer.name}</span></span></div>
      </div>
    </div>
  </header>

   <Section class="!py-12 sm:!py-16">
     <slot />
   </Section>

   <div class="border-t border-hairline">
    <div class="container-page py-12 sm:py-16">
      <div class="prose-content mx-auto max-w-3xl">
        <slot name="content" />
        
        <ExpertBio expert={reviewer} title="Medically Reviewed By" />
      </div>
    </div>
  </div>

  {
    faqs.length > 0 && (
      <Section class="border-t border-hairline">
        <FaqSection items={faqs} />
      </Section>
    )
  }

  <Section class="border-t border-hairline">
    <h2 class="text-display-sm text-ink">Related calculators</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        related.map((c) => (
          <a
            href={c.href}
            class="card group flex items-center justify-between gap-3 p-4 transition-all hover:border-hairline-strong hover:bg-canvas-soft"
          >
            <div>
              <span class="block text-sm font-medium text-ink">{c.label}</span>
              {c.desc && <span class="block text-xs text-mute">{c.desc}</span>}
            </div>
            <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>

<style is:global>
  .prose-content h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .prose-content h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content p {
    color: var(--color-body);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-body);
  }
  .prose-content li {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }
  .prose-content a {
    color: var(--color-brand);
  }
  .prose-content a:hover {
    text-decoration: underline;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .prose-content th,
  .prose-content td {
    border: 1px solid var(--color-hairline);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose-content th {
    color: var(--color-ink);
    font-weight: 600;
    background: var(--color-canvas-soft);
  }
  .prose-content td {
    color: var(--color-body);
  }
</style>
