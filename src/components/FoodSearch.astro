---
/**
 * FoodSearch — nutrition lookup tool. Calls the /api/food-search Pages Function
 * (USDA proxy) and scales the per-100g data by the entered quantity + unit.
 * All logic is client-side vanilla TS; no third-party libraries.
 */
import { inputCls, selectCls } from "../lib/ui";
import { FOOD_SUGGESTIONS } from "../data/food-suggestions";

const examples = ["Banana", "100g rice", "Apple", "Egg", "Chicken breast", "Milk"];
---

<div id="food-tool" class="not-prose">
  <!-- Helper note -->
  <div class="mb-5 space-y-2">
    <p class="text-sm text-body">
      🍎 <strong class="text-ink">Type a food, choose how much, and we'll show you the calories and nutrition.</strong> Easy!
    </p>
    <p class="rounded-lg border border-hairline bg-canvas-soft px-4 py-3 text-xs leading-relaxed text-mute">
      Nutrition values are estimates based on trusted food databases. Results may
      vary by brand, preparation method, and serving size.
    </p>
  </div>

  <form id="food-form" class="card p-5 sm:p-6" novalidate>
    <div class="space-y-4">
      <div class="space-y-1.5 relative">
        <label for="food-q" class="block text-sm font-medium text-ink">1. What food?</label>
        <input
          id="food-q"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Type a food, like banana, rice, or pizza"
          class={inputCls}
        />
        <!-- Suggestions dropdown -->
        <div id="food-suggestions" class="absolute top-full left-0 right-0 mt-1 z-10 hidden max-h-64 overflow-y-auto rounded-lg border border-hairline bg-surface shadow-lg"></div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <label for="food-qty" class="block text-sm font-medium text-ink">2. How much?</label>
          <input id="food-qty" type="number" inputmode="decimal" min="0" step="any" value="100" class={inputCls} />
        </div>
        <div class="space-y-1.5">
          <label for="food-unit" class="block text-sm font-medium text-ink">Measured in</label>
          <div class="relative">
            <select id="food-unit" class={selectCls}>
              <option value="g" selected>Gram (g)</option>
              <option value="kg">Kilogram (kg)</option>
              <option value="ml">Milliliter (ml)</option>
              <option value="l">Liter (L)</option>
              <option value="oz">Ounce (oz)</option>
              <option value="lb">Pound (lb)</option>
              <option value="cup">Cup</option>
              <option value="tbsp">Tablespoon</option>
              <option value="tsp">Teaspoon</option>
              <option value="piece">Piece</option>
              <option value="serving">Serving</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
      </div>
      <button type="submit" id="food-submit" class="inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99] disabled:opacity-60">
        Find Calories
      </button>
    </div>

    <!-- Example chips -->
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="text-xs text-mute">Try:</span>
      {
        examples.map((e) => (
          <button type="button" class="food-example rounded-full border border-hairline px-3 py-1 text-xs text-body transition-colors hover:border-ink hover:text-ink" data-q={e}>
            {e}
          </button>
        ))
      }
    </div>
  </form>

  <!-- Results region -->
  <div id="food-results" class="mt-6" aria-live="polite">
    <!-- Empty state -->
    <div id="food-empty" class="card p-8 text-center text-sm text-mute">
      👆 Type a food above and tap "Find Calories" to see how much energy and nutrition it has.
    </div>

    <!-- Loading state -->
    <div id="food-loading" class="hidden card p-8 text-center">
      <div class="mx-auto h-6 w-6 animate-spin rounded-full border-2 border-hairline border-t-brand"></div>
      <p class="mt-3 text-sm text-mute">Searching nutrition database…</p>
    </div>

    <!-- Error state -->
    <p id="food-error" role="alert" class="hidden rounded-lg border border-error/40 bg-error/10 px-4 py-3 text-sm text-body"></p>

    <!-- Result card -->
    <div id="food-card" class="hidden card overflow-hidden">
      <div class="border-b border-hairline p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 id="food-name" class="text-display-sm text-ink">—</h2>
            <p id="food-meta" class="mt-1 text-xs text-mute"></p>
          </div>
        </div>
        <!-- Match switcher (shown when multiple results) -->
        <div id="food-switch-wrap" class="mt-3 hidden">
          <label for="food-switch" class="mb-1 block text-xs text-mute">Not the right item? Choose another match:</label>
          <div class="relative">
            <select id="food-switch" class={selectCls}></select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
      </div>

      <!-- Headline calories -->
      <div class="grid gap-px bg-hairline sm:grid-cols-4">
        <div class="bg-surface p-5 text-center sm:text-left">
          <p class="text-xs uppercase tracking-wide text-mute">Calories</p>
          <p><span id="n-calories" class="text-display-sm text-ink tabular-nums">—</span> <span class="text-sm text-mute">kcal</span></p>
          <p class="mt-0.5 text-[11px] text-mute">energy for your body</p>
        </div>
        <div class="bg-surface p-5 text-center sm:text-left">
          <p class="text-xs uppercase tracking-wide text-mute">Protein</p>
          <p id="n-protein" class="text-display-sm text-ink tabular-nums">—</p>
          <p class="mt-0.5 text-[11px] text-mute">builds muscles</p>
        </div>
        <div class="bg-surface p-5 text-center sm:text-left">
          <p class="text-xs uppercase tracking-wide text-mute">Carbs</p>
          <p id="n-carbs" class="text-display-sm text-ink tabular-nums">—</p>
          <p class="mt-0.5 text-[11px] text-mute">quick energy</p>
        </div>
        <div class="bg-surface p-5 text-center sm:text-left">
          <p class="text-xs uppercase tracking-wide text-mute">Fat</p>
          <p id="n-fat" class="text-display-sm text-ink tabular-nums">—</p>
          <p class="mt-0.5 text-[11px] text-mute">stores energy</p>
        </div>
      </div>

      <div class="p-5">
        <p id="food-portion" class="mb-4 text-sm text-body"></p>
        <table class="w-full text-sm">
          <caption class="sr-only">Full nutrition facts for the entered quantity</caption>
          <tbody id="food-nutrients"></tbody>
        </table>

        <div id="food-vm" class="mt-5 hidden">
          <h3 class="text-sm font-semibold text-ink">Vitamins & minerals</h3>
          <div id="food-vm-list" class="mt-2 flex flex-wrap gap-2"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{suggestions: FOOD_SUGGESTIONS}}>
  const ALL_FOODS = suggestions;

  const root = document.getElementById("food-tool");
  if (root) {
    const $ = (id) => document.getElementById(id);
    const form = $("food-form");
    const qEl = $("food-q");
    const qtyEl = $("food-qty");
    const unitEl = $("food-unit");
    const submit = $("food-submit");
    const switchSel = $("food-switch");

    let results = [];

    const UNIT_G = {
      g: 1, kg: 1000, ml: 1, l: 1000, oz: 28.3495, lb: 453.592,
      cup: 240, tbsp: 15, tsp: 5,
    };

    function gramsFor(food) {
      const qty = parseFloat(qtyEl.value) || 0;
      const unit = unitEl.value;
      if (unit === "serving" || unit === "piece") {
        const ss = food.servingSize && /g|gram|ml/i.test(food.servingSizeUnit || "")
          ? food.servingSize
          : 100;
        return qty * ss;
      }
      return qty * (UNIT_G[unit] || 1);
    }

    const show = (id) => $(id).classList.remove("hidden");
    const hide = (id) => $(id).classList.add("hidden");

    function fmt(v, dp = 1) {
      if (v == null) return "—";
      return (Math.round(v * 10 ** dp) / 10 ** dp).toLocaleString("en-US");
    }

    function row(label, value, unit) {
      return `<tr class="border-b border-hairline last:border-0"><td class="py-2 text-body">${label}</td><td class="py-2 text-right font-medium text-ink tabular-nums">${fmt(value)} ${unit}</td></tr>`;
    }

    function render() {
      const food = results[parseInt(switchSel.value || "0", 10)] || results[0];
      if (!food) return;
      const grams = gramsFor(food);
      const factor = grams / 100;
      const sc = (v) => (v == null ? null : v * factor);
      const p = food.per100g;

      $("food-name").textContent = food.description;
      $("food-meta").textContent = [food.brandName, food.dataType].filter(Boolean).join(" · ");

      $("n-calories").textContent = fmt(sc(p.calories), 0);
      $("n-protein").textContent = fmt(sc(p.protein)) + " g";
      $("n-carbs").textContent = fmt(sc(p.carbs)) + " g";
      $("n-fat").textContent = fmt(sc(p.fat)) + " g";

      const qtyTxt = `${qtyEl.value} ${unitEl.options[unitEl.selectedIndex].text}`;
      $("food-portion").innerHTML = `Nutrition for <strong class="text-ink">${qtyTxt}</strong> (&asymp; ${fmt(grams, 0)} g)`;

      $("food-nutrients").innerHTML =
        row("Calories", sc(p.calories), "kcal") +
        row("Protein", sc(p.protein), "g") +
        row("Carbohydrates", sc(p.carbs), "g") +
        row("Total fat", sc(p.fat), "g") +
        row("Saturated fat", sc(p.saturatedFat), "g") +
        row("Trans fat", sc(p.transFat), "g") +
        row("Fiber", sc(p.fiber), "g") +
        row("Sugar", sc(p.sugar), "g") +
        row("Sodium", sc(p.sodium), "mg") +
        row("Potassium", sc(p.potassium), "mg") +
        row("Cholesterol", sc(p.cholesterol), "mg");

      const vm = { ...food.vitamins, ...food.minerals };
      const keys = Object.keys(vm);
      if (keys.length) {
        $("food-vm-list").innerHTML = keys
          .map((k) => `<span class="rounded-full border border-hairline px-3 py-1 text-xs text-body">${k}: <span class="text-ink">${fmt(vm[k].value * factor)} ${vm[k].unit}</span></span>`)
          .join("");
        show("food-vm");
      } else {
        hide("food-vm");
      }
    }

    function renderSuggestions(matches) {
      const suggestionsEl = $("food-suggestions");
      if (matches.length === 0) {
        suggestionsEl.innerHTML = "";
        suggestionsEl.classList.add("hidden");
        return;
      }
      suggestionsEl.innerHTML = matches
        .map((s) => `<button type="button" class="food-suggest-item w-full px-3.5 py-2 text-left text-sm text-body hover:bg-canvas-soft hover:text-ink transition-colors" data-term="${s}">${s}</button>`)
        .join("");
      suggestionsEl.classList.remove("hidden");
    }

    function hideSuggestions() {
      const suggestionsEl = $("food-suggestions");
      suggestionsEl.innerHTML = "";
      suggestionsEl.classList.add("hidden");
    }

    async function searchFood(term) {
      qEl.value = term;
      hide("food-empty"); hide("food-card"); hide("food-error");
      show("food-loading");
      submit.disabled = true;
      hideSuggestions();
      try {
        const res = await fetch(`/api/food-search?q=${encodeURIComponent(term)}`, {
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        hide("food-loading");
        if (!res.ok || !data.results || data.results.length === 0) {
          $("food-error").textContent = data.error || "No results found. Try a different food.";
          show("food-error");
          return;
        }
        results = data.results;
        switchSel.innerHTML = results
          .map((r, i) => `<option value="${i}">${r.description}${r.brandName ? " — " + r.brandName : ""}</option>`)
          .join("");
        switchSel.value = "0";
        $("food-switch-wrap").classList.toggle("hidden", results.length < 2);
        show("food-card");
        render();
      } catch {
        hide("food-loading");
        $("food-error").textContent = "Network error — please check your connection and try again.";
        show("food-error");
      } finally {
        submit.disabled = false;
      }
    }

    // Event listeners
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const term = qEl.value.trim();
      if (term) searchFood(term);
    });

    qEl.addEventListener("input", () => {
      const term = qEl.value.trim().toLowerCase();
      if (term.length < 1) {
        hideSuggestions();
        return;
      }
      const matches = ALL_FOODS.filter((f) => f.toLowerCase().includes(term)).slice(0, 8);
      renderSuggestions(matches);
    });

    qEl.addEventListener("blur", () => {
      setTimeout(hideSuggestions, 200);
    });

    qtyEl.addEventListener("input", () => { if (results.length) render(); });
    unitEl.addEventListener("change", () => { if (results.length) render(); });
    switchSel.addEventListener("change", render);

    root.querySelectorAll(".food-example").forEach((b) => {
      b.addEventListener("click", () => searchFood(b.dataset.q || ""));
    });

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (target.classList.contains("food-suggest-item")) {
        const term = target.dataset.term;
        if (term) {
          hideSuggestions();
          searchFood(term);
        }
      }
    });
  }
</script>