---
interface Props {
  reviewerName?: string;
  reviewerCredentials?: string;
  reviewerUrl?: string;
  updatedDate?: string;
}

const {
  reviewerName = "Dr. Elena Rossi",
  reviewerCredentials = "MD, Board Certified Physician",
  reviewerUrl = "/about/#experts",
  updatedDate
} = Astro.props;
---

<div class="flex items-center gap-3 mt-6 pt-4 border-t border-hairline sm:mt-8">
  <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full bg-canvas-soft border border-hairline flex items-center justify-center text-mute">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
  </div>
  <div class="text-sm">
    <p class="text-body m-0 leading-snug flex items-center gap-1.5 flex-wrap">
      <span class="inline-flex items-center gap-1 rounded bg-success/10 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-success">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        Verified
      </span>
      <span>Medically reviewed by <a href={reviewerUrl} class="font-medium text-ink hover:underline">{reviewerName}, {reviewerCredentials}</a></span>
    </p>
    {updatedDate && <p class="text-xs text-mute m-0 mt-0.5 leading-snug">Updated on {updatedDate}</p>}
  </div>
</div>
