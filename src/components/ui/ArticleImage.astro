---
/**
 * ArticleImage — consistent, accessible, responsive image for article bodies.
 * Defaults to lazy loading and a constrained max width. Pass a meaningful
 * `alt` describing the image; decorative images should set alt="" explicitly.
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { src, alt, class: className = "", width, height } = Astro.props;

let finalSrc = src;

// Replace vector SVGs with high-quality real images from Unsplash
if (src.includes(".svg")) {
  const filename = src.toLowerCase();
  
  // Gym & Workouts
  if (filename.includes("workout") || filename.includes("leg") || filename.includes("chest") || filename.includes("shoulder") || filename.includes("back") || filename.includes("barbell") || filename.includes("exercise")) {
    finalSrc = "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=800&q=80"; // Gym/Weights
  } 
  // Nutrition & Macros
  else if (filename.includes("plate") || filename.includes("macro") || filename.includes("protein") || filename.includes("recipe") || filename.includes("calorie") || filename.includes("energy")) {
    finalSrc = "https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&w=800&q=80"; // Healthy food bowl
  }
  // Running & Cardio
  else if (filename.includes("run") || filename.includes("walk") || filename.includes("pace")) {
    finalSrc = "https://images.unsplash.com/photo-1476480862126-209bcaa8ea47?auto=format&fit=crop&w=800&q=80"; // Running outdoors
  }
  // Weight & Measurement (BMI, BMR, Scales)
  else if (filename.includes("bmi") || filename.includes("bmr") || filename.includes("scale") || filename.includes("weight") || filename.includes("tape") || filename.includes("body")) {
    finalSrc = "https://images.unsplash.com/photo-1584308666744-247e8f68e0d6?auto=format&fit=crop&w=800&q=80"; // Tape measure / scale
  }
  // Pregnancy & Time
  else if (filename.includes("pregnancy") || filename.includes("conception") || filename.includes("date") || filename.includes("fasting")) {
    finalSrc = "https://images.unsplash.com/photo-1511285560929-80a456fea0bc?auto=format&fit=crop&w=800&q=80"; // Clock / Time
  }
  // Fallback health image
  else {
    finalSrc = "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80"; // Healthy lifestyle
  }
}
---

<figure class={`not-prose my-8 ${className}`}>
  <div class="rounded-2xl border border-hairline bg-white p-2 dark:bg-white">
    <img
      src={finalSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      {width}
      {height}
      class="mx-auto h-auto w-full max-w-2xl rounded-xl object-cover shadow-sm aspect-video"
    />
  </div>
</figure>
