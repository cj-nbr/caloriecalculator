---
/**
 * Button — Vercel-style pill button. Renders an <a> when `href` is given,
 * otherwise a <button>.
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-medium rounded-full transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:opacity-50 disabled:pointer-events-none whitespace-nowrap";

const variants = {
  primary:
    "bg-ink text-canvas hover:opacity-90 active:scale-[0.98] shadow-sm",
  secondary:
    "bg-canvas text-ink border border-hairline-strong hover:border-ink hover:bg-canvas-soft active:scale-[0.98]",
  ghost: "text-body hover:text-ink hover:bg-canvas-soft",
};

const sizes = {
  md: "h-9 px-4 text-sm",
  lg: "h-12 px-6 text-base",
};

const cls = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
