---
import type { Expert } from "../../data/authors";

interface Props {
  expert: Expert;
  title?: string;
}

const { expert, title = "Medical Reviewer" } = Astro.props;
---

<div class="not-prose mt-8 rounded-2xl border border-hairline bg-canvas-soft p-5 sm:p-6 flex flex-col sm:flex-row gap-5 items-start">
  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full border border-hairline bg-white shadow-sm">
    <img src={expert.image} alt={expert.name} class="h-full w-full object-cover" loading="lazy" />
  </div>
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-brand">{title}</p>
    <h3 class="mt-1 text-lg font-bold text-ink">{expert.name} <span class="text-sm font-normal text-mute">({expert.credentials})</span></h3>
    <p class="mt-2 text-sm text-body leading-relaxed">{expert.bio}</p>
  </div>
</div>
