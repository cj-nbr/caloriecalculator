const faqs: FaqItem[] = [
  { q: "How accurate is a bike calorie calculator?", a: "Bike calorie calculators using MET values are estimates within 10–20% of actual burn. Accuracy depends on weight, speed, terrain, and effort level. Use them as a guide, not an exact measurement." },
  { q: "What is the formula for calories burned biking?", a: "Calories per minute = MET × 3.5 × weight (kg) ÷ 200. Multiply by duration in minutes for total burn. A 70 kg rider at 6.0 MET for 60 minutes burns about 735 calories." },
  { q: "Does cycling speed change calorie burn?", a: "Yes. Faster speeds increase air resistance and effort. Going from 10 mph to 20 mph can double or triple calories burned per minute for the same rider." },
  { q: "Should I use a cycling calculator for indoor or outdoor biking?", a: "Both. Outdoor cycling includes wind and terrain variables. Indoor cycling removes wind resistance but lets you control resistance precisely. Use the <a href='/cycling-calories-calculator/'>cycling calories calculator</a> for either." },
  { q: "Can cycling really help with weight loss?", a: "Yes. Cycling burns 400–800+ calories per hour and is low-impact, making it sustainable for daily or near-daily sessions. Pair it with a modest calorie deficit for steady fat loss." },
];

