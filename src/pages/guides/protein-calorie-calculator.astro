const faqs: FaqItem[] = [
  { q: "How many calories are in a gram of protein?", a: "There are exactly 4 calories (kcal) in one gram of protein. You can calculate total protein calories by multiplying the grams of protein by 4." },
  { q: "How many calories is 150 grams of protein?", a: "150 grams of protein is exactly 600 calories. Calculate this by multiplying 150g by 4 calories per gram (150 × 4 = 600)." },
  { q: "How many calories is 100 grams of protein?", a: "100 grams of protein provides 400 calories (100g × 4 kcal/g = 400 kcal)." },
  { q: "How many calories does it take to digest a gram of protein?", a: "Your body burns about 20% to 30% of protein calories during digestion due to the Thermic Effect of Food (TEF). This means out of the 4 calories in a gram of protein, your body burns about 0.8 to 1.2 calories just to process it." },
  { q: "What is a good protein to calorie ratio?", a: "A highly recommended standard is the 10-to-1 ratio: aim for at least 10 grams of protein for every 100 calories of food. For example, a 150-calorie snack should ideally have 15g of protein to be considered 'high protein'." },
  { q: "How many calories is 130 grams of protein?", a: "130 grams of protein is equal to 520 calories (130g × 4 kcal/g = 520 kcal)." },
  { q: "How many calories is 180 grams of protein?", a: "180 grams of protein is equal to 720 calories (180g × 4 kcal/g = 720 kcal)." }
];
---

<ContentLayout
