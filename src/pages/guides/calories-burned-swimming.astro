const faqs: FaqItem[] = [
  { q: "How many calories does swimming burn?", a: "A 70 kg person burns roughly 420 calories during 30 minutes of moderate swimming. Vigorous swimming or butterfly can push that to 600+ calories in the same time." },
  { q: "Does swimming burn more calories than running?", a: "Running burns slightly more per minute, but swimming is gentler on the joints and can be sustained for longer sessions. For joint-sensitive people, swimming may yield higher total weekly calorie burn." },
  { q: "Which swimming stroke burns the most calories?", a: "Butterfly burns the most (~13.0 MET), followed by freestyle and backstroke (~7.0–10.0 MET). Breaststroke is lowest intensity. Technique and pace change the exact numbers." },
  { q: "Can swimming help me lose weight?", a: "Yes. Swimming is full-body, low-impact cardio that burns serious calories. 3–5 sessions per week of 30–60 minutes, paired with a modest calorie deficit, supports steady fat loss." },
  { q: "How do I estimate calories burned swimming?", a: "Use MET values: Calories per minute = MET × 3.5 × weight (kg) ÷ 200. Moderate swimming is 7.0 MET, vigorous is 10.0 MET. Use the <a href='/swimming-calories-calculator/'>swimming calories calculator</a> for automatic estimates." },
];

