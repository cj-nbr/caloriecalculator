<ContentLayout
  title="Maintenance Calorie Calculator — Find Your Daily Calorie Needs"
  h1="Maintenance Calorie Calculator"
  description="Find exactly how many calories you need daily to maintain your current weight. Our free maintenance calorie calculator uses your stats and activity level for accurate results."
  path="/guides/maintenance-calorie-calculator/"
