---
import ContentLayout from "../../layouts/ContentLayout.astro";
import type { FaqItem } from "../../lib/seo";
import ArticleImage from "../../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "What are maintenance calories?", a: "Maintenance calories are the number of calories you need to eat each day to keep your current weight. They are the same as your Total Daily Energy Expenditure (TDEE)." },
  { q: "How do I find my maintenance calories?", a: "Use the <a href='/maintenance-calories-calculator/'>maintenance calories calculator</a> with your age, height, weight, sex, and activity level to get a personalized daily target." },
  { q: "Is maintenance the same as BMR?", a: "BMR is calories burned at complete rest. Maintenance calories add daily movement and exercise. Use the <a href='/bmr-calculator/'>BMR calculator</a> for your baseline, then multiply by activity." },
  { q: "Can maintenance calories change?", a: "Yes. Weight gain, weight loss, muscle changes, and activity shifts all change maintenance. Recalculate every 4–6 weeks or after a 5 kg weight change." },
  { q: "What happens if I eat above maintenance?", a: "A small surplus leads to gradual weight gain. Use the <a href='/weight-gain-calculator/'>weight gain calculator</a> to control the rate and minimize fat gain." },
  { q: "What happens if I eat below maintenance?", a: "A deficit leads to weight loss. Use the <a href='/calorie-deficit-calculator/'>calorie deficit calculator</a> to pick a safe pace and preserve muscle." },
  { q: "How accurate is maintenance calorie math?", a: "Within ±5–10% for most people. Adjust based on real-world results, hunger, energy, and weekly weight trends." },
  { q: "Do I need to count calories forever?", a: "Not forever. Many people track strictly during transitions, then shift to portion-based eating once they know their maintenance range." },
];
---

<ContentLayout
  title="Maintenance Calories: How to Stay at Your Ideal Weight"
  h1="Maintenance Calories: How to Stay at Your Ideal Weight"
  description="Learn what maintenance calories are, why they shift over time, and how to keep your weight stable without constant tracking."
  path="/guides/maintenance-calories/"
  category="Guides"
  categoryPath="/guides/"
  lead="Maintenance calories are your real-world daily calorie budget. Here is how to find them and stay stable."
  updated="July 2026"
  faqs={faqs}
>
  <h2 id="what-are-maintenance">What maintenance calories really are</h2>
  <p>Maintenance calories are the calories you burn in a normal day — not at complete rest, but when you combine your resting metabolism with daily movement. In other words, maintenance calories equal your TDEE, and eating that amount keeps your weight stable.</p>

  <ArticleImage src="/assets/images/articles/balance-scale.svg" alt="Illustration of a balanced scale representing calories in versus calories out for weight maintenance." />

  <h2 id="bmr-vs-tdee">BMR vs TDEE vs maintenance calories</h2>
  <ul>
    <li><strong>BMR:</strong> calories burned at complete rest. Use the <a href="/bmr-calculator/">BMR calculator</a>.</li>
    <li><strong>TDEE:</strong> BMR multiplied by activity. Use the <a href="/tdee-calculator/">TDEE calculator</a>.</li>
    <li><strong>Maintenance calories:</strong> your TDEE — the number you eat to hold your current weight.</li>
  </ul>

  <h2 id="how-to-find">How to find your maintenance calories</h2>
  <p>Use the <a href="/maintenance-calories-calculator/">maintenance calories calculator</a> with an accurate activity level. Be honest about movement: desk jobs, walking, and structured exercise all count. Then follow your target for 1–2 weeks and track weight changes.</p>

  <h2 id="when-to-adjust">When maintenance calories shift</h2>
  <p>Every 4–6 weeks, or after a 5 kg weight change, recalculate. Muscle gain, fat loss, and activity changes all shift your needs. The <a href="/">calorie calculator</a> can help you refresh your target quickly.</p>

  <h2 id="staying-stable">Staying stable without constant tracking</h2>
  <p>Once you know your maintenance range, you can shift toward portion-based eating instead of strict counting. Use the <a href="/meal-calorie-calculator/">meal calorie calculator</a> to pre-plan meals, and the <a href="/macro-calculator/">macro calculator</a> to keep protein high while carbs and fats balance naturally.</p>
</ContentLayout>
