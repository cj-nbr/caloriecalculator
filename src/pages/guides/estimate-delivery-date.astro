---
import MedicalNote from "../../components/ui/MedicalNote.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import Sources from "../../components/ui/Sources.astro";
import type { FaqItem } from "../../lib/seo";

const faqs: FaqItem[] = [
  { q: "How do you estimate delivery date?", a: "Delivery date is commonly estimated by Naegele's rule: add 280 days to the start of the last menstrual period. See our <a href='/due-date-calculator/'>due date calculator</a>." },
  { q: "What is Naegele's rule?", a: "Naegele's rule adds 280 days to the first day of the last menstrual period. It assumes a 28-day cycle with ovulation on day 14." },
  { q: "How accurate are pregnancy due date calculators?", a: "Only about 4% of babies arrive on their exact due date. Most births fall within two weeks before or after." },
  { q: "Can I calculate my due date from conception date?", a: "Yes. Add 266 days to the conception date. Use our <a href='/pregnancy-conception-calculator/'>conception calculator</a>." },
  { q: "What happens if my period is irregular?", a: "Irregular cycles make LMP-based dating less reliable. Early ultrasound dating is preferred." },
  { q: "What is the difference between gestational age and fetal age?", a: "Gestational age counts from the first day of the last menstrual period. Fetal age counts from actual conception." },
  { q: "How do pregnancy calculators work?", a: "Pregnancy calculators use LMP, conception date, or ultrasound data. Our <a href='/due-date-calculator/'>due date calculator</a> and <a href='/pregnancy-calculator/'>pregnancy calculator</a> cover both methods." },
];

---

<ContentLayout
  title="Estimate Delivery Date — How Due Date Calculators Work"
  h1="Estimate Delivery Date"
  description="Learn how to estimate your delivery date using Naegele's rule and pregnancy calculators."
  path="/guides/estimate-delivery-date/"
  category="Guides"
  categoryPath="/guides/"
  lead="A due date is an estimate, not a guarantee."
  updated="July 2026"
  faqs={faqs}
>

  <MedicalNote />

  <p>An <strong>estimated delivery date</strong> is the date a baby is expected to be born. It is calculated from the mother's last menstrual period, conception date, or early ultrasound measurements.</p>

  <ArticleImage src="/assets/images/articles/pregnancy-calendar.svg" alt="Illustration of a pregnancy calendar showing estimated due date and trimesters." />

  <h2>Naegele's rule</h2>
  <p>The most common due date method is Naegele's rule: add 280 days to the first day of the last menstrual period. For example, an LMP of 1 March 2026 becomes a due date of 8 December 2026. This assumes a 28-day cycle with ovulation on day 14.</p>

  <h2>Conception-based dating</h2>
  <p>If you know the approximate conception date, add 266 days (38 weeks). This is often shorter than LMP-based estimates by about two weeks.</p>

  <h2>Ultrasound dating</h2>
  <p>First-trimester ultrasounds are the most accurate way to estimate gestational age, with an error margin of about 5-7 days. Later ultrasounds are less precise.</p>

  <h2>Related calculators</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="card p-4">
      <h3 class="text-lg font-semibold text-ink"><a href="/due-date-calculator/">Due Date Calculator</a></h3>
      <p class="mt-1 text-sm text-body">Estimate your delivery date from your last period or conception date.</p>
    </div>
    <div class="card p-4">
      <h3 class="text-lg font-semibold text-ink"><a href="/pregnancy-calculator/">Pregnancy Calculator</a></h3>
      <p class="mt-1 text-sm text-body">Track weeks, trimesters, and expected milestones.</p>
    </div>
  </div>

  <Sources sources={[
    { label: "NICE Guideline - Antenatal Care for Uncomplicated Pregnancies", href: "https://www.nice.org.uk/guidance/cg62" },
    { label: "ACOG - Methods for Estimating the Due Date", href: "https://www.acog.org/clinical/clinical-guidance/committee-opinion/articles/2017/05/methods-for-estimating-the-due-date" },
  ]} />
</ContentLayout>
