---
import CalorieCalculator from '../../components/calculators/CalorieCalculator.astro';
import MedicalNote from "../../components/ui/MedicalNote.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import type { FaqItem } from "../../lib/seo";

const faqs: FaqItem[] = [
  { q: "What is a TDEE calculator?", a: "A Total Daily Energy Expenditure (TDEE) calculator finds your maintenance calories. Eating exactly this amount allows you to maintain your current body weight without gaining or losing fat." },
  { q: "How does a TDEE calculator work?", a: "It typically calculates your Basal Metabolic Rate (BMR) using the Mifflin-St Jeor equation, and then multiplies it by your physical activity level multiplier to estimate your total daily calorie burn." },
  { q: "Why might my TDEE be incorrect?", a: "The most common errors include overestimating physical activity levels, inputting incorrect body fat percentage, or experiencing metabolic adaptation. Track your weight daily to verify and make adjustments accordingly." },
  { q: "Can I use the TDEE calculator for weight loss?", a: "Yes. By simply subtracting 250 to 500 calories from your daily maintenance calories, you can achieve sustainable, healthy weight loss." },
  { q: "What is the difference between TDEE and BMR?", a: "BMR (Basal Metabolic Rate) is the number of calories you burn at absolute rest, whereas TDEE includes your BMR plus the calories burned through daily movement, exercise, and food digestion." },
  { q: "How often should I recalculate my TDEE?", a: "You should recalculate your TDEE for every 5 to 10 pounds (2 to 4.5 kg) of body weight lost or gained, as your energy requirements change alongside your body mass." },
  { q: "Does muscle mass affect my TDEE?", a: "Absolutely. Muscle is a highly metabolically active tissue. The more muscle mass you carry, the higher your BMR will be, which consequently elevates your overall TDEE even at rest." }
];

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<ContentLayout
  title="TDEE Calculator — Total Daily Energy Expenditure Explained"
  h1="TDEE Calculator"
  description="Our free TDEE calculator finds your maintenance calories. Learn about Total Daily Energy Expenditure and use it for weight loss, muscle gain, or healthy weight maintenance."
  path="/resources/tdee-calculator/"
  category="Resources"
  categoryPath="/resources/"
  lead="Your TDEE is the exact number of calories you need to consume to maintain your current weight. Discover how to calculate it accurately and use it to your advantage."
  updated="September 2026"
  faqs={faqs}
>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <MedicalNote />

  <ArticleImage src="/assets/images/articles/metabolism-chart.svg" alt="Infographic detailing the components of Total Daily Energy Expenditure (TDEE)." />
  
  <div class="prose prose-lg mx-auto mt-8">
    <div class="bg-white/80 backdrop-blur-md rounded-3xl shadow-xl p-8 mb-10 border border-gray-100/50 relative overflow-hidden">
      <div class="absolute top-0 right-0 -mt-16 -mr-16 w-32 h-32 bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-full blur-2xl pointer-events-none"></div>
      <p class="text-xl leading-relaxed text-gray-700 font-medium">
        A <strong>Total Daily Energy Expenditure (TDEE) calculator</strong> is arguably the most essential tool in the realms of fitness, clinical nutrition, and weight management. TDEE represents the precise number of calories your body burns in a given 24-hour period. If you consume exactly this caloric amount, your body mass will remain entirely constant.
      </p>
      <p class="text-xl leading-relaxed text-gray-700 font-medium mt-4">
        Grasping the science behind this metric is not merely about tracking numbers; it is the ultimate gateway to taking absolute control over your body composition. Whether your objective is fat loss, muscle hypertrophy, or maintaining a healthy physique, your TDEE forms the foundational baseline of your dietary strategy.
      </p>
    </div>

    <ArticleImage src="/assets/images/articles/energy-balance.svg" alt="Healthy eating and nutrition tracking." />

    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mt-12 mb-6">The 4 Pillars of Your TDEE (E-E-A-T Scientific Breakdown)</h2>
    <p class="text-lg text-gray-600 mb-6">Your total daily caloric burn is not solely dependent on the intensity or frequency of your workouts. In clinical practice, intentional exercise represents a surprisingly small fraction of daily energy use. Your TDEE is a comprehensive mathematical equation consisting of four distinct physiological pillars:</p>

    <div class="space-y-6">
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 shadow-sm border border-blue-100">
        <h3 class="text-xl font-bold text-indigo-900 mb-2">1. Basal Metabolic Rate (BMR) [~70%]</h3>
        <p class="text-gray-700">This represents the substantial amount of energy required by your vital organs simply to keep you alive and functioning optimally in a state of absolute rest. It encompasses brain function, cellular respiration, cardiac output, and body temperature regulation. You can calculate this core metric in isolation using our <a href="/resources/what-is-bmr/" class="text-indigo-600 font-semibold hover:underline">BMR</a>.</p>
      </div>

      <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-2xl p-6 shadow-sm border border-emerald-100">
        <h3 class="text-xl font-bold text-teal-900 mb-2">2. Non-Exercise Activity Thermogenesis (NEAT) [~15%]</h3>
        <p class="text-gray-700">NEAT accounts for the calories expended through spontaneous, non-prescribed physical movements. This includes fidgeting, maintaining posture, pacing, performing household chores, and walking to your car. Individuals engaged in manual labor or highly active occupations exhibit exponentially higher NEAT compared to sedentary desk workers.</p>
      </div>

      <div class="bg-gradient-to-r from-orange-50 to-amber-50 rounded-2xl p-6 shadow-sm border border-orange-100">
        <h3 class="text-xl font-bold text-orange-900 mb-2">3. Thermic Effect of Food (TEF) [~10%]</h3>
        <p class="text-gray-700">The biochemical process of digestion itself requires energy! Protein is the most metabolically demanding macronutrient to digest, meaning high-protein diets permanently and naturally elevate your TEF. Utilize our <a href="/" class="text-orange-600 font-semibold hover:underline">macro calculator</a> to optimize this hidden metabolic advantage.</p>
      </div>

      <div class="bg-gradient-to-r from-rose-50 to-pink-50 rounded-2xl p-6 shadow-sm border border-rose-100">
        <h3 class="text-xl font-bold text-rose-900 mb-2">4. Exercise Activity Thermogenesis (EAT) [~5%]</h3>
        <p class="text-gray-700">This represents the energy utilized during deliberate, structured physical training sessions—such as running on a treadmill, resistance training, or high-intensity interval training (HIIT). While highly beneficial for cardiovascular health and muscle retention, its absolute contribution to total energy expenditure is often overestimated.</p>
      </div>
    </div>

    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mt-16 mb-6">How Our Clinical TDEE Calculator Functions</h2>
    <p class="text-lg text-gray-600 mb-6">Our calculator implements the clinical gold standard: the <strong>Mifflin-St Jeor equation</strong>, extensively validated in peer-reviewed literature as the most precise formula for modern populations. It initially computes your BMR based on biological sex, age, height, and weight. Subsequently, it applies an "Activity Multiplier" (ranging from 1.2 to 1.9) to encapsulate the metabolic demands of your specific lifestyle.</p>

    <div class="overflow-x-auto my-10 bg-white shadow-xl rounded-2xl border border-gray-100">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gradient-to-r from-gray-50 to-gray-100 text-gray-800">
            <th class="p-4 font-bold uppercase text-sm tracking-wider">Activity Level</th>
            <th class="p-4 font-bold uppercase text-sm tracking-wider">Multiplier</th>
            <th class="p-4 font-bold uppercase text-sm tracking-wider">Detailed Clinical Description</th>
          </tr>
        </thead>
        <tbody class="text-gray-700 divide-y divide-gray-100">
          <tr class="hover:bg-gray-50 transition-colors"><td class="p-4 font-semibold text-indigo-700">Sedentary</td><td class="p-4"><span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md text-xs font-bold">x 1.2</span></td><td class="p-4">Typical desk-bound job, commuting via car, little to no intentional exercise or structured training.</td></tr>
          <tr class="hover:bg-gray-50 transition-colors bg-indigo-50/30"><td class="p-4 font-semibold text-indigo-700">Lightly Active</td><td class="p-4"><span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md text-xs font-bold">x 1.375</span></td><td class="p-4">Light exercise or recreational sports 1-3 days per week, occasional brisk walks.</td></tr>
          <tr class="hover:bg-gray-50 transition-colors"><td class="p-4 font-semibold text-indigo-700">Moderately Active</td><td class="p-4"><span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md text-xs font-bold">x 1.55</span></td><td class="p-4">Moderate-intensity exercise or sports 3-5 days per week, representing the average fitness enthusiast.</td></tr>
          <tr class="hover:bg-gray-50 transition-colors bg-indigo-50/30"><td class="p-4 font-semibold text-indigo-700">Very Active</td><td class="p-4"><span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md text-xs font-bold">x 1.725</span></td><td class="p-4">Hard exercise, intense resistance training, or competitive sports 6-7 days per week.</td></tr>
          <tr class="hover:bg-gray-50 transition-colors"><td class="p-4 font-semibold text-indigo-700">Extra Active</td><td class="p-4"><span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md text-xs font-bold">x 1.9</span></td><td class="p-4">Daily extreme physical training (e.g., elite athletes, triathletes) or demanding manual labor jobs (construction, farming).</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mt-16 mb-6">The Thermodynamics of Body Transformation</h2>
    <p class="text-lg text-gray-600 mb-8">Once you accurately establish your TDEE, the mathematics dictating physiological transformation become remarkably straightforward and highly predictable. The fundamental laws of thermodynamics govern body weight:</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-lg border border-red-100 p-6 flex flex-col h-full transform hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Deficit (Fat Loss)</h3>
        <p class="text-gray-600 flex-grow">You must deliberately consume fewer calories than your TDEE. Clinical guidelines recommend an aggressive yet sustainable deficit of <strong>300 to 500 calories daily</strong>, yielding approximately 1 pound of pure fat loss per week while preserving lean mass.</p>
      </div>

      <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-lg border border-green-100 p-6 flex flex-col h-full transform hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Surplus (Muscle Hypertrophy)</h3>
        <p class="text-gray-600 flex-grow">To synthesize new skeletal muscle tissue, a hypercaloric environment is required. A modest surplus of <strong>200 to 300 calories daily</strong>, combined with progressive resistance training, maximizes myofibrillar hypertrophy while minimizing fat accumulation.</p>
      </div>

      <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-lg border border-blue-100 p-6 flex flex-col h-full transform hover:-translate-y-1 transition-transform">
        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Maintenance Phase</h3>
        <p class="text-gray-600 flex-grow">For body recomposition, post-diet stabilization, or general cardiovascular health improvement without weight fluctuation, align your daily intake <strong>exactly with your TDEE</strong>.</p>
      </div>
    </div>

    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mt-16 mb-6">Special Considerations: Why Your TDEE Might Seem Inaccurate</h2>
    <div class="bg-yellow-50 rounded-3xl p-8 border border-yellow-200">
      <p class="text-lg text-gray-700 mb-4">While modern TDEE calculators offer exceptional clinical estimates, they are not universally flawless barometers. Biological variance exists. If you strictly consume your estimated TDEE yet observe unintended weight gain, the primary culprit in over 90% of instances is an <strong>overestimation of physical activity levels</strong>.</p>
      <p class="text-lg text-gray-700 font-semibold mb-4">
        A pervasive psychological bias exists: most individuals intuitively categorize themselves as "Moderately Active," whereas objective tracking of their daily routines firmly places them in the "Lightly Active" bracket. During periods of weight stalling or uncertainty, practitioners strongly advise selecting a more conservative activity multiplier and monitoring bi-weekly trends.
      </p>
      <p class="text-lg text-gray-700">Furthermore, individuals subjected to prolonged, severe caloric restriction may manifest "metabolic adaptation" (adaptive thermogenesis). In this physiological state, the body's actual TDEE is temporarily suppressed below calculator estimates as a survival mechanism conserving energy. The clinical remedy involves implementing a "reverse diet"—a systematic, incremental increase in caloric intake designed to rehabilitate baseline metabolic function prior to initiating a subsequent fat loss phase.</p>
    </div>

    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mt-16 mb-6">Frequently Asked Questions (FAQ)</h2>
    <div class="space-y-6 mb-12">
      {faqs.map(faq => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-xl font-bold text-gray-900 mb-3">{faq.q}</h3>
          <p class="text-gray-600">{faq.a}</p>
        </div>
      ))}
    </div>

    <div class='my-16 bg-gradient-to-br from-indigo-50 to-purple-50 p-8 rounded-3xl shadow-inner border border-indigo-100/50'>
      <h2 class="text-2xl font-bold text-center text-indigo-900 mb-8">Calculate Your TDEE Instantly</h2>
      <CalorieCalculator />
    </div>

    <!-- Suggested Content -->
    <div class="mt-20 pt-12 border-t border-gray-200">
      <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8 text-center">Suggested Resources and Next Steps</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <a href="/resources/what-is-bmr/" class="group bg-white rounded-3xl p-8 shadow-md hover:shadow-xl transition-all border border-gray-100 hover:border-indigo-300 flex flex-col justify-center items-center text-center">
          <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-indigo-600 transition-colors">What is BMR?</h3>
          <p class="text-gray-600">Discover how your Basal Metabolic Rate dictates the vast majority of your daily energy expenditure and explore methods to optimize it safely.</p>
        </a>
        <a href="/" class="group bg-white rounded-3xl p-8 shadow-md hover:shadow-xl transition-all border border-gray-100 hover:border-teal-300 flex flex-col justify-center items-center text-center">
          <div class="w-16 h-16 bg-teal-100 text-teal-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">Maintenance Calories</h3>
          <p class="text-gray-600">Learn why locating your precise caloric equilibrium is essential for stabilizing your physique post-diet and ensuring long-term health.</p>
        </a>
      </div>
      <div class="text-center">
        <a href="/" class="inline-flex items-center justify-center px-10 py-5 text-xl font-extrabold text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-full hover:from-indigo-700 hover:to-purple-700 shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all">
          Go to the Main Calculator
          <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>
  </div>
</ContentLayout>
