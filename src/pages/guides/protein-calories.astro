const faqs: FaqItem[] = [
  { q: "How many calories are in 1 gram of protein?", a: "There are exactly 4 calories (kcal) in 1 gram of protein. This is a scientific standard established by the Atwater system and applies to all protein sources, whether animal or plant-based." },
  { q: "How do I calculate calories from protein?", a: "To calculate calories from protein, simply multiply the number of protein grams by 4. For example, if a chicken breast has 30 grams of protein, the calories from protein would be 30 × 4 = 120 calories." },
  { q: "Does protein have more calories than carbohydrates?", a: "No. Both protein and carbohydrates provide exactly 4 calories per gram. However, fat is much more calorie-dense, providing 9 calories per gram." },
  { q: "What is the Thermic Effect of Food (TEF) for protein?", a: "Protein has the highest Thermic Effect of Food (TEF) of all macronutrients. Your body burns approximately 20-30% of the calories in protein just to digest and metabolize it, compared to only 5-10% for carbs and 0-3% for fats." },
  { q: "How many calories are in a scoop of protein powder?", a: "A standard scoop of whey protein powder (about 30g total weight) usually contains 20-25 grams of protein. This equates to 80-100 calories strictly from protein, though the total scoop may have 110-130 calories when accounting for trace fats and carbs." },
  { q: "Why do some food labels show slightly different protein calories?", a: "Food labels sometimes use specific Atwater factors based on the exact amino acid profile and digestibility of the specific food, which can slightly deviate from the flat '4 calories per gram' rule. However, for all practical diet tracking, using 4 kcal/g is standard and accurate." },
  { q: "How do I convert calories back into protein grams?", a: "To convert protein calories back into grams, divide the calorie amount by 4. If you want 400 calories of your diet to come from protein, you would need 400 ÷ 4 = 100 grams of protein." }
];
