        <tr class="hover:bg-canvas-soft transition-colors"><td class="py-3 px-4">100g</td><td class="py-3 px-4 font-bold text-brand">400 kcal</td><td class="py-3 px-4 text-body">20%</td></tr>
        <tr class="hover:bg-canvas-soft transition-colors"><td class="py-3 px-4">125g</td><td class="py-3 px-4 font-bold text-brand">500 kcal</td><td class="py-3 px-4 text-body">25%</td></tr>
