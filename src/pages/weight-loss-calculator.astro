---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";
import Sources from "../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q: "How long will it take to lose weight?", a: "It depends on your calorie deficit. A 500-calorie daily deficit produces about 0.45 kg (1 lb) of loss per week. This calculator estimates your timeline based on the weekly rate you choose and the total weight you want to lose." },
  { q: "What is a safe rate of weight loss?", a: "Most experts recommend 0.5–1 kg (1–2 lb) per week, or about 0.5–1% of body weight. Faster loss raises the risk of muscle loss and is harder to sustain." },
  { q: "Why do I need a calorie deficit?", a: "You lose fat when you consistently burn more calories than you eat. The shortfall forces your body to use stored fat for energy. A pound of fat stores roughly 3,500 calories." },
  { q: "Will my weight loss slow down?", a: "Yes. As you lose weight your calorie needs fall, so the same intake produces a smaller deficit. Recalculate your targets every few weeks and stay patient through plateaus." },
  { q: "What is the best calorie deficit for fat loss?", a: "A 250-500 calorie daily deficit works best for sustainable fat loss without muscle loss. Larger deficits often lead to hunger and metabolic slowdown." },
  { q: "How do I know if I'm in a calorie deficit?", a: "Track your food intake and compare it to your TDEE. If you're losing 0.5-1 lb per week, you're in the right range. Use our calorie tracker or app." },
  { q: "Should I eat back calories burned exercising?", a: "For weight loss, eat back about half of exercise calories to maintain energy and prevent overeating. Our calculator already accounts for activity level." },
  { q: "Can I speed up my weight loss timeline?", a: "You can increase deficit through diet or exercise, but combined deficits over 1000 calories are hard to maintain. Better to increase activity slightly and stick to the plan." },
  { q: "Why am I not losing weight at the expected rate?", a: "Common causes: underestimating food intake, overestimating activity, water retention, metabolic adaptation. Track everything precisely for 1-2 weeks." },
  { q: "How many calories should I eat to lose weight?", a: "Subtract your desired deficit (usually 500) from your TDEE. If your TDEE is 2200, aim for 1700 calories daily for 1 lb/week loss." },
  { q: "What is a caloric weight loss calculator?", a: "A caloric weight loss calculator like this one converts your weight loss goal into a daily calorie deficit and timeline. It uses the 3,500-calorie rule to estimate how long your goal will take." },
  { q: "What is a weight loss calculator predictor?", a: "A weight loss calculator predictor estimates your future weight based on your current plan. This tool projects your target date from your chosen weekly rate and starting weight." },
  { q: "How does intermittent fasting affect weight loss?", a: "Intermittent fasting can help control calories by limiting eating windows. Pair it with a moderate deficit for best results. Use the <a href='/intermittent-fasting-calculator/'>intermittent fasting calculator</a> to plan your schedule." },
  { q: "Does cardio help weight loss?", a: "Cardio burns extra calories and supports heart health. Combine it with dietary changes for the fastest results. Use the <a href='/calories-burned-calculator/'>calories burned calculator</a> to estimate your exercise contribution." },
];
---

<CalculatorLayout
  title="Weight Loss Calculator | How Long to Reach Your Goal Weight?"
  h1="Weight Loss Calculator"
  description="Calculate exactly how long it will take to reach your goal weight. Our free weight loss calculator sets realistic timelines based on your calorie deficit and body type."
  intro="Stop wondering when you will reach your goal weight. Our free weight loss calculator gives you a highly accurate, customized timeline based on your metabolic rate and daily calorie deficit."
  path="/weight-loss-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" role="tab" aria-selected="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" role="tab" aria-selected="false">Imperial</button>
      </div>
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1.5"><label for="current" class="block text-sm font-medium text-ink">Current <span class="u-wt text-mute">(kg)</span></label><input id="current" type="number" inputmode="decimal" step="0.1" value="80" class={inputCls} /></div>
          <div class="space-y-1.5"><label for="goal" class="block text-sm font-medium text-ink">Goal <span class="u-wt text-mute">(kg)</span></label><input id="goal" type="number" inputmode="decimal" step="0.1" value="70" class={inputCls} /></div>
        </div>
        <div class="space-y-1.5">
          <label for="rate" class="block text-sm font-medium text-ink">Weekly rate</label>
          <div class="relative">
            <select id="rate" class={selectCls}>
              <option value="0.25">Gentle — 0.25 kg / 0.5 lb per week</option>
              <option value="0.5" selected>Standard — 0.5 kg / 1 lb per week</option>
              <option value="1">Aggressive — 1 kg / 2 lb per week</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn mt-5 inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Plan</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Estimated time to goal</p>
        <p id="wl-time" class="mt-1 text-display-xl text-ink">20 weeks</p>
        <p class="mt-2 text-sm text-body">Target date: <span id="wl-date" class="text-ink">—</span></p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">To lose</p><p id="wl-total" class="mt-1 text-display-sm text-ink tabular-nums">10 kg</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Daily deficit</p><p id="wl-deficit" class="mt-1 text-display-sm text-ink tabular-nums">550 kcal</p></div>
      </div>
      <p id="wl-note" class="hidden rounded-lg border border-warning/40 bg-warning/10 px-4 py-3 text-sm text-body"></p>
    </div>
  </div>

  <Fragment slot="content">
    <MedicalNote />

    <h2>How the weight-loss timeline works</h2>
    <p>Fat loss comes down to energy balance. Because a pound of body fat stores roughly 3,500 calories (and a kilogram about 7,700), the size of your daily calorie deficit determines how quickly you lose weight. This calculator converts your chosen weekly rate into the daily deficit you'll need and projects a realistic target date.</p>

    <h2>The 3,500-calorie rule in practice</h2>
    <p>The 3,500-calorie rule is a useful starting point, but real-world results vary. Water retention, muscle gain, hormonal shifts, and metabolic adaptation all mean your actual weekly loss may differ from the mathematical projection. Use the result as a guide, not a guarantee, and adjust your intake based on 2–3 week trends rather than daily scale weight.</p>

    <h2>Choosing a sustainable pace</h2>
    <p>Faster isn't always better. Losing 0.5–1% of your body weight per week protects muscle and is far easier to maintain than crash dieting. If your required deficit feels too large, choose a gentler rate — slow, consistent progress wins. Learn more in the <a href="/guides/weight-loss-guide/">weight loss guide</a>.</p>

    <ArticleImage src="/assets/images/articles/weight-timeline.svg" alt="Illustration of a weight-loss progress line from a start point to a goal weight." />

    <h2>Setting up your calorie deficit</h2>
    <p>Your starting point is your maintenance calories. Find those with the <a href="/tdee-calculator/">TDEE calculator</a>, then subtract your daily deficit to get your target intake. A deficit of about 500 calories per day produces roughly one pound of fat loss per week. Pair that with a high-protein <a href="/macro-calculator/">macro split</a> to preserve muscle while the fat comes off.</p>

    <h2>Combining diet with exercise</h2>
    <p>You can create your deficit through diet, exercise, or both. Moving more — walking, strength training, or cardio — gives you more calories to eat while still losing fat. Use the <a href="/calories-burned-calculator/">calories burned calculator</a> to see how much your workouts contribute. For running, try the <a href="/running-calorie-calculator/">running calorie calculator</a>; for walking, the <a href="/walking-calorie-calculator/">walking calorie calculator</a>; and for gym sessions, the <a href="/treadmill-calorie-calculator/">treadmill calorie calculator</a>. Even adding steps with a <a href="/walking-calorie-calculator/">walking calorie calculator</a> can add 100–300 calories of burn per day.</p>

    <h2>How to break through plateaus</h2>
    <p>If the scale stalls for more than 2–3 weeks, recalculate your TDEE at your new weight — it will be lower. Tighten your food tracking, add 10–15 minutes of activity, or reduce your deficit slightly to reset your metabolism. Small, consistent adjustments beat drastic cuts.</p>

    <h2>Common mistakes that slow weight loss</h2>
    <ul>
      <li><strong>Underestimating portions:</strong> Weighing and logging food removes guesswork.</li>
      <li><strong>Forgetting liquid calories:</strong> Coffee drinks, smoothies, and cooking oils add up fast.</li>
      <li><strong>Skipping strength training:</strong> Muscle is metabolically active; losing it slows your metabolism.</li>
      <li><strong>Not recalculating:</strong> Your maintenance drops as you lose weight. Recalculate every 4–5 kg.</li>
      <li><strong>Ignoring sleep:</strong> Poor sleep increases hunger hormones and weakens willpower.</li>
    </ul>

    <h2>Putting your plan into action</h2>
    <p>Use the <a href="/calorie-deficit-calculator/">calorie deficit calculator</a> to find your exact daily deficit target, then the <a href="/meal-calorie-calculator/">meal calorie calculator</a> to split that target across breakfast, lunch, dinner, and snacks. For extra accountability, try the <a href="/intermittent-fasting-calculator/">intermittent fasting calculator</a> to fit meals into a shorter eating window.</p>

    <Sources sources={[
      { label: "CDC — Healthy weight loss", href: "https://www.cdc.gov/healthy-weight-growth/losing-weight/index.html" },
      { label: "NHS — Calories and weight management", href: "https://www.nhs.uk/live-well/healthy-weight/managing-your-weight/understanding-calories/" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { weeksToGoal } from "../lib/calculations";
  import { lbToKg } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    let unit: "metric" | "imperial" = "metric";

    function render() {
      clearDirty();
      let cur = parseFloat(($("current") as HTMLInputElement).value) || 0;
      let goal = parseFloat(($("goal") as HTMLInputElement).value) || 0;
      let rateKg = parseFloat(($("rate") as HTMLSelectElement).value); // kg/week (metric reading)
      if (unit === "imperial") { cur = lbToKg(cur); goal = lbToKg(goal); }
      if (cur <= 0 || goal <= 0) return;

      const note = $("wl-note");
      if (goal >= cur) {
        $("wl-time").textContent = "—";
        $("wl-total").textContent = "0";
        note.classList.remove("hidden");
        note.textContent = "Your goal weight is at or above your current weight. Try the weight-gain options on the main calorie calculator, or set a lower goal.";
        return;
      }
      note.classList.add("hidden");

      const dailyDeficit = (rateKg * 7700) / 7; // kcal/day for that weekly kg rate
      const weeks = weeksToGoal(cur, goal, -dailyDeficit);
      const conv = unit === "imperial" ? 2.2046226218 : 1;
      const u = unit === "imperial" ? "lb" : "kg";
      $("wl-total").textContent = `${((cur - goal) * conv).toFixed(1)} ${u}`;
      $("wl-deficit").textContent = `${Math.round(dailyDeficit)} kcal`;
      if (weeks === null) return;
      const wRounded = Math.ceil(weeks);
      $("wl-time").textContent = wRounded === 1 ? "1 week" : `${wRounded} weeks`;
      const d = new Date();
      d.setDate(d.getDate() + wRounded * 7);
      $("wl-date").textContent = d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return; unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        document.querySelectorAll(".u-wt").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        ["current", "goal"].forEach((id) => { const i = $(id) as HTMLInputElement; const cv = parseFloat(i.value) || 0; if (cv) i.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1); });
      });
    });
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
