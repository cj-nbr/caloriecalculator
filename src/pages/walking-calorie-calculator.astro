---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import ExerciseCalculator from "../components/calculators/ExerciseCalculator.astro";
import { WALKING } from "../data/exercises";
import type { FaqItem } from "../lib/seo";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "How many calories does walking burn?", a: "A 70 kg (154 lb) person burns roughly 150 calories walking briskly (3.5 mph) for 30 minutes. Slower strolls burn less, and a faster pace or hills burn more." },
  { q: "How many calories does walking 10,000 steps burn?", a: "Roughly 300–500 calories for most people, depending on body weight, pace, and stride length. 10,000 steps is about 5 miles or 8 km." },
  { q: "Is walking good for weight loss?", a: "Yes. Walking is low-impact, sustainable, and easy to fit into daily life. Combined with a modest calorie deficit, regular walking is a very effective tool for losing fat and keeping it off." },
  { q: "How many calories does walking a mile burn?", a: "About 70–100 calories per mile for an average adult, increasing with body weight and walking speed." },
];
---

<CalculatorLayout
  title="Walking Calorie Calculator — Calories Burned Walking (Free)"
  h1="Walking Calorie Calculator"
  description="Free walking calorie calculator. See how many calories you burn walking at any speed based on your weight and time."
  intro="See how many calories you burn walking. Pick your pace, enter your weight and duration, and get an instant estimate."
  path="/walking-calorie-calculator/"
  faqs={faqs}
>
  <ExerciseCalculator activities={WALKING} defaultIndex={3} />

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/walking-route.svg" alt="Illustration of a walking route showing step count and pace for calorie burn." />

    <h2>Calories burned walking</h2>
    <p>Walking is the most accessible exercise there is — and it burns meaningful calories, especially when done briskly or uphill. The number you burn depends on your walking speed, your body weight, and how long you walk. This calculator estimates it using MET values for each pace.</p>

    <h2>How to burn more calories walking</h2>
    <ul>
      <li>Walk faster — a brisk 3.5–4 mph pace nearly doubles the burn of a slow stroll.</li>
      <li>Add hills or incline to raise the intensity.</li>
      <li>Walk longer or more often — consistency adds up over a week.</li>
      <li>Carry a light pack or use a weighted vest for extra resistance.</li>
    </ul>

    <h2>Walking and weight loss</h2>
    <p>Walking helps build the <a href="/guides/calorie-deficit-guide/">calorie deficit</a> that drives weight loss while being gentle on your joints. Combine it with a daily calorie target from the <a href="/">calorie calculator</a>. Ready for more intensity? Try the <a href="/running-calorie-calculator/">running</a> or <a href="/treadmill-calorie-calculator/">treadmill</a> calculators.</p>
  </Fragment>
</CalculatorLayout>
