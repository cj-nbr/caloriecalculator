---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls } from "../lib/ui";
import { bmrMifflinStJeor, tdee, macrosFromCalories, ACTIVITY_LEVELS, type Sex, type ActivityKey } from "../lib/calculations";
import type { FaqItem } from "../lib/seo";
import Sources from "../components/ui/Sources.astro";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "What are maintenance calories?", a: "Maintenance calories are the number of calories you need to eat each day to keep your current weight stable. It is the same as your Total Daily Energy Expenditure (TDEE)." },
  { q: "How do I calculate maintenance calories?", a: "Start with your Basal Metabolic Rate (BMR) using the Mifflin-St Jeor equation, then multiply by an activity multiplier. This calculator does both steps automatically." },
  { q: "What is TDEE?", a: "TDEE (Total Daily Energy Expenditure) is your maintenance calorie target — the calories you burn at rest plus all daily movement and exercise. Use the <a href='/tdee-calculator/'>TDEE calculator</a> for the full breakdown." },
  { q: "Can maintenance calories change over time?", a: "Yes. As your weight, activity, or muscle mass changes, your maintenance calories shift. Recalculate every 4–6 weeks when your body changes noticeably." },
  { q: "What happens if I eat above maintenance?", a: "Eating above maintenance creates a calorie surplus and leads to gradual weight gain. A small surplus (about 250 calories) supports lean muscle growth with minimal fat gain." },
  { q: "What happens if I eat below maintenance?", a: "Eating below maintenance creates a calorie deficit and leads to weight loss. The <a href='/calorie-deficit-calculator/'>calorie deficit calculator</a> helps you choose a safe pace." },
  { q: "How accurate is the maintenance calorie calculator?", a: "It is accurate within ±5–10% for most people. Real-world results vary by genetics, hormones, and activity accuracy, so adjust based on measured progress." },
  { q: "Do I need to recalculate maintenance calories?", a: "Yes. Recalculate after every 4–5 kg (about 10 lb) of weight change, or whenever your activity level changes significantly. Use the <a href='/'>calorie calculator</a> for updated targets." },
];
---

<CalculatorLayout
  title="Maintenance Calorie Calculator | Find Your Daily Maintenance"
  h1="Maintenance Calories Calculator"
  description="Find out exactly how many calories you need to maintain your current weight. Our free maintenance calorie calculator factors in your lifestyle and activity level."
  intro="Want to keep your current physique exactly as it is? Use our free maintenance calorie calculator to find the exact number of calories your body needs every day to stay at your current weight."
  path="/maintenance-calories-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <MedicalNote />
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">Example values are pre-filled. Enter your own details for accurate results.</p>
      <div class="mb-4 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" aria-pressed="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" aria-pressed="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <label for="age" class="block text-sm font-medium text-ink">Age</label>
          <input id="age" type="number" min="15" max="100" value="30" class={inputCls} />
        </div>
        <div class="space-y-1.5">
          <label for="weight" class="block text-sm font-medium text-ink">Weight <span class="weight-unit text-mute">(kg)</span></label>
          <input id="weight" type="number" inputmode="decimal" min="20" step="0.1" value="70" class={inputCls} />
        </div>
      </div>
      <div class="mb-5">
        <label class="mb-1.5 block text-sm font-medium text-ink">Height <span class="height-unit text-mute">(cm)</span></label>
        <div id="height-metric"><input id="height-cm" type="number" min="100" max="250" value="175" class={inputCls} /></div>
        <div id="height-imperial" class="hidden grid-cols-2 gap-3">
          <div class="relative"><input id="height-ft" type="number" min="3" max="8" value="5" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">ft</span></div>
          <div class="relative"><input id="height-in" type="number" min="0" max="11" value="9" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">in</span></div>
        </div>
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="activity" class="block text-sm font-medium text-ink">Activity level</label>
        <select id="activity" class={inputCls}>
          {(Object.keys(ACTIVITY_LEVELS) as ActivityKey[]).map((k) => (
            <option value={k} selected={k === "moderate"}>{ACTIVITY_LEVELS[k].label} — {ACTIVITY_LEVELS[k].hint}</option>
          ))}
        </select>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Maintenance Calories</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Maintenance calories</p>
        <p class="mt-1"><span id="maint-value" class="text-display-xl text-ink tabular-nums">2,556</span> <span class="text-lg text-mute">kcal/day</span></p>
        <p class="mt-2 text-sm text-body">This is your TDEE — the calories you need to stay at your current weight.</p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Recommended macros</h2></div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th class="px-5 py-3 font-medium">Nutrient</th>
              <th class="px-5 py-3 text-right font-medium">Grams</th>
              <th class="px-5 py-3 text-right font-medium">Calories</th>
            </tr>
          </thead>
          <tbody id="macro-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/balance-scale.svg" alt="Illustration of a balanced scale representing calories in versus calories out for weight maintenance." />

    <h2>How to use the Maintenance Calories Calculator</h2>
    <p>Enter your age, height, weight, sex, and activity level, then press <strong>Calculate Maintenance Calories</strong>. The result shows your TDEE — the calories you need to stay at your current weight. Use this number as your baseline for any weight goal.</p>

    <h2>What maintenance calories mean</h2>
    <p>Maintenance calories are the number of calories you burn in a typical day, combining your resting metabolism and all daily movement. It is the starting point for any weight goal: eat above it to gain, below it to lose, or right at it to stay where you are.</p>

    <h2>Maintenance calories vs BMR</h2>
    <p>BMR is what you burn at complete rest. Maintenance calories (TDEE) add movement, exercise, and digestion to give a real-world daily number. Use the <a href="/bmr-calculator/">BMR calculator</a> to see your baseline, then check your activity level above to estimate your real needs.</p>

    <h2>Using maintenance calories for weight goals</h2>
    <ul>
      <li><strong>Maintain:</strong> eat equal to your TDEE.</li>
      <li><strong>Lose:</strong> eat 300–500 calories below TDEE. Use the <a href="/calorie-deficit-calculator/">calorie deficit calculator</a> for a tailored target.</li>
      <li><strong>Gain:</strong> eat 250–500 calories above TDEE. See the <a href="/weight-gain-calculator/">weight gain calculator</a> for timeline and macros.</li>
    </ul>

    <h2>Related guides</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/maintenance-calories/">Maintenance Calories: How to Stay at Your Ideal Weight</a></h3>
        <p class="mt-1 text-sm text-body">Learn what maintenance calories are, why they shift over time, and how to keep your weight stable without constant tracking.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/how-many-calories-should-i-eat/">How Many Calories Should I Eat?</a></h3>
        <p class="mt-1 text-sm text-body">A complete guide to setting your daily calorie target based on goals, activity, and lifestyle.</p>
      </div>
    </div>

    <Sources sources={[
      { label: "Mifflin MD, St Jeor ST, Hill LA, Scott BJ, Daugherty SA, Koh YO. A new predictive equation for resting energy expenditure in healthy individuals. Am J Clin Nutr. 1990.", href: "https://pubmed.ncbi.nlm.nih.gov/2305711/" },
      { label: "Institute of Medicine — Dietary Reference Intakes for Energy (2005)", href: "https://www.nationalacademies.org/publication/dietary-reference-intakes-for-energy" },
      { label: "American Council on Exercise — Physical Activity Calorie Counter", href: "https://www.acefitness.org/resources/everyone/exercise/1087/physical-activity-calorie-counter/" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { bmrMifflinStJeor, tdee, macrosFromCalories, ACTIVITY_LEVELS } from "../lib/calculations";
  import { lbToKg, ftInToCm } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (!root) throw new Error("calc-root not found");
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = $("result-box");
      if (box) box.classList.add("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    let unit: "metric" | "imperial" = "metric";

    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as "male" | "female";
      const age = parseFloat(($("age") as HTMLInputElement).value) || 0;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      let h: number;
      if (unit === "imperial") {
        w = lbToKg(w);
        h = ftInToCm(parseFloat(($("height-ft") as HTMLInputElement).value) || 0, parseFloat(($("height-in") as HTMLInputElement).value) || 0);
      } else h = parseFloat(($("height-cm") as HTMLInputElement).value) || 0;
      const activity = ($("activity") as HTMLSelectElement).value as "sedentary" | "light" | "moderate" | "active" | "athlete";
      return { sex, age, w, h, activity };
    }

    function render() {
      clearDirty();
      const { sex, age, w, h, activity } = read();
      if (w <= 0 || h <= 0 || age <= 0) return;
      const bmr = bmrMifflinStJeor(sex, age, h, w);
      const maint = tdee(bmr, activity);
      $("maint-value").textContent = fmt(maint);

      const macros = macrosFromCalories(maint);
      $("macro-table").innerHTML = [
        { name: "Protein", g: macros.proteinG, kcal: macros.proteinKcal },
        { name: "Carbs", g: macros.carbsG, kcal: macros.carbsKcal },
        { name: "Fat", g: macros.fatG, kcal: macros.fatKcal },
      ].map((m) => `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${m.name}</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(m.g)} g</td><td class="px-5 py-2.5 text-right text-mute tabular-nums">${fmt(m.kcal)}</td></tr>`).join("");
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => {
          const on = b.dataset.unit === unit;
          b.setAttribute("aria-pressed", String(on));
          b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on);
        });
        $("height-metric").classList.toggle("hidden", unit === "imperial");
        $("height-imperial").classList.toggle("hidden", unit === "metric");
        $("height-imperial").classList.toggle("grid", unit === "imperial");
        document.querySelectorAll(".weight-unit").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        markDirty();
      });
    });

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });</script>
