---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls } from "../lib/ui";
import { bmrMifflinStJeor, tdee, goalCalories, macrosFromCalories, ACTIVITY_LEVELS, type Sex, type ActivityKey, type GoalKey } from "../lib/calculations";
import type { FaqItem } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";
import Sources from "../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q: "How many calories should I eat to gain weight?", a: "Aim for a 250–500 calorie surplus above your maintenance calories. This calculator estimates your daily target based on your chosen weekly gain rate." },
  { q: "How much weight can I gain per week?", a: "A healthy pace is about 0.25–0.5 kg (0.5–1 lb) per week for most people. Faster gain usually adds excess fat unless you are new to resistance training." },
  { q: "What is the best macro split for bulking?", a: "A common starting point is 20–30% protein, 40–60% carbs, and 20–30% fat. High carbs support training performance, while protein preserves muscle." },
  { q: "How do I calculate my weight gain timeline?", a: "Use your desired weekly gain rate to estimate the daily surplus, then this calculator shows how long it will take to reach your goal weight." },
  { q: "Is it possible to gain muscle without gaining fat?", a: "It is possible, especially for beginners, but some fat gain usually accompanies muscle growth. Keep the surplus small, train with resistance, and eat enough protein." },
  { q: "What foods are best for healthy weight gain?", a: "Focus on calorie-dense whole foods: nuts, seeds, avocados, olive oil, oats, dairy, red meat, and complex carbs. Use the <a href='/macro-calculator/'>macro calculator</a> to balance protein and carbs." },
  { q: "How long does it take to gain 10 pounds?", a: "At a 500-calorie daily surplus, gaining 4.5 kg (10 lb) takes roughly 10–12 weeks for most people. Genetics, training, and starting body composition all affect the timeline." },
  { q: "Should I use a weight gain calculator?", a: "Yes. A weight gain calculator removes guesswork by matching your surplus, activity, and goal weight. Use it to set a daily calorie target and track progress week to week." },
];
---

<CalculatorLayout
  title="Weight Gain Calculator | Calories Needed to Build Muscle & Bulk"
  h1="Weight Gain Calculator"
  description="Calculate the exact calorie surplus needed to build muscle and gain weight safely. Our free weight gain calculator optimizes your macros for lean bulking."
  intro="Building muscle requires energy. Our free weight gain calculator determines the exact daily calorie surplus and macro breakdown you need to bulk up and gain healthy weight without adding excess fat."
  path="/weight-gain-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">Example values are pre-filled. Enter your own details for accurate results.</p>
      <div class="mb-4 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" role="tab" aria-selected="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" role="tab" aria-selected="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <label for="age" class="block text-sm font-medium text-ink">Age</label>
          <input id="age" type="number" min="15" max="100" value="30" class={inputCls} />
        </div>
        <div class="space-y-1.5">
          <label for="weight" class="block text-sm font-medium text-ink">Weight <span class="weight-unit text-mute">(kg)</span></label>
          <input id="weight" type="number" inputmode="decimal" min="20" step="0.1" value="70" class={inputCls} />
        </div>
      </div>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <label for="height" class="block text-sm font-medium text-ink">Height <span class="height-unit text-mute">(cm)</span></label>
          <input id="height" type="number" inputmode="decimal" min="100" max="250" value="175" class={inputCls} />
        </div>
        <div class="space-y-1.5">
          <label for="activity" class="block text-sm font-medium text-ink">Activity</label>
          <select id="activity" class={inputCls}>
            {(Object.keys(ACTIVITY_LEVELS) as ActivityKey[]).map((k) => (
              <option value={k} selected={k === "moderate"}>{ACTIVITY_LEVELS[k].label}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="mb-4 space-y-1.5">
        <label for="rate" class="block text-sm font-medium text-ink">Weekly gain target</label>
        <select id="rate" class={inputCls}>
          <option value="250">0.25 kg / 0.5 lb per week</option>
          <option value="500" selected>0.5 kg / 1 lb per week</option>
          <option value="750">0.75 kg / 1.5 lb per week</option>
          <option value="1000">1 kg / 2 lb per week</option>
        </select>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Weight Gain Plan</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Target calories for weight gain</p>
        <p class="mt-1"><span id="gain-value" class="text-display-xl text-ink tabular-nums">2,806</span> <span class="text-lg text-mute">kcal/day</span></p>
        <p id="gain-note" class="mt-2 text-sm text-body"></p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Recommended macros</h2></div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th class="px-5 py-3 font-medium">Nutrient</th>
              <th class="px-5 py-3 text-right font-medium">Grams</th>
              <th class="px-5 py-3 text-right font-medium">Calories</th>
            </tr>
          </thead>
          <tbody id="macro-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <MedicalNote />

    <ArticleImage src="/assets/images/articles/weight-timeline.svg" alt="Illustration of a weight gain progress line from a start point toward a higher goal weight." />

    <h2>How to use the Weight Gain Calculator</h2>
    <p>Enter your age, height, current weight, sex, and activity level, then choose a weekly gain target. The calculator estimates your daily calorie target and macro split. A 0.5 kg/week gain is a sensible starting point for most people.</p>

    <h2>What is a healthy rate of weight gain?</h2>
    <p>A healthy pace is about 0.25–0.5 kg (0.5–1 lb) per week for most people. Faster gain usually adds excess fat unless you are new to resistance training. The <a href="/weight-gain-calculator/">weight gain calculator</a> helps you set a realistic pace and daily target so you can minimize fat gain while building lean tissue.</p>

    <h2>Calorie surplus explained</h2>
    <p>One kilogram of body mass stores roughly 7,700 calories. A 500-calorie daily surplus averages about 0.5 kg per week of gain. Smaller surpluses are cleaner and easier to sustain long-term. The <a href="/tdee-calculator/">TDEE calculator</a> gives you your baseline, and the <a href="/calorie-surplus-calculator/">calorie surplus calculator</a> (on this page) converts your desired weekly rate into a daily target.</p>

    <h2>Lean bulk vs dirty bulk</h2>
    <p>A <strong>lean bulk</strong> uses a small, controlled surplus to add muscle with minimal fat — the smarter long-term approach. A <strong>dirty bulk</strong> piles on calories without limits; you gain faster, but most of it is fat you'll have to diet off later. Aim for the lean bulk approach: track your weekly weight, adjust calories if you're gaining faster than 0.5 kg per week, and prioritize protein at the <a href="/protein-calculator/">protein calculator</a>.</p>

    <h2>Best foods for weight gain</h2>
    <ul>
      <li>Nuts, seeds, and nut butters for calorie-dense snacks.</li>
      <li>Oats, rice, potatoes, and pasta for carb fueling.</li>
      <li>Red meat, fish, eggs, and dairy for protein and calories.</li>
      <li>Avocados, olive oil, and full-fat dairy for easy extra calories.</li>
    </ul>

    <h2>How to track progress</h2>
    <p>Weigh yourself weekly under the same conditions. Use the <a href="/body-fat-calculator/">body fat calculator</a> to confirm you are gaining mostly muscle rather than fat. If your body fat percentage rises too quickly, trim the surplus by 100–200 calories and reassess.</p>

    <h2>Pairing gain with training</h2>
    <p>Resistance training turns surplus calories into muscle growth. Combine this plan with the <a href="/one-rep-max-calculator/">one rep max calculator</a> to program progressive overload, and the <a href="/protein-calculator/">protein calculator</a> to hit daily protein targets. For full workout plans, explore the <a href="/workouts/">workouts section</a>.</p>

    <h2>Related guides</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/how-to-gain-weight/">How to Gain Weight the Healthy Way</a></h3>
        <p class="mt-1 text-sm text-body">A practical guide to healthy weight gain: calorie surplus, macro splits, best foods, strength training, and how to avoid excess fat.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/maintenance-calories/">Maintenance Calories: How to Stay at Your Ideal Weight</a></h3>
        <p class="mt-1 text-sm text-body">Find your maintenance calories and learn how to keep your weight stable over time.</p>
      </div>
    </div>

    <Sources sources={[
      { label: "Institute of Medicine — Dietary Reference Intakes for Energy", href: "https://www.nationalacademies.org/publication/dietary-reference-intakes-for-energy" },
      { label: "Academy of Nutrition and Dietetics — Healthy Weight Gain", href: "https://www.niddk.nih.gov/health-information/weight-management" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { bmrMifflinStJeor, tdee, goalCalories, macrosFromCalories, ACTIVITY_LEVELS, type ActivityKey, type Sex, type GoalKey } from "../lib/calculations";
  import { lbToKg } from "../lib/units";

  const root = document.getElementById("calc-root") as HTMLElement | null;
  if (!root) throw new Error("calc-root not found");
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    let unit: "metric" | "imperial" = "metric";

    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as "male" | "female";
      const age = parseFloat(($("age") as HTMLInputElement).value) || 0;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      const h = unit === "imperial" ? lbToKg(parseFloat(($("height") as HTMLInputElement).value) || 0) : parseFloat(($("height") as HTMLInputElement).value) || 0;
      if (unit === "imperial") w = lbToKg(w);
      const activity = ($("activity") as HTMLSelectElement).value as "sedentary" | "light" | "moderate" | "active" | "athlete";
      const rate = parseInt(($("rate") as HTMLSelectElement).value || "500", 10);
      return { sex, age, w, h, activity, rate };
    }

    function render() {
      clearDirty();
      const { sex, age, w, h, activity, rate } = read();
      if (w <= 0 || h <= 0 || age <= 0) return;
      const bmr = bmrMifflinStJeor(sex, age, h, w);
      const maint = tdee(bmr, activity);
      const target = goalCalories(maint, "mildGain", sex); // start with mild gain as baseline for rate
      // Map rate to nearest standard surplus: 250->+250, 500->+500, 750->+750, 1000->+1000
      // goalCalories only has mildGain(+250), gain(+500), extremeGain(+1000). We'll interpolate manually for 750.
      const surpluses: Record<number, { key: GoalKey; extra: number }> = { 250: { key: "mildGain", extra: 250 }, 500: { key: "gain", extra: 500 }, 750: { key: "gain", extra: 750 }, 1000: { key: "extremeGain", extra: 1000 } };
      const chosen = surpluses[rate] || surpluses[500];
      const finalTarget = Math.round(maint + chosen.extra);
      $("gain-value").textContent = fmt(finalTarget);
      $("gain-note").textContent = `${chosen.extra} kcal above maintenance of ${fmt(Math.round(maint))}.`;

      const macros = macrosFromCalories(finalTarget);
      $("macro-table").innerHTML = [
        { name: "Protein", g: macros.proteinG, kcal: macros.proteinKcal },
        { name: "Carbs", g: macros.carbsG, kcal: macros.carbsKcal },
        { name: "Fat", g: macros.fatG, kcal: macros.fatKcal },
      ].map((m) => `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${m.name}</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(m.g)} g</td><td class="px-5 py-2.5 text-right text-mute tabular-nums">${fmt(m.kcal)}</td></tr>`).join("");
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => {
          const on = b.dataset.unit === unit;
          b.setAttribute("aria-pressed", String(on));
          b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on);
        });
        document.querySelectorAll(".weight-unit").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        markDirty();
      });
    });

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
</script>
