---
import MedicalNote from "../../components/ui/MedicalNote.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import type { FaqItem } from "../../lib/seo";

const faqs: FaqItem[] = [
  { q: "What is a TDEE calculator?", a: "A TDEE calculator (Total Daily Energy Expenditure) finds your maintenance calories. Eat this amount to keep weight stable. Use our <a href='/tdee-calculator/'>TDEE calculator</a>." },
  { q: "How does a TDEE calculator work?", a: "It calculates BMR using Mifflin-St Jeor, then multiplies by activity level. Result is your maintenance calories for weight management." },
  { q: "Why is my TDEE calculator wrong?", a: "Common issues: overestimating activity, incorrect stats, or metabolic adaptation. Track weight to verify, then adjust." },
