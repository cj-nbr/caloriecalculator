const faqs: FaqItem[] = [
  { q: "What is the Army tape test?", a: "The Army tape test is a circumference-based body fat screening method used by the U.S. military. It estimates body fat percentage from height, neck, waist, and hip measurements." },
  { q: "How do I perform the Army tape test?", a: "Measure your neck at the midpoint, waist at the narrowest point or navel, and hips at the widest point (women only). Keep the tape snug but not compressed, and measure on bare skin or tight clothing." },
  { q: "What are the Army body fat standards?", a: "Standards vary by age and sex. Men aged 17–20 have a maximum of 24%, women 30%. The thresholds increase slightly with age. Use these as general health references rather than official military requirements." },
  { q: "Can I appeal a failed tape test?", a: "Yes. Soldiers who fail the tape test can often retest or use the body fat calculator appeal process. For personal tracking, use the <a href='/army-body-fat-calculator/'>army body fat calculator</a> to track progress and aim for a standard you can meet." },
  { q: "Is the tape test accurate for muscular people?", a: "Tape-based methods can underestimate body fat in very muscular people because large necks or broad shoulders skew the ratio. If you are athletic, pair the tape test with the <a href='/body-fat-calculator/'>U.S. Navy body fat calculator</a> and the <a href='/lean-body-mass-calculator/'>lean body mass calculator</a>." },
  { q: "How does the tape test compare to other body fat methods?", a: "The tape test is less precise than DEXA or hydrostatic weighing, but it is far more practical. It is best for tracking trends over time rather than as an absolute figure. Keep measurement conditions identical each time." },
  { q: "What is the Army Body Composition Program (ABCP)?", a: "ABCP is the Army's program for monitoring soldier body composition. It uses height-weight screening first, then the tape test for anyone who exceeds the weight standard. Soldiers must pass tape tests and meet readiness requirements." },
];

