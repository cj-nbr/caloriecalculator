---
import MedicalNote from "../../components/ui/MedicalNote.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import type { FaqItem } from "../../lib/seo";
import ArticleImage from "../../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "How many calories are in 1 gram of protein?", a: "There are exactly 4 calories (kcal) in 1 gram of protein. This is a standard measurement used in nutrition to convert protein grams into total calories." },
  { q: "How much is 150 grams of protein in calories?", a: "150 grams of protein equals 600 calories. You calculate this by multiplying 150 grams by 4 calories per gram (150 × 4 = 600)." },
  { q: "What is a good ratio of protein to calories?", a: "A great 'rule of thumb' for high-protein foods is the 10-to-1 ratio: aim for at least 10 grams of protein for every 100 calories. If a yogurt has 120 calories and 15g of protein, it's an excellent high-protein choice." },
  { q: "How many calories does it take to digest a gram of protein?", a: "Your body burns about 20% to 30% of the calories from protein just to digest it. This is called the Thermic Effect of Food (TEF). So, out of the 4 calories in a gram of protein, roughly 0.8 to 1.2 calories are burned during digestion." },
  { q: "How many calories is 100 grams of protein?", a: "100 grams of protein contains exactly 400 calories (100g × 4 kcal/g = 400 kcal)." },
  { q: "How many calories is 180 grams of protein?", a: "180 grams of protein contains 720 calories (180g × 4 kcal/g = 720 kcal)." },
  { q: "How many calories is 200g of protein?", a: "200 grams of protein contains 800 calories (200g × 4 kcal/g = 800 kcal)." }
];
