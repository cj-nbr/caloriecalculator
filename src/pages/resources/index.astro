---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import { breadcrumbSchema } from "../../lib/seo";
import { ALL_CALCULATORS } from "../../data/site";

const resources = [
  { label: "What is BMR?", href: "/resources/what-is-bmr/" },
  { label: "What is TDEE?", href: "/resources/what-is-tdee/" },
  { label: "Mifflin-St Jeor Equation", href: "/resources/mifflin-st-jeor-equation/" },
  { label: "Calories Burned in a Day", href: "/resources/calories-burned-in-a-day/" },
  { label: "BMI Calculator Guide", href: "/resources/bmi-calculator/" },
  { label: "Body Fat Percentage", href: "/resources/body-fat-percentage/" },
  { label: "Macro Calculator Guide", href: "/resources/macro-calculator/" },
  { label: "TDEE Calculator Guide", href: "/resources/tdee-calculator/" },
  { label: "Lean Body Mass Guide", href: "/resources/lean-body-mass/" },
  { label: "Water Intake Calculator", href: "/resources/water-intake-calculator/" },
  { label: "Protein Calculator Guide", href: "/resources/protein-calculator/" },
  { label: "Protein to Calories", href: "/resources/protein-to-calories/" },
  { label: "Weight Loss Calculator Guide", href: "/resources/weight-loss-calculator/" },
  { label: "Ideal Body Weight", href: "/resources/ideal-body-weight/" },
  { label: "Calorie Deficit Guide", href: "/resources/calorie-deficit-guide/" },
  { label: "Calorie Surplus Guide", href: "/resources/calorie-surplus-guide/" },
];

const extraCalculators = [
  { label: "Healthy Weight Calculator", href: "/healthy-weight-calculator/", desc: "BMI-based healthy weight range" },
  { label: "Weight Gain Calculator", href: "/weight-gain-calculator/", desc: "Calorie surplus and timeline" },
  { label: "Maintenance Calories Calculator", href: "/maintenance-calories-calculator/", desc: "Daily calories to stay at your current weight" },
  { label: "Meal Calorie Calculator", href: "/meal-calorie-calculator/", desc: "Split daily calories across meals" },
  { label: "Recipe Calorie Calculator", href: "/recipe-calorie-calculator/", desc: "Total and per-serving recipe calories" },
  { label: "Intermittent Fasting Calculator", href: "/intermittent-fasting-calculator/", desc: "Fasting and eating window planner" },
  { label: "Cycling Calories Calculator", href: "/cycling-calories-calculator/", desc: "Calories burned cycling by pace" },
  { label: "Swimming Calories Calculator", href: "/swimming-calories-calculator/", desc: "Calories burned swimming by intensity" },
];

const allCalculators = [...ALL_CALCULATORS, ...extraCalculators];

const jsonLd = [breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Resources", path: "/resources/" }])];
---

<Layout
  title="Resources & Calculators – Calorie Calculator Free"
  description="Explore all 51+ free calculators and reference resources for BMR, TDEE, and daily calorie needs."
  canonical="/resources/"
  jsonLd={jsonLd}
>
   <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <p class="text-sm font-medium text-brand">Resources</p>
      <h1 class="mt-2 text-display-lg text-ink">Reference resources</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">Plain-English explanations of the key concepts behind your calorie needs.</p>
    </div>
  </header>
  <Section>
    <ArticleImage src="/assets/images/articles/energy-level.svg" alt="Illustration of energy expenditure and metabolism for understanding calorie science." />

    <div class="prose-content mx-auto max-w-3xl">
      <p>These references explain the science behind the calculators on this site — what each measurement means, how it is estimated, and where the numbers come from. Use them alongside the tools to understand your results, then apply them with the relevant calculator. Each topic is written for everyday readers, not specialists.</p>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        resources.map((r) => (
          <a href={r.href} class="card group flex items-center justify-between gap-3 p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
            <span class="text-base font-medium text-ink">{r.label}</span>
            <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- 🧮 All calculators -->
  <Section class="border-t border-hairline bg-canvas-soft">
    <div class="container-page py-12">
      <div class="mb-10 text-center">
        <h2 class="text-display-md text-gradient">Explore all {allCalculators.length} calculators</h2>
        <p class="mx-auto mt-3 max-w-xl text-body">
          A complete toolkit for calories, body composition, and nutrition.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          allCalculators.map((c) => (
            <a
              href={c.href}
              class="card bg-surface group flex items-center justify-between gap-3 p-4 transition-all hover:border-hairline-strong hover:bg-canvas-soft shadow-sm"
            >
              <div>
                <span class="block text-sm font-medium text-ink">{c.label}</span>
                {c.desc && <span class="block text-xs text-mute">{c.desc}</span>}
              </div>
              <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          ))
        }
      </div>
    </div>
  </Section>

</Layout>
