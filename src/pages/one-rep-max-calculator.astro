---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import { breadcrumbSchema, calculatorSchema, faqSchema } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";
import Sources from "../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q: "What is one rep max?", a: "One rep max (1RM) is the maximum amount of weight you can lift for one complete repetition with proper form. It is a key strength benchmark used in powerlifting, weightlifting, and strength training." },
  { q: "How is one rep max calculated?", a: "This calculator uses the Epley formula: 1RM = weight × (1 + reps / 30). It estimates your true 1RM from a submaximal set, so you do not need to lift to failure." },
  { q: "How accurate is the Epley formula?", a: "The Epley formula is reasonably accurate for most people when using 2–10 reps. For very high reps or beginners, the estimate becomes less reliable." },
  { q: "How can I increase my one rep max safely?", a: "Progress gradually with structured programming, prioritize form, include accessory work, and avoid maxing out too frequently. Most programs increase 1RM over weeks and months, not days." },
  { q: "What is a good one rep max for beginners?", a: "Beginner standards vary by lift and body weight. Focus on building a solid technique base first, then use percentage-based programming to increase your 1RM over time." },
  { q: "Should I test my true one rep max?", a: "Testing a true 1RM carries injury risk. Estimating from submaximal reps is safer for most people. If you do test, use a spotter and only after a thorough warm-up." },
  { q: "How often should I calculate my one rep max?", a: "Reassess every 4–8 weeks. Frequent testing can interfere with recovery. Use the calculator to track estimated progress instead of constantly maxing out." },
  { q: "Can one rep max be used for all exercises?", a: "The Epley formula is commonly used for barbell lifts like squat, bench press, and deadlift. For bodyweight or machine exercises, the estimate is less standardized." },
  { q: "What are other 1RM formulas?", a: "Common alternatives include Brzycki (1RM = weight × 36 / (37 - reps)), Lombardi (1RM = weight × reps^0.10), and Mayhew (more complex, uses body weight). Our calculator uses the Epley formula because it is simple and widely accepted." },
  { q: "How do I use 1RM for programming?", a: "Pick rep zones based on goal: 1–3 reps for strength, 8–12 for hypertrophy, 12–15 for endurance. Set working weight as a percentage of 1RM. The <a href='/macro-calculator/'>macro calculator</a> can help you fuel those sessions." },
];

const path = "/one-rep-max-calculator/";
const h1 = "One Rep Max Calculator";
const description =
  "Free one rep max calculator. Estimate your 1RM for squat, bench press, deadlift, and other lifts using the Epley formula.";

const crumbs = [
  { name: "Home", path: "/" },
  { name: h1, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  calculatorSchema(h1, description, path),
  faqSchema(faqs),
];
---

<CalculatorLayout
  title="One Rep Max Calculator — Free 1RM Calculator (Epley Formula)"
  h1={h1}
  description={description}
  intro="Estimate your one-rep max from the weight and reps you can complete safely. No need to lift to failure."
  path={path}
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <MedicalNote />
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
        Enter the weight you lifted and how many reps you completed. The calculator estimates your 1RM.
      </p>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5">
          <label for="weight" class="block text-sm font-medium text-ink">Weight lifted</label>
          <input id="weight" type="number" inputmode="decimal" min="0" step="0.5" value="100" class={inputCls} />
        </div>
        <div class="space-y-1.5">
          <label for="reps" class="block text-sm font-medium text-ink">Reps completed</label>
          <input id="reps" type="number" inputmode="numeric" min="1" max="20" value="5" class={inputCls} />
        </div>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate 1RM</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Estimated one rep max</p>
        <p class="mt-1"><span id="orm-value" class="text-display-xl text-ink tabular-nums">116.7</span> <span class="text-lg text-mute">kg</span></p>
        <p id="orm-note" class="mt-2 text-sm text-body"></p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Weight for common rep ranges</h2></div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th class="px-5 py-3 font-medium">Reps</th>
              <th class="px-5 py-3 text-right font-medium">Weight</th>
              <th class="px-5 py-3 text-right font-medium">% of 1RM</th>
            </tr>
          </thead>
          <tbody id="orm-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/barbell-1rm.svg" alt="Illustration of a barbell loaded with weight plates representing strength training and one rep max." />

    <h2>What is one rep max</h2>
    <p>One rep max — usually written as 1RM — is the most weight you can lift for a single complete repetition with correct form. It is the gold-standard measure of maximal strength and is used in powerlifting, bodybuilding, and general strength programming.</p>

    <h2>The Epley formula explained in detail</h2>
    <p>The Epley formula was published in 1985 by Matt Epley and quickly became the standard for estimating 1RM from lighter sets. It is:</p>
    <p><code>1RM = weight × (1 + reps / 30)</code></p>
    <p>If you lift 100 kg for 5 reps, the formula gives 100 × (1 + 5/30) = 116.7 kg. The formula assumes a roughly linear relationship between load and reps, which works well for compound barbell lifts. It is less reliable above 10–12 reps, where fatigue and endurance begin to blur the 1RM estimate.</p>

    <h2>How to test 1RM safely</h2>
    <p>True 1RM testing is risky if you are unprepared. A safer approach is to use submaximal testing: pick a weight you can lift for 2–6 reps with good form, then apply the Epley formula. If you do test a true 1RM, follow these rules:</p>
    <ul>
      <li>Warm up thoroughly with light sets of the target lift.</li>
      <li>Use a spotter or safety bars / pins.</li>
      <li>Choose a weight you can handle for 1–2 reps only.</li>
      <li>Stop if your technique breaks down.</li>
      <li>Limit true 1RM attempts to once every 4–8 weeks.</li>
    </ul>

    <h2>One rep max standards by level and bodyweight</h2>
    <p>1RM standards give context but vary by lift, sex, age, and training history. Use them as rough guides rather than rigid targets:</p>
    <table>
      <thead><tr><th scope="col">Level</th><th scope="col">Relative 1RM (bodyweight ×)</th><th scope="col">Typical use</th></tr></thead>
      <tbody>
        <tr><td>Beginner</td><td>0.75–1.0×</td><td>Learning technique</td></tr>
        <tr><td>Intermediate</td><td>1.0–1.5×</td><td>Consistent training 1–3 years</td></tr>
        <tr><td>Advanced</td><td>1.5–2.0×+</td><td>Competitive or long-term training</td></tr>
      </tbody>
    </table>

    <h2>How to use 1RM for programming</h2>
    <p>Once you know your estimated 1RM, you can set precise training loads:</p>
    <ul>
      <li><strong>Strength:</strong> 80–90% of 1RM for 3–5 reps</li>
      <li><strong>Hypertrophy:</strong> 65–75% of 1RM for 8–12 reps</li>
      <li><strong>Endurance:</strong> 50–65% of 1RM for 12–15+ reps</li>
    </ul>
    <p>Pair this with the <a href="/macro-calculator/">macro calculator</a> to fuel your sessions and the <a href="/protein-calculator/">protein calculator</a> to support recovery.</p>

    <h2>Other 1RM formulas</h2>
    <p>Several formulas exist, each with trade-offs:</p>
    <table>
      <thead><tr><th scope="col">Formula</th><th scope="col">Equation</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        <tr><td>Epley</td><td>w × (1 + r/30)</td><td>Simple; best for 2–10 reps</td></tr>
        <tr><td>Brzycki</td><td>w × 36 / (37 - r)</td><td>Slightly conservative; popular in strength coaching</td></tr>
        <tr><td>Lombardi</td><td>w × r^0.10</td><td>Aggressive; better for power athletes</td></tr>
        <tr><td>Mayhew</td><td>(100 × w) / (52.2 + 41.9 × e^(-0.055 × r))</td><td>Complex; includes body-weight scaling</td></tr>
      </tbody>
    </table>
    <p>For most lifters, the difference between formulas is small. Use Epley for simplicity, or Brzycki if your coach prefers a more conservative estimate.</p>

    <h2>Using 1RM without lifting to failure</h2>
    <p>Submaximal testing preserves energy and reduces injury risk. Pick a weight you can move cleanly for 3–6 reps, apply the formula, and use that as your working estimate. Reassess every 4–8 weeks as your strength changes.</p>

    <Sources sources={[
      { label: "Epley Formula - One Repetition Maximum", href: "https://en.wikipedia.org/wiki/One-repetition_maximum" },
      { label: "Brzycki PR. Strength testing: predictions. Journal of Health, Physical Education, and Recreation. 1993.", href: "https://www.researchgate.net/publication/319732465" },
      { label: "Mayhew J et al. A generalized equation for predicting 1RM. Journal of Strength and Conditioning Research. 1992.", href: "https://pubmed.ncbi.nlm.nih.gov/16287344/" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { oneRepMaxEpley } from "../lib/calculations";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    const fmt = (n: number) => Math.round(n * 10) / 10;

    function render() {
      clearDirty();
      const weight = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      const reps = parseInt(($("reps") as HTMLInputElement).value || "0", 10);
      if (weight <= 0 || reps <= 0) return;

      const orm = oneRepMaxEpley(weight, reps);
      $("orm-value").textContent = fmt(orm).toLocaleString("en-US");

      const tableRanges = [1, 2, 3, 5, 8, 10, 12, 15];
      $("orm-table").innerHTML = tableRanges
        .map(
          (r) => {
            const w = orm * (1 - (r - 1) / 30);
            const pct = Math.round((w / orm) * 100);
            return `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${r}</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(Math.max(0, w)).toLocaleString("en-US")}</td><td class="px-5 py-2.5 text-right text-mute tabular-nums">${pct}%</td></tr>`;
          }
        )
        .join("");
    }

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
