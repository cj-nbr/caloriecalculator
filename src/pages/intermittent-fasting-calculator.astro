---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { selectCls } from "../lib/ui";
import { FASTING_PLANS } from "../lib/calculations";
import type { FaqItem } from "../lib/seo";
import Sources from "../components/ui/Sources.astro";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "What is intermittent fasting?", a: "Intermittent fasting is an eating pattern that cycles between fasting and eating windows. Popular approaches include 16:8, 18:6, and OMAD, and they are used for weight management, simplicity, and metabolic health." },
  { q: "How does the 16:8 method work?", a: "In 16:8 fasting, you fast for 16 hours and eat during an 8-hour window each day. For example, skip breakfast and eat only between 12 pm and 8 pm." },
  { q: "Can I drink coffee while fasting?", a: "Black coffee, plain tea, and water are generally allowed during fasting windows. Adding sugar, milk, or cream can break the fast because it introduces calories." },
  { q: "Is intermittent fasting safe?", a: "For most healthy adults, intermittent fasting is safe, but people with diabetes, eating disorders, or who are pregnant should consult a doctor before starting." },
  { q: "How much weight can I lose with intermittent fasting?", a: "Results vary, but intermittent fasting often produces about 0.5–1 lb (0.2–0.5 kg) of weight loss per week when combined with a modest calorie deficit and good nutrition." },
  { q: "What should I eat during my eating window?", a: "Focus on whole foods, protein, fiber, and healthy fats. Use the <a href='/macro-calculator/'>macro calculator</a> to make sure you hit your protein and calorie targets within your eating window." },
  { q: "Does intermittent fasting slow metabolism?", a: "Short-term fasting does not meaningfully slow metabolism. Long-term very low-calorie dieting can, but typical intermittent fasting paired with adequate nutrition is generally metabolically safe." },
  { q: "Can I exercise while fasting?", a: "Light to moderate exercise is usually fine during fasting. For intense sessions, eating a small meal beforehand can help maintain performance. Use the <a href='/target-heart-rate-calculator/'>target heart rate calculator</a> to keep effort in a safe zone." },
  { q: "Does intermittent fasting cause muscle loss?", a: "Not if you eat enough protein. Aim for 1.6–2.2 g/kg protein during eating windows. Use the <a href='/protein-calculator/'>protein calculator</a> to protect muscle while fasting." },
  { q: "Is 16:8 the best fasting plan?", a: "16:8 is the most popular for steady weight loss, but 12:12 or 14:10 are better for beginners. OMAD is advanced. Use the <a href='/intermittent-fasting-calculator/'>intermittent fasting calculator</a> to compare plans." },
  { q: "Can I do intermittent fasting long term?", a: "Yes. Many people sustain 16:8 or 18:6 for months or years. Long-term success depends on nutrition quality during eating windows and a plan that fits your lifestyle." },
  { q: "Does fasting affect sleep or energy?", a: "Some people feel more energized, while others experience mild fatigue the first 1–2 weeks. Side effects usually pass as your body adapts." },
];
---

<CalculatorLayout
  title="Intermittent Fasting Calculator | Best Schedule for Weight Loss"
  h1="Intermittent Fasting Calculator"
  description="Discover your perfect fasting window. Our free intermittent fasting calculator helps you plan 16:8, 18:6, and OMAD schedules for optimal fat burning and health."
  intro="Take the guesswork out of fasting. Use our free intermittent fasting calculator to determine the perfect eating and fasting windows for your lifestyle, whether you prefer 16:8, 18:6, or OMAD."
  path="/intermittent-fasting-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <MedicalNote />
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">Example values are pre-filled. Enter your own details for accurate results.</p>
      <div class="mb-4 space-y-1.5">
        <label for="plan" class="block text-sm font-medium text-ink">Fasting plan</label>
        <select id="plan" class={selectCls}>
          {FASTING_PLANS.map((p) => (
            <option value={p.name} selected={p.name === "16:8"}>{p.name} — {p.description}</option>
          ))}
        </select>
      </div>
      <button type="submit" class="inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Fasting Window</button>
    </form>

    <div class="space-y-5">
      <div class="card p-6 sm:p-8 text-center">
        <p class="text-sm text-mute">Your fasting window</p>
        <p id="fast-window" class="mt-1 text-display-lg text-ink">16 hours fast / 8 hours eat</p>
        <p id="fast-desc" class="mt-2 text-sm text-body"></p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">All plans</h2></div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th class="px-5 py-3 font-medium">Plan</th>
              <th class="px-5 py-3 text-right font-medium">Fast</th>
              <th class="px-5 py-3 text-right font-medium">Eat</th>
            </tr>
          </thead>
          <tbody id="fast-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/fasting-clock.svg" alt="Illustration of a clock face showing time-restricted eating windows for intermittent fasting." />

    <h2>How to use the Intermittent Fasting Calculator</h2>
    <p>Pick a fasting plan from the dropdown and press <strong>Calculate Fasting Window</strong>. The tool shows your fasting and eating hours, plus a comparison table of all plans. Beginners often start with 12:12 or 14:10 before moving to 16:8.</p>

    <h2>What is intermittent fasting?</h2>
    <p>Intermittent fasting is an eating pattern that alternates between fasting and eating. The goal is not just calorie restriction — many people use it to simplify meal timing, improve insulin sensitivity, and support fat loss while preserving muscle.</p>

    <h2>Popular fasting plans compared</h2>
    <p>Different plans suit different lifestyles. Use the <a href="/intermittent-fasting-calculator/">intermittent fasting calculator</a> to visualize windows:</p>
    <table>
      <thead><tr><th>Plan</th><th>Fast hours</th><th>Eat hours</th><th>Best for</th></tr></thead>
      <tbody>
        <tr><td>12:12</td><td>12</td><td>12</td><td>Beginners, maintenance</td></tr>
        <tr><td>14:10</td><td>14</td><td>10</td><td>Gentle weight loss</td></tr>
        <tr><td>16:8</td><td>16</td><td>8</td><td>Most popular, steady fat loss</td></tr>
        <tr><td>18:6</td><td>18</td><td>6</td><td>Fewer, larger meals</td></tr>
        <tr><td>20:4</td><td>20</td><td>4</td><td>Advanced, one big meal</td></tr>
        <tr><td>OMAD</td><td>23</td><td>1</td><td>Advanced, requires careful nutrition</td></tr>
      </tbody>
    </table>

    <h2>How to choose a fasting plan</h2>
    <ul>
      <li><strong>12:12:</strong> great for beginners and maintenance.</li>
      <li><strong>16:8:</strong> the most popular plan for steady weight loss.</li>
      <li><strong>18:6 / 20:4:</strong> useful if you prefer fewer, larger meals.</li>
      <li><strong>OMAD:</strong> advanced and not ideal for everyone; requires careful nutrition planning.</li>
    </ul>

    <h2>What to eat during eating windows</h2>
    <p>A shorter eating window does not excuse poor food choices. Prioritize protein using the <a href="/protein-calculator/">protein calculator</a>, balance carbs for energy, and keep fats moderate. Use the <a href="/meal-calorie-calculator/">meal calorie calculator</a> to split your target across one or two meals if you do OMAD.</p>
    <p>Focus on whole foods: lean meats, fish, eggs, vegetables, fruits, whole grains, and healthy fats. Avoid binge-eating processed foods just because the fast is over. The <a href="/macro-calculator/">macro calculator</a> helps you hit the right ratios within your eating window.</p>

    <h2>Common myths about fasting</h2>
    <ul>
      <li><strong>Myth: Fasting starves your muscles.</strong> Fact: Adequate protein (1.6–2.2 g/kg) during eating windows preserves muscle. Use the <a href="/protein-calculator/">protein calculator</a> to stay safe.</li>
      <li><strong>Myth: You must eat breakfast.</strong> Fact: Meal timing matters less than total nutrition. Skipping breakfast is fine if your eating window fits your schedule.</li>
      <li><strong>Myth: Fasting slows metabolism permanently.</strong> Fact: Short-term fasting does not meaningfully change metabolism. Very low-calorie dieting over months can, but typical IF with good nutrition is safe.</li>
      <li><strong>Myth: You can eat anything during eating windows.</strong> Fact: Calorie quality matters. Binge-eating junk food still causes weight gain and nutrient deficits.</li>
      <li><strong>Myth: Fasting is a quick fix.</strong> Fact: Fasting works best as a sustainable habit combined with consistent nutrition and activity.</li>
    </ul>

    <h2>Fasting and exercise</h2>
    <p>Light to moderate exercise is usually fine during fasting. For intense sessions, eating a small meal beforehand can help maintain performance. Use the <a href="/target-heart-rate-calculator/">target heart rate calculator</a> to keep effort in a safe zone. For cardio estimates around your fast, try the <a href="/walking-calorie-calculator/">walking calorie calculator</a>, <a href="/cycling-calories-calculator/">cycling calories calculator</a>, or <a href="/swimming-calories-calculator/">swimming calories calculator</a>.</p>

    <h2>Fasting and weight loss</h2>
    <p>Fasting helps many people eat fewer total calories without strict counting. To make it sustainable, pair it with high-protein meals using the <a href="/protein-calculator/">protein calculator</a> and a sensible daily calorie target from the <a href="/">calorie calculator</a>.</p>

    <h2>Related guides</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/intermittent-fasting-for-beginners/">Intermittent Fasting for Beginners</a></h3>
        <p class="mt-1 text-sm text-body">A beginner-friendly guide to intermittent fasting: popular plans, safety tips, what to eat, and how to combine it with calorie and macro targets.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/maintenance-calories/">Maintenance Calories: How to Stay at Your Ideal Weight</a></h3>
        <p class="mt-1 text-sm text-body">Pair your fasting schedule with a stable maintenance calorie target for long-term results.</p>
      </div>
    </div>

    <Sources sources={[
      { label: "Harvard T.H. Chan School of Public Health — Intermittent Fasting", href: "https://www.hsph.harvard.edu/nutritionsource/healthy-weight/best-diet-quality-counts/intermittent-fasting/" },
      { label: "National Institute on Aging — Intermittent Fasting for Health", href: "https://www.nia.nih.gov/health/intermittent-fasting" },
      { label: "Academy of Nutrition and Dietetics — What is Intermittent Fasting?", href: "https://www.eatright.org/health/wellness/healthy-aging/intermittent-fasting-what-you-need-to-know" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { FASTING_PLANS } from "../lib/calculations";
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;

    function render() {
      const planName = ($("plan") as HTMLSelectElement).value;
      const plan = FASTING_PLANS.find((p) => p.name === planName);
      if (!plan) return;

      $("fast-window").textContent = `${plan.fastHours}h fast / ${plan.eatHours}h eat`;
      $("fast-desc").textContent = plan.description;

      $("fast-table").innerHTML = FASTING_PLANS.map((p) =>
        `<tr class="border-b border-hairline last:border-0 ${p.name === planName ? "bg-brand/5" : ""}"><td class="px-5 py-2.5 ${p.name === planName ? "font-medium text-ink" : "text-body"}">${p.name}</td><td class="px-5 py-2.5 text-right tabular-nums ${p.name === planName ? "font-medium text-ink" : "text-mute"}">${p.fastHours}h</td><td class="px-5 py-2.5 text-right tabular-nums ${p.name === planName ? "font-medium text-ink" : "text-mute"}">${p.eatHours}h</td></tr>`
      ).join("");
    }

    ($("calc-form") as HTMLFormElement).addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
