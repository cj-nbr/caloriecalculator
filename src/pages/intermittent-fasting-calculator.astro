---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { selectCls } from "../lib/ui";
import { FASTING_PLANS } from "../lib/calculations";
import type { FaqItem } from "../lib/seo";
import Sources from "../components/ui/Sources.astro";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "What is intermittent fasting?", a: "Intermittent fasting is an eating pattern that cycles between fasting and eating windows. Popular approaches include 16:8, 18:6, and OMAD, and they are used for weight management, simplicity, and metabolic health." },
  { q: "How does the 16:8 method work?", a: "In 16:8 fasting, you fast for 16 hours and eat during an 8-hour window each day. For example, skip breakfast and eat only between 12 pm and 8 pm." },
  { q: "Can I drink coffee while fasting?", a: "Black coffee, plain tea, and water are generally allowed during fasting windows. Adding sugar, milk, or cream can break the fast because it introduces calories." },
  { q: "Is intermittent fasting safe?", a: "For most healthy adults, intermittent fasting is safe, but people with diabetes, eating disorders, or who are pregnant should consult a doctor before starting." },
  { q: "How much weight can I lose with intermittent fasting?", a: "Results vary, but intermittent fasting often produces about 0.5–1 lb (0.2–0.5 kg) of weight loss per week when combined with a modest calorie deficit and good nutrition." },
  { q: "What should I eat during my eating window?", a: "Focus on whole foods, protein, fiber, and healthy fats. Use the <a href='/macro-calculator/'>macro calculator</a> to make sure you hit your protein and calorie targets within your eating window." },
  { q: "Does intermittent fasting slow metabolism?", a: "Short-term fasting does not meaningfully slow metabolism. Long-term very low-calorie dieting can, but typical intermittent fasting paired with adequate nutrition is generally metabolically safe." },
  { q: "Can I exercise while fasting?", a: "Light to moderate exercise is usually fine during fasting. For intense sessions, eating a small meal beforehand can help maintain performance. Use the <a href='/target-heart-rate-calculator/'>target heart rate calculator</a> to keep effort in a safe zone." },
  { q: "Does intermittent fasting cause muscle loss?", a: "Not if you eat enough protein. Aim for 1.6–2.2 g/kg protein during eating windows. Use the <a href='/protein-calculator/'>protein calculator</a> to protect muscle while fasting." },
  { q: "Is 16:8 the best fasting plan?", a: "16:8 is the most popular for steady weight loss, but 12:12 or 14:10 are better for beginners. OMAD is advanced. Use the <a href='/intermittent-fasting-calculator/'>intermittent fasting calculator</a> to compare plans." },
  { q: "Can I do intermittent fasting long term?", a: "Yes. Many people sustain 16:8 or 18:6 for months or years. Long-term success depends on nutrition quality during eating windows and a plan that fits your lifestyle." },
  { q: "Does fasting affect sleep or energy?", a: "Some people feel more energized, while others experience mild fatigue the first 1–2 weeks. Side effects usually pass as your body adapts." },
];
---

<CalculatorLayout
  title="Intermittent Fasting Weight Loss Calculator & Schedule Planner"
  h1="Intermittent Fasting Weight Loss Calculator"
  description="Use our free Intermittent Fasting Weight Loss Calculator to find your ideal 16:8, 18:6, or OMAD fasting window. Maximize fat burning and optimize your weight loss schedule."
  intro="Take the guesswork out of fasting for weight loss. Use our free intermittent fasting weight loss calculator to determine the perfect eating and fasting windows to maximize fat burning, whether you prefer 16:8, 18:6, or OMAD."
  path="/intermittent-fasting-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <MedicalNote />
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
      <p role="note" class="mb-4 text-xs leading-relaxed text-mute">Example values are pre-filled. Enter your own details for accurate results.</p>
      <div class="mb-4 space-y-1.5">
        <label for="plan" class="block text-sm font-medium text-ink">Fasting plan</label>
        <select id="plan" class={selectCls}>
          {FASTING_PLANS.map((p) => (
            <option value={p.name} selected={p.name === "16:8"}>{p.name} — {p.description}</option>
          ))}
        </select>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Fasting Window</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Your fasting window</p>
        <p id="fast-window" class="mt-1 text-display-lg text-ink">16 hours fast / 8 hours eat</p>
        <p id="fast-desc" class="mt-2 text-sm text-body"></p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">All plans</h2></div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-mute">
              <th class="px-5 py-3 font-medium">Plan</th>
              <th class="px-5 py-3 text-right font-medium">Fast</th>
              <th class="px-5 py-3 text-right font-medium">Eat</th>
            </tr>
          </thead>
          <tbody id="fast-table"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/fasting-clock.svg" alt="Illustration of a clock face showing time-restricted eating windows for an intermittent fasting weight loss calculator." />

    <h2>How to use the Intermittent Fasting Weight Loss Calculator</h2>
    <p>Using our <strong>intermittent fasting weight loss calculator</strong> is incredibly simple. Just pick your preferred fasting plan from the dropdown menu and press <strong>Calculate Fasting Window</strong>. The tool instantly displays your optimal fasting and eating hours, alongside a comprehensive comparison table of all available plans. If you are new to time-restricted eating, beginners often start with a gentle 12:12 or 14:10 window before progressing to the highly effective 16:8 method for maximum weight loss.</p>

    <h2>What is intermittent fasting and how does it aid weight loss?</h2>
    <p>Intermittent fasting (IF) is an eating pattern that strictly alternates between fasting (water-only) and eating windows. Unlike traditional diets, the primary goal of IF is not inherently about <em>what</em> you eat, but rather <em>when</em> you eat.</p>
    <p>From a weight loss perspective, intermittent fasting works through two main mechanisms:</p>
    <ul>
        <li><strong>Caloric Restriction by Default:</strong> By restricting your eating window to just 8 or 6 hours a day, it becomes naturally much harder to over-consume calories. This effortless reduction in daily caloric intake directly drives weight loss.</li>
        <li><strong>Insulin Optimization:</strong> When you fast for extended periods (typically beyond 12 hours), your insulin levels drop significantly. Low insulin signals your body to stop storing fat and start mobilizing stored body fat for energy. This metabolic switch is the core reason intermittent fasting is highly praised for stubborn fat loss.</li>
    </ul>

    <h2>Popular fasting plans compared for weight loss</h2>
    <p>Different plans suit different lifestyles and weight loss goals. Use the <a href="/intermittent-fasting-calculator/">intermittent fasting weight loss calculator</a> above to visualize your windows:</p>
    <table>
      <thead><tr><th scope="col">Plan</th><th scope="col">Fast hours</th><th scope="col">Eat hours</th><th scope="col">Weight Loss Potential & Best For</th></tr></thead>
      <tbody>
        <tr><td>12:12</td><td>12</td><td>12</td><td><strong>Low:</strong> Great for beginners and weight maintenance.</td></tr>
        <tr><td>14:10</td><td>14</td><td>10</td><td><strong>Moderate:</strong> Gentle weight loss and metabolic reset.</td></tr>
        <tr><td>16:8</td><td>16</td><td>8</td><td><strong>High:</strong> The absolute sweet spot for steady, sustainable fat loss.</td></tr>
        <tr><td>18:6</td><td>18</td><td>6</td><td><strong>Very High:</strong> Accelerated weight loss, fewer but larger meals.</td></tr>
        <tr><td>20:4</td><td>20</td><td>4</td><td><strong>Extreme:</strong> Advanced fat burning, often called the "Warrior Diet".</td></tr>
        <tr><td>OMAD</td><td>23</td><td>1</td><td><strong>Extreme:</strong> Advanced only. Maximum insulin drop, requires careful nutrition.</td></tr>
      </tbody>
    </table>

    <h2>Combining Fasting with Calorie Deficits</h2>
    <p>While an intermittent fasting weight loss calculator helps you time your meals perfectly, the fundamental law of thermodynamics still applies: you must be in a calorie deficit to lose weight. Fasting makes a deficit easier, but it doesn't replace it.</p>
    <p>To guarantee weight loss, we highly recommend calculating your baseline energy expenditure using a <a href="/maintenance-calories-calculator/">maintenance calories calculator</a>. Once you know your TDEE, subtract 300 to 500 calories. That is the exact number of calories you should aim to consume <em>inside</em> your eating window.</p>

    <h2>What to eat during your eating window</h2>
    <p>A shorter eating window is not a free pass to make poor food choices. To maximize the weight loss benefits of your fasting schedule, you must prioritize nutrient density.</p>
    <p>First and foremost, prioritize protein. High protein intake keeps you satiated during the fast and prevents muscle loss while dropping body fat. Use our protein calculator (or <a href="/macro-calculator/">macro calculator</a>) to find your exact daily requirement. Balance this with complex carbohydrates for energy and moderate healthy fats for hormonal health.</p>
    <p>If you are attempting an advanced strategy like OMAD (One Meal A Day), you must be extremely strategic to ensure you get all your nutrients in a single sitting. Try running your targets through a <a href="/meal-calorie-calculator/">meal calorie calculator</a> to visualize how dense that single meal needs to be.</p>

    <h2>Common myths about fasting and weight loss</h2>
    <ul>
      <li><strong>Myth: Fasting starves your muscles.</strong> Fact: As long as you hit your daily protein targets during your eating window, your body will preserve muscle tissue and selectively burn fat.</li>
      <li><strong>Myth: You must eat breakfast to stoke your metabolism.</strong> Fact: Meal timing matters far less than your total 24-hour nutritional intake. Skipping breakfast is a core component of the 16:8 method and directly aids fat loss.</li>
      <li><strong>Myth: Fasting slows your metabolism permanently.</strong> Fact: Short-term fasting actually causes a slight <em>increase</em> in metabolic rate due to elevated norepinephrine. Only long-term, extreme caloric restriction slows metabolism.</li>
      <li><strong>Myth: You can eat unlimited calories during your eating window.</strong> Fact: Calorie quality and quantity still matter. Binge-eating 4,000 calories of junk food in an 8-hour window will still result in weight gain.</li>
    </ul>

    <h2>Fasting and Exercise</h2>
    <p>Training in a fasted state can further accelerate fat oxidation. Light to moderate exercise (like brisk walking or steady-state cycling) is highly effective when done at the end of your fasting window. For intense weightlifting or HIIT, some athletes prefer eating a small meal beforehand to maintain peak performance.</p>
    <p>Use the <a href="/target-heart-rate-calculator/">target heart rate calculator</a> to ensure your fasted cardio is kept in the optimal fat-burning zone (Zone 2). For accurate estimates of how many calories you are burning around your fast, try our <a href="/walking-calorie-calculator/">walking calorie calculator</a> or <a href="/cycling-calories-calculator/">cycling calories calculator</a>.</p>

    <h2>Related Guides for Fasting Success</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/how-many-calories-should-i-eat/">How Many Calories Should I Eat?</a></h3>
        <p class="mt-1 text-sm text-body">A comprehensive guide on determining your perfect calorie deficit to pair with your fasting schedule.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/guides/maintenance-calories/">Maintenance Calories Guide</a></h3>
        <p class="mt-1 text-sm text-body">Learn how to seamlessly transition from weight loss to weight maintenance once you reach your goals using intermittent fasting.</p>
      </div>
    </div>

    <Sources sources={[
      { label: "Harvard T.H. Chan School of Public Health — Intermittent Fasting", href: "https://www.hsph.harvard.edu/nutritionsource/healthy-weight/best-diet-quality-counts/intermittent-fasting/" },
      { label: "National Institute on Aging — Intermittent Fasting for Health", href: "https://www.nia.nih.gov/health/intermittent-fasting" },
      { label: "Academy of Nutrition and Dietetics — What is Intermittent Fasting?", href: "https://www.hsph.harvard.edu/nutritionsource/healthy-weight/diet-reviews/intermittent-fasting/" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { FASTING_PLANS } from "../lib/calculations";
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }

    function render() {
      clearDirty();
      const planName = ($("plan") as HTMLSelectElement).value;
      const plan = FASTING_PLANS.find((p) => p.name === planName);
      if (!plan) return;

      $("fast-window").textContent = `${plan.fastHours}h fast / ${plan.eatHours}h eat`;
      $("fast-desc").textContent = plan.description;

      $("fast-table").innerHTML = FASTING_PLANS.map((p) =>
        `<tr class="border-b border-hairline last:border-0 ${p.name === planName ? "bg-brand/5" : ""}"><td class="px-5 py-2.5 ${p.name === planName ? "font-medium text-ink" : "text-body"}">${p.name}</td><td class="px-5 py-2.5 text-right tabular-nums ${p.name === planName ? "font-medium text-ink" : "text-mute"}">${p.fastHours}h</td><td class="px-5 py-2.5 text-right tabular-nums ${p.name === planName ? "font-medium text-ink" : "text-mute"}">${p.eatHours}h</td></tr>`
      ).join("");
    }

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
