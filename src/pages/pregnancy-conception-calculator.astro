---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "How do I calculate conception date?", a: "Conception typically occurs 14 days after LMP (ovulation). Subtract 14 days from due date to get approximate conception date." },
  { q: "What is conception window?", a: "Sperm survives up to 5 days, egg survives 1 day. Conception window spans about 6 days before ovulation to 1 day after ovulation." },
  { q: "How accurate is conception calculator?", a: "Conception date estimate is within 1-2 days if cycles are regular. Irregular cycles reduce accuracy." },
  { q: "When did I conceive based on due date?", a: "Subtract 266 days (38 weeks) from due date. This assumes full-term pregnancy and typical ovulation timing." },
  { q: "What is the fertility window?", a: "The 6-day period ending on the day of ovulation. Highest chance of conception is 1-2 days before ovulation." },
];
---

<CalculatorLayout
  title="Pregnancy Conception Calculator — Fertility & Ovulation Timing"
  h1="Pregnancy Conception Calculator"
  description="Calculate your approximate conception date and fertility window based on LMP or due date."
  intro="Find your conception date and fertile window for pregnancy planning."
  path="/pregnancy-conception-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Use LMP or due date to calculate conception timing.
    </p>
      <div class="mb-4 space-y-1.5">
        <label for="lmp" class="block text-sm font-medium text-ink">Last Menstrual Period (LMP)</label>
        <input id="lmp" type="date" class={inputCls} />
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="cycle" class="block text-sm font-medium text-ink">Cycle Length (days)</label>
        <input id="cycle" type="number" min="20" max="45" value="28" class={inputCls} />
        <p class="text-xs text-mute mt-1">Average is 28 days. Count from first day of LMP to day before next period starts.</p>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Conception</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Most Likely Conception Date</p>
        <p id="conception" class="mt-1 text-display-xl text-ink tabular-nums">—</p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Fertile Window</h2></div>
        <table class="w-full text-sm">
          <tbody id="fertile"></tbody>
        </table>
      </div>
      <div class="card p-5">
        <p class="text-sm text-mute">Estimated Due Date</p>
        <p id="due-date" class="mt-1 text-display-md text-ink tabular-nums">—</p>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <MedicalNote strong />

    <ArticleImage src="/assets/images/articles/conception-window.svg" alt="Illustration of a fertile window showing the timing of conception and ovulation." />

    <h2>Conception Timing Explained</h2>
    <p>Conception occurs when sperm meets egg. Sperm can survive up to 5 days in the female reproductive tract, while the egg survives about 1 day after ovulation. This creates a 6-day fertile window.</p>

    <h2>Factors That Affect Conception Timing</h2>
    <ul>
      <li>Cycle length variations affect ovulation day</li>
      <li>Sperm survival (up to 5 days)</li>
      <li>Egg viability (about 24 hours)</li>
      <li>Ovulation timing (typically cycle day 14 in 28-day cycles)</li>
    </ul>

    <h2>Related Tools</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/pregnancy-calculator/">Pregnancy Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Full pregnancy timeline.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/due-date-calculator/">Due Date Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Calculate delivery date.</p>
      </div>
    </div>
  </Fragment>
</CalculatorLayout>

<script>
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
    const addDays = (date: Date, days: number) => { const d = new Date(date); d.setDate(d.getDate() + days); return d; };

    function render() {
      clearDirty();
      const lmpVal = ($("lmp") as HTMLInputElement).value;
      const cycleLen = parseInt(($("cycle") as HTMLInputElement).value) || 28;
      if (!lmpVal) return;
      const lmp = new Date(lmpVal);
      const ovulationDay = cycleLen - 14;
      const ovulationDate = addDays(lmp, ovulationDay);
      const conceptionDate = ovulationDate;
      const dueDate = addDays(lmp, 280);

      const fertileStart = addDays(lmp, ovulationDay - 5);
      const fertileEnd = addDays(lmp, ovulationDay + 1);

      $("conception").textContent = fmt(conceptionDate);
      $("due-date").textContent = fmt(dueDate);

      const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      const fertileEntries = [
        { label: "Fertile window start", d: fertileStart },
        { label: "Ovulation (most fertile)", d: ovulationDate },
        { label: "Fertile window end", d: fertileEnd },
      ];
      $("fertile").innerHTML = fertileEntries.map(f => {
        const dayName = days[f.d.getDay()];
        return `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${f.label}</td><td class="px-5 py-2.5 text-right text-ink">${fmt(f.d)} <span class="text-xs text-mute">(${dayName})</span></td></tr>`;
      }).join("");
    }

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
