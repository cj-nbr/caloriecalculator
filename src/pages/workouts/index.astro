---
import ContentLayout from "../../layouts/ContentLayout.astro";
import TopicCategoryGrid from "../../components/workouts/TopicCategoryGrid.astro";

const categories = [
  { title: "Leg Workouts", href: "/workouts/leg-workouts/", description: "Beginner routines, gym exercises, hamstring guidance, and leg day mistakes." },
  { title: "Chest Workouts", href: "/workouts/chest-workouts/", description: "Push-up, press, flye, and chest training guidance." },
  { title: "Back Workouts", href: "/workouts/back-workouts/", description: "Rows, pulldowns, pull-ups, posture, and pulling strength." },
  { title: "Shoulder Workouts", href: "/workouts/shoulder-workouts/", description: "Presses, raises, face pulls, and shoulder stability work." },
  { title: "Home Workouts", href: "/workouts/home-workouts/", description: "No-equipment routines for strength, cardio, and mobility." },
  { title: "Leg Curl Machine", href: "/workouts/leg-curl-machine/", description: "Complete leg curl machine guide with setup, muscles worked, benefits, alternatives, and mistakes." },
];

const faqs = [
  { q: "What workout pages are available?", a: "This site includes leg, chest, back, shoulder, home workout, and leg curl machine guides." },
  { q: "Are these workout guides suitable for beginners?", a: "Yes. The guides include beginner-friendly options, form tips, and safer progression advice." },
  { q: "Do I need a gym for these workouts?", a: "No. Home workout and bodyweight options are included, while gym guides explain machines and equipment when needed." },
];
---

<ContentLayout
  title="Workouts — Free Exercise Guides and Workout Routines"
  h1="Workouts"
  description="Free workout guides for legs, chest, back, shoulders, home training, and leg curl machines with routines, form tips, FAQs, and safe progression advice."
  path="/workouts/"
  lead="Explore free workout guides designed to help you train smarter, move better, and build strength safely."
  faqs={faqs}
>
  <TopicCategoryGrid title="Choose a workout guide" categories={categories} />

  <h2>How to use these workout guides</h2>
  <p>Start with the guide that matches your goal and equipment. If you are new to training, begin with lower volume, lighter resistance, and controlled reps. If you already train, use the guides to add variety, improve form, or fill gaps in your program.</p>

  <h2>Training safely</h2>
  <p>Warm up before hard sets, progress gradually, and avoid pushing through sharp pain. Use these guides for education only and consult a qualified professional for injuries or medical conditions.</p>
</ContentLayout>
