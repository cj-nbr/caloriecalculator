---
import ContentLayout from "../../layouts/ContentLayout.astro";
import TopicCategoryGrid from "../../components/workouts/TopicCategoryGrid.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";

const categories = [
  { title: "Leg Workouts", href: "/workouts/leg-workouts/", description: "Beginner routines, gym exercises, hamstring guidance, and leg day mistakes." },
  { title: "Lying Leg Raises", href: "/workouts/lying-leg-raises/", description: "Core exercise guide for lower abs, hip flexors, and pelvic control." },
  { title: "Chest Workouts", href: "/workouts/chest-workouts/", description: "Push-up, press, flye, and chest training guidance." },
  { title: "Back Workouts", href: "/workouts/back-workouts/", description: "Rows, pulldowns, pull-ups, posture, and pulling strength." },
  { title: "Shoulder Workouts", href: "/workouts/shoulder-workouts/", description: "Presses, raises, face pulls, and shoulder stability work." },
  { title: "Home Workouts", href: "/workouts/home-workouts/", description: "No-equipment routines for strength, cardio, and mobility." },
  { title: "All In One Exercise", href: "/workouts/all-in-one-exercise/", description: "Full body bodyweight exercises, daily routines, and home gym equipment guides." },
  { title: "Leg Curl Machine", href: "/workouts/leg-curl-machine/", description: "Complete leg curl machine guide with setup, muscles worked, benefits, alternatives, and mistakes." },
  { title: "Leg Extension Machine", href: "/workouts/leg-curl-machine/leg-extension-machine/", description: "Quad machine setup, muscles worked, and how it differs from leg curls." },
  { title: "Leg Curl Extension Machine", href: "/workouts/leg-curl-machine/leg-curl-extension-machine/", description: "Combo hamstring and quad machine guidance." },
];

const faqs = [
  { q: "What workout pages are available?", a: "This site includes leg, chest, back, shoulder, home workout, leg curl machine, leg extension machine, leg curl extension machine, prone leg curl, lying hamstring curl, and lying leg raises guides." },
  { q: "Are these workout guides suitable for beginners?", a: "Yes. The guides include beginner-friendly options, form tips, and safer progression advice." },
  { q: "Do I need a gym for these workouts?", a: "No. Home workout and bodyweight options are included, while gym guides explain machines and equipment when needed." },
  { q: "Which workout guide should I start with?", a: "Start with the guide that matches your goal: legs, chest, back, shoulders, home training, leg curl machines, leg extension machines, or lying leg raises." },
];
---

<ContentLayout
  title="Workouts — Free Exercise Guides, Workout Routines, Leg Curl Machine, Leg Extension Machine, and Lying Leg Raises"
  h1="Workouts"
  description="Free workout guides for legs, chest, back, shoulders, home training, leg curl machines, leg extension machines, prone leg curls, lying hamstring curls, and lying leg raises with routines, form tips, FAQs, internal links, and safe progression advice."
  path="/workouts/"
  lead="Explore free workout guides designed to help you train smarter, move better, and build strength safely."
  faqs={faqs}
>
  <ArticleImage src="/assets/images/articles/workout-routine.svg" alt="Illustration of a weekly workout routine split covering all major muscle groups." />

  <TopicCategoryGrid title="Choose a workout guide" categories={categories} />

  <section class="card border-brand/20 p-5 sm:p-6">
    <h2 class="text-display-sm text-ink">Quick workout planning facts</h2>
    <ul class="mt-3 grid gap-3 text-body md:grid-cols-3">
      <li class="rounded-xl bg-canvas-soft p-4"><span class="block text-sm font-semibold text-brand">Fact</span><span class="mt-1 block">Balanced training usually includes pushing, pulling, legs, core, and mobility.</span></li>
      <li class="rounded-xl bg-canvas-soft p-4"><span class="block text-sm font-semibold text-brand">Fact</span><span class="mt-1 block">Beginners often progress faster by improving form before adding weight.</span></li>
      <li class="rounded-xl bg-canvas-soft p-4"><span class="block text-sm font-semibold text-brand">Fact</span><span class="mt-1 block">Consistent recovery matters as much as the workout itself.</span></li>
    </ul>
  </section>

  <h2>How to use these workout guides</h2>
  <p>Start with the guide that matches your goal and equipment. If you are new to training, begin with lower volume, lighter resistance, and controlled reps. If you already train, use the guides to add variety, improve form, or fill gaps in your program.</p>
  <p>For balanced training, combine lower-body, upper-body, and home workout pages. For example, pair <a href="/workouts/leg-workouts/" class="text-brand underline">leg workouts</a> with <a href="/workouts/chest-workouts/" class="text-brand underline">chest workouts</a>, <a href="/workouts/back-workouts/" class="text-brand underline">back workouts</a>, and <a href="/workouts/shoulder-workouts/" class="text-brand underline">shoulder workouts</a>.</p>

  <h2>Workout guide categories</h2>
  <ul>
    <li><strong>Leg workouts:</strong> routines for quads, hamstrings, glutes, calves, and leg curl machines.</li>
    <li><strong>Chest workouts:</strong> push-ups, presses, flyes, dips, and upper-body pushing strength.</li>
    <li><strong>Back workouts:</strong> rows, pulldowns, pull-ups, posture, and pulling strength.</li>
    <li><strong>Shoulder workouts:</strong> presses, raises, rear delt work, face pulls, and shoulder stability.</li>
    <li><strong>Home workouts:</strong> bodyweight routines, no-equipment exercises, and simple progression.</li>
    <li><strong>Leg curl machine:</strong> setup, muscles worked, benefits, alternatives, common mistakes, and hamstring training.</li>
  </ul>

  <h2>Training safely</h2>
  <p>Warm up before hard sets, progress gradually, and avoid pushing through sharp pain. Use these guides for education only and consult a qualified professional for injuries or medical conditions.</p>

  <h2>Fitness calculators</h2>
  <p>Pair your workout plan with these free fitness calculators to track strength, intensity, and body composition.</p>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <a href="/one-rep-max-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">One Rep Max Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Estimate your 1RM for squat, bench press, deadlift, and other lifts using the Epley formula.</p>
    </a>
    <a href="/target-heart-rate-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Target Heart Rate Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Find your ideal heart rate zones for fat loss, cardio, and performance using the Karvonen method.</p>
    </a>
    <a href="/army-body-fat-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Army Body Fat Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Estimate your body fat percentage using the U.S. Army circumference method.</p>
    </a>
    <a href="/healthy-weight-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Healthy Weight Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Find your healthy weight range based on height and BMI.</p>
    </a>
    <a href="/maintenance-calories-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Maintenance Calories Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Calculate your daily maintenance calories (TDEE) for your current activity level.</p>
    </a>
    <a href="/cycling-calories-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Cycling Calories Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Estimate calories burned cycling at different speeds and intensities.</p>
    </a>
    <a href="/swimming-calories-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Swimming Calories Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Estimate calories burned swimming laps or doing water workouts.</p>
    </a>
    <a href="/intermittent-fasting-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Intermittent Fasting Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Plan your fasting and eating windows for intermittent fasting protocols.</p>
    </a>
    <a href="/meal-calorie-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Meal Calorie Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Split your daily calorie target across meals and snacks.</p>
    </a>
    <a href="/recipe-calorie-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Recipe Calorie Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Estimate total and per-serving calories for your homemade recipes.</p>
    </a>
    <a href="/weight-gain-calculator/" class="card group p-5 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
      <h2 class="text-base font-semibold text-ink group-hover:text-brand">Weight Gain Calculator</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">Plan a healthy calorie surplus and timeline for weight gain.</p>
    </a>
  </div>
</ContentLayout>
