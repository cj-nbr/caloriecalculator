---
import ContentLayout from "../../../layouts/ContentLayout.astro";
import LegCurlArticle from "../../../components/workouts/LegCurlArticle.astro";
import { LEG_CURL_TOPICS } from "../../../data/leg-curl-topics";

const topic = LEG_CURL_TOPICS.find((item) => item.slug === "leg-curl-machine-muscles-worked")!;
---

<ContentLayout
  title={`${topic.title} — Calorie Calculator Free`}
  h1={topic.title}
  description={topic.description}
  path={topic.path}
  category="Leg Workouts"
  categoryPath="/workouts/leg-workouts/"
  updated="June 2026"
  lead={topic.summary}
  faqs={topic.faqs}
>
  <LegCurlArticle topic={topic} />
</ContentLayout>
