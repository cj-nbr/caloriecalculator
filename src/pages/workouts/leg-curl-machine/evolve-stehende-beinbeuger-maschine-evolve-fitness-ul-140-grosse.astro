---
import ContentLayout from "../../../layouts/ContentLayout.astro";
import ExerciseArticle from "../../../components/workouts/ExerciseArticle.astro";
import { RELATED_EXERCISE_TOPICS } from "../../../data/workout-topics";

const topic = RELATED_EXERCISE_TOPICS.find((item) => item.slug === "evolve-stehende-beinbeuger-maschine-evolve-fitness-ul-140-grosse")!;
---

<ContentLayout
  title={`${topic.title} — Evolve Fitness UL-140 Standing Leg Curl Guide`}
  h1={topic.title}
  description={topic.description}
  path={topic.path}
  category="Leg Workouts"
  categoryPath="/workouts/leg-workouts/"
  updated="June 2026"
  lead={topic.summary}
  faqs={topic.faqs}
>
  <ExerciseArticle topic={topic} />
</ContentLayout>
