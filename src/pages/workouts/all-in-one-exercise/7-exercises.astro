const path = "/workouts/all-in-one-exercise/7-exercises/";
const faqs = [
  { q: "What are the 7 best exercises to do every day?", a: "March in place, squats, push-ups, glute bridges, planks, lunges, and jumping jacks provide complete full-body daily activation." },
  { q: "Can daily bodyweight exercise help with weight loss?", a: "Yes, consistent daily movement increases metabolism, improves insulin sensitivity, and builds lean muscle when paired with proper nutrition." },
  { q: "How long should daily 7-exercise routines take?", a: "10-15 minutes daily provides benefits without overtraining. Quality matters more than quantity." },
  { q: "What if I miss a day of daily exercises?", a: "Missed days are normal. Resume the next day — consistency over months matters more than perfect daily streaks." },
  { q: "Should I eat before daily exercises?", a: "Light snacks are fine. For morning routines, you can exercise before eating. Post-workout nutrition aids recovery." },
];
