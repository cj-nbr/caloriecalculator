<ContentLayout
  title="7 Exercises To Do Every Day: Simple Daily Fitness Routine"
  h1="7 Exercises To Do Every Day"
  description="Seven simple bodyweight exercises you can do daily for full-body fitness. No equipment required. Build strength, mobility, and energy in just 10-15 minutes."
  path={path}
  category="Workouts"
  categoryPath="/workouts/"
