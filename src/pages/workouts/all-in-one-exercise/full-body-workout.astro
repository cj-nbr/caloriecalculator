---
import ContentLayout from "../../../layouts/ContentLayout.astro";

const path = "/workouts/all-in-one-exercise/full-body-workout/";
const faqs = [
  { q: "What is the best full body workout at home without equipment?", a: "A circuit of burpees, push-ups, squats, mountain climbers, and planks performed with minimal rest provides maximum full-body engagement." },
  { q: "How many calories can I burn in a home full body workout?", a: "A 150-pound person can burn 150-200 calories in 15-20 minutes of continuous bodyweight circuits." },
  { q: "Do I need a lot of space for home full body workouts?", a: "No. All exercises require only 6x6 feet of clear space. A living room, bedroom, or basement works fine." },
  { q: "How long should a full body home workout last?", a: "15-20 minutes of continuous movement provides excellent results for beginners. Intermediate trainees can extend to 25-30 minutes." },
  { q: "Can I build muscle with home workouts?", a: "Yes, through progressive overload—increasing reps, sets, time under tension, or reducing rest periods as you improve." },
];
---

<ContentLayout
  title="Full Body Workout At Home Without Equipment: Complete Routine"
  h1="Full Body Workout At Home Without Equipment"
  description="No equipment required. Follow our complete full body workout routines designed for home training. Burn calories, build strength, and achieve fitness using only your body weight."
  path={path}
  category="Workouts"
  categoryPath="/workouts/"
  faqs={faqs}
>

  <h2>Why Bodyweight Full Body Workouts Work</h2>
  <p>Bodyweight training eliminates barriers to exercise. No gym membership, no expensive equipment, no commute. Your body provides all the resistance needed for effective full-body conditioning when you use proper technique and progressive principles.</p>

  <div class="not-prose">
    <div class="card my-6 bg-brand/5 p-5">
      <strong class="text-ink">Quick Stats:</strong>
      <ul class="mt-2 text-sm text-body">
        <li>No equipment needed</li>
        <li>Small space requirement (6x6 feet)</li>
        <li>Effective for all fitness levels</li>
        <li>Calories burned: 8-12 per minute</li>
      </ul>
    </div>
  </div>

  <h2>Core Principles for Home Full Body Workouts</h2>
  <ul>
    <li><strong>Compound movements:</strong> Squats, push-ups, burpees engage multiple muscles</li>
    <li><strong>Continuous tension:</strong> Slow reps increase difficulty without weight</li>
    <li><strong>Minimal rest:</strong> Keep heart rate elevated for cardio benefits</li>
    <li><strong>Progressive overload:</strong> More reps, less rest, better form over time</li>
  </ul>

  <h2>Complete Full Body Routines</h2>

  <h3>Beginner Routine (10-15 minutes)</h3>
  <table>
    <thead>
      <tr>
        <th>Exercise</th>
        <th>Duration</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Marching in place</td>
        <td>1 minute</td>
        <td>Warm-up</td>
      </tr>
      <tr>
        <td>Incline push-ups</td>
        <td>30 seconds</td>
        <td>Use wall if needed</td>
      </tr>
      <tr>
        <td>Bodyweight squats</td>
        <td>30 seconds</td>
        <td>To chair for depth</td>
      </tr>
      <tr>
        <td>Glute bridges</td>
        <td>30 seconds</td>
        <td>Squeeze at top</td>
      </tr>
      <tr>
        <td>Knee plank</td>
        <td>20 seconds</td>
        <td>Maintain straight line</td>
      </tr>
      <tr>
        <td>Step jacks</td>
        <td>30 seconds</td>
        <td>Low-impact cardio</td>
      </tr>
    </tbody>
  </table>

  <h3>Intermediate Routine (15-20 minutes)</h3>
  <table>
    <thead>
      <tr>
        <th>Exercise</th>
        <th>Duration</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Jumping jacks or step jacks</td>
        <td>1 minute</td>
        <td>Warm-up</td>
      </tr>
      <tr>
        <td>Push-ups (standard or knee)</td>
        <td>45 seconds</td>
        <td>Maintain form</td>
      </tr>
      <tr>
        <td>Squats</td>
        <td>45 seconds</td>
        <td>Full depth</td>
      </tr>
      <tr>
        <td>Mountain climbers</td>
        <td>45 seconds</td>
        <td>Controlled pace</td>
      </tr>
      <tr>
        <td>Lunges</td>
        <td>45 seconds</td>
        <td>Alternating legs</td>
      </tr>
      <tr>
        <td>Plank</td>
        <td>45 seconds</td>
        <td>Full plank if possible</td>
      </tr>
      <tr>
        <td>Burpees (modified)</td>
        <td>30 seconds</td>
        <td>Step back, not jump</td>
      </tr>
    </tbody>
  </table>

  <h3>Advanced Routine (20-25 minutes)</h3>
  <table>
    <thead>
      <tr>
        <th>Exercise</th>
        <th>Duration</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Burpees</td>
        <td>1 minute</td>
        <td>Full intensity</td>
      </tr>
      <tr>
        <td>Push-ups</td>
        <td>1 minute</td>
        <td>Standard or variation</td>
      </tr>
      <tr>
        <td>Jump squats</td>
        <td>1 minute</td>
        <td>Land softly</td>
      </tr>
      <tr>
