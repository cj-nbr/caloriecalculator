---
import MedicalNote from "../../components/ui/MedicalNote.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ArticleImage from "../../components/ui/ArticleImage.astro";
import ExerciseArticle from "../../components/workouts/ExerciseArticle.astro";
import { RELATED_EXERCISE_TOPICS } from "../../data/workout-topics";

const topic = RELATED_EXERCISE_TOPICS.find((item) => item.slug === "lying-leg-raises")!;
---

<ContentLayout
  title={`${topic.title} — How to Do, Muscles Worked, Mistakes, and FAQ`}
  h1={topic.title}
  description={topic.description}
  path={topic.path}
  category="Workouts"
  categoryPath="/workouts/"
  updated="June 2026"
  lead={topic.summary}
  faqs={topic.faqs}
>

  <MedicalNote />

  <ExerciseArticle topic={topic} />
</ContentLayout>
