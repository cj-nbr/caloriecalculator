---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";

const faqs: FaqItem[] = [
  { q: "What is a TDEE calculator for weight loss?", a: "A TDEE calculator for weight loss finds your maintenance calories, then shows how many calories to eat daily for fat loss. It uses your BMR and activity level." },
  { q: "How accurate is a TDEE calculator for weight loss?", a: "Most TDEE calculators are accurate within 10-15% for the average person. Track your weight for 2-3 weeks and adjust by 100-200 calories if needed." },
  { q: "What calorie deficit should I use for weight loss?", a: "A 500-calorie daily deficit produces about 1 pound of weight loss per week. This is the standard recommendation for sustainable fat loss." },
  { q: "How often should I recalculate my TDEE for weight loss?", a: "Recalculate every 4-6 weeks or when you lose 5-10 lbs. Your metabolism slows as you lose weight, requiring adjustments." },
  { q: "Should I use TDEE or BMR for weight loss?", a: "Use TDEE (not BMR). BMR only covers resting calories. TDEE includes all daily activity, giving you the true maintenance number." },
  { q: "Can I eat more on workout days using TDEE?", a: "Yes. On days you exercise, you naturally burn more calories. Our activity levels account for this - choose appropriately for your routine." },
  { q: "What happens if I eat above my TDEE calculator result?", a: "Eating above your TDEE creates a surplus, causing weight gain. For weight loss, stay below your calculated TDEE by your chosen deficit amount." },
  { q: "Why am I not losing weight with my TDEE calculator result?", a: "Common causes: underreporting food intake, overestimating activity, metabolic adaptation, or needing to recalculate as weight drops." },
  { q: "How does exercise affect my TDEE calculator for weight loss?", a: "Exercise increases your activity level multiplier. Each workout burns 200-600 calories depending on intensity and duration. Choose the right activity level above." },
  { q: "Is TDEE calculator better than a regular calorie calculator?", a: "A TDEE calculator specifically finds maintenance calories. Our main calorie calculator combines TDEE with goal selection and macros in one step." },
];
---

<CalculatorLayout
  title="TDEE Calculator for Weight Loss — Find Your Fat Loss Calories"
  h1="TDEE Calculator for Weight Loss"
  description="Free TDEE calculator for weight loss. Find your exact calorie target for fat loss. Calculate maintenance calories and deficit."
  intro="Calculate your TDEE for weight loss and get your daily calorie target to lose fat sustainably."
  path="/tdee-calculator-for-weight-loss/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" aria-pressed="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" aria-pressed="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5"><label for="age" class="block text-sm font-medium text-ink">Age</label><input id="age" type="number" min="15" max="100" value="30" class={inputCls} /></div>
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="weight-unit text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" min="20" step="0.1" value="70" class={inputCls} /></div>
      </div>
      <div class="mb-4">
        <label class="mb-1.5 block text-sm font-medium text-ink">Height <span class="height-unit text-mute">(cm)</span></label>
        <div id="height-metric"><input id="height-cm" type="number" min="100" max="250" value="175" class={inputCls} /></div>
        <div id="height-imperial" class="hidden grid-cols-2 gap-3">
          <div class="relative"><input id="height-ft" type="number" min="3" max="8" value="5" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">ft</span></div>
          <div class="relative"><input id="height-in" type="number" min="0" max="11" value="9" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">in</span></div>
        </div>
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="activity" class="block text-sm font-medium text-ink">Activity level</label>
        <div class="relative">
          <select id="activity" class={selectCls}>
            <option value="sedentary">Sedentary — little or no exercise</option>
            <option value="light">Lightly active — 1–3 days/week</option>
            <option value="moderate" selected>Moderately active — 3–5 days/week</option>
            <option value="active">Very active — 6–7 days/week</option>
            <option value="athlete">Extra active — hard exercise + job</option>
          </select>
          <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </div>
      </div>
      <button type="submit" class="inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate for Weight Loss</button>
    </form>

    <div class="space-y-5">
      <div class="card p-6 sm:p-8 text-center">
        <p class="text-sm text-mute">Your TDEE (maintenance)</p>
        <p class="mt-1"><span id="tdee-value" class="text-display-xl text-ink tabular-nums">2,556</span> <span class="text-lg text-mute">kcal/day</span></p>
        <p class="mt-2 text-sm text-body">Eat this to maintain current weight.</p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Your weight loss targets</h2></div>
        <table class="w-full text-sm">
          <tbody id="loss-table">
            <tr class="border-b border-hairline last:border-0 bg-brand/5">
              <td class="px-5 py-2.5 font-medium text-ink">Gentle loss<span class="block text-xs text-mute">~0.25 kg / 0.5 lb weekly</span></td>
              <td id="loss-250" class="px-5 py-2.5 text-right font-medium tabular-nums text-ink">2,300 kcal</td>
            </tr>
            <tr class="border-b border-hairline last:border-0">
              <td class="px-5 py-2.5 text-body">Standard loss<span class="block text-xs text-mute">~0.5 kg / 1 lb weekly</span></td>
              <td id="loss-500" class="px-5 py-2.5 text-right font-medium tabular-nums text-body">2,050 kcal</td>
            </tr>
            <tr>
              <td class="px-5 py-2.5 text-body">Aggressive loss<span class="block text-xs text-mute">~1 kg / 2 lb weekly</span></td>
              <td id="loss-750" class="px-5 py-2.5 text-right font-medium tabular-nums text-body">1,800 kcal</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <h2>How TDEE Works for Weight Loss</h2>
    <p>Your Total Daily Energy Expenditure (TDEE) is the calories you burn in 24 hours including exercise. It is your maintenance number. For weight loss, eat below this amount to create a deficit.</p>

    <h2>Using This TDEE Calculator for Weight Loss</h2>
    <p>Step 1: Enter your stats above to find TDEE (maintenance calories). Step 2: Subtract 250-500 for a safe deficit. Step 3: Track your intake against this target. Step 4: Adjust as weight drops.</p>

    <p>Our calculator shows three deficit options. Most people succeed with a 500-calorie deficit, losing about 1 lb per week.</p>

    <h2>Tools to Maximize Weight Loss Results</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/calorie-deficit-calculator/">Calorie Deficit Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Calculate precise deficit targets.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/macro-calculator/">Macro Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Get protein/carb/fat split for fat loss.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/protein-calculator/">Protein Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Preserve muscle on a calorie deficit.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/workouts/home-workouts/">Home Workouts</a></h3>
        <p class="mt-1 text-sm text-body">Burn extra calories without equipment.</p>
      </div>
    </div>

    <h2>Recommended Reading</h2>
    <ul>
      <li><a href="/guides/calorie-deficit-guide/">Calorie Deficit Guide</a> — Complete guide to deficit dieting</li>
      <li><a href="/weight-loss-calculator/">Weight Loss Calculator</a> — Timeline and goal planning</li>
      <li><a href="/guides/weight-loss-guide/">Weight Loss Guide</a> — Step-by-step plan</li>
    </ul>
  </Fragment>
</CalculatorLayout>

<script>
  import { bmrMifflinStJeor, tdee, type Sex, type ActivityKey } from "../lib/calculations";
  import { lbToKg, ftInToCm } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    let unit: "metric" | "imperial" = "metric";

    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as Sex;
      const age = parseFloat(($("age") as HTMLInputElement).value) || 0;
      const activity = ($("activity") as HTMLSelectElement).value as ActivityKey;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      let h: number;
      if (unit === "imperial") { w = lbToKg(w); h = ftInToCm(parseFloat(($("height-ft") as HTMLInputElement).value) || 0, parseFloat(($("height-in") as HTMLInputElement).value) || 0); }
      else h = parseFloat(($("height-cm") as HTMLInputElement).value) || 0;
      return { sex, age, activity, w, h };
    }

    function render() {
      const { sex, age, activity, w, h } = read();
      if (w <= 0 || h <= 0 || age <= 0) return;
      const t = tdee(bmrMifflinStJeor(sex, age, h, w), activity);
      $("tdee-value").textContent = fmt(t);
      $("loss-250").textContent = fmt(t - 250);
      $("loss-500").textContent = fmt(t - 500);
      $("loss-750").textContent = fmt(t - 750);
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        $("height-metric").classList.toggle("hidden", unit === "imperial");
        $("height-imperial").classList.toggle("hidden", unit === "metric");
        $("height-imperial").classList.toggle("grid", unit === "imperial");
        document.querySelectorAll(".weight-unit").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        document.querySelectorAll(".height-unit").forEach((e) => (e.textContent = unit === "metric" ? "(cm)" : "(ft / in)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
      });
    });
    ($("calc-form") as HTMLFormElement).addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
