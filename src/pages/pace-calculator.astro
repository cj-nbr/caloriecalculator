---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import ArticleImage from "../components/ui/ArticleImage.astro";
import Sources from "../components/ui/Sources.astro";

const faqs: FaqItem[] = [
  { q: "How do I calculate running pace?", a: "Pace = Time / Distance. Run 5km in 25 minutes = 5 min/km pace. Enter distance and time in our calculator." },
  { q: "What is a good running pace?", a: "For beginners: 8-10 min/km. Intermediate: 6-8 min/km. Advanced: 4-6 min/km. Walking: 12-16 min/km." },
  { q: "How do I convert pace to speed?", a: "Speed (km/h) = 60 / pace (min/km). A 5 min/km pace = 12 km/h." },
  { q: "How to calculate marathon pace?", a: "Marathon pace = total time / 26.2 miles. A 4-hour marathon = 9.15 min/mile pace." },
  { q: "What is the difference between pace and speed?", a: "Pace is minutes per kilometer/mile (slower = better in running). Speed is kilometers/miles per hour (faster = better)." },
  { q: "How do I improve my running pace?", a: "Consistent training, interval workouts, strength training, and proper pacing strategy. Aim for 5-10% pace improvement every 4-6 weeks." },
  { q: "What is a good walking pace?", a: "Brisk walking is typically 4–5 km/h (12–15 min/km). Power walking can reach 6 km/h (10 min/km). Walking pace improves with consistency and posture." },
  { q: "How can I use pace for training?", a: "Use pace targets to structure intervals or steady sessions. A tempo run at your half-marathon pace builds lactate threshold, while easy runs stay slower. Track progress with a watch or app." },
  { q: "What affects my pace?", a: "Terrain, weather, footwear, fatigue, and pacing strategy all affect pace. A flat track is faster than a hilly trail. Use the calculator to set realistic targets for your conditions." },
];
---

<CalculatorLayout
  title="Pace Calculator — Running, Walking & Cycling Pace (Min/Mile)"
  h1="Pace Calculator"
  description="Calculate your pace in minutes per mile or kilometer for running, walking, and cycling. Find speed from distance and time."
  intro="Calculate your pace in min/mile or min/km. Enter distance and time to find your average pace and speed."
  path="/pace-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled for a 5km run.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" aria-pressed="true">Metric (km)</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" aria-pressed="false">Imperial (mi)</button>
      </div>
      <div class="mb-4 space-y-1.5">
        <label for="distance" class="block text-sm font-medium text-ink">Distance <span class="dist-unit text-mute">(km)</span></label>
        <input id="distance" type="number" inputmode="decimal" min="0.1" step="0.1" value="5" class={inputCls} />
      </div>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5"><label for="hours" class="block text-sm font-medium text-ink">Hours</label><input id="hours" type="number" min="0" step="1" value="0" class={inputCls} /></div>
        <div class="space-y-1.5"><label for="minutes" class="block text-sm font-medium text-ink">Minutes</label><input id="minutes" type="number" min="0" step="1" value="25" class={inputCls} /></div>
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="seconds" class="block text-sm font-medium text-ink">Seconds</label>
        <input id="seconds" type="number" min="0" max="59" step="1" value="0" class={inputCls} />
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Pace</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Your Average Pace</p>
        <p class="mt-1"><span id="pace-value" class="text-display-xl text-ink tabular-nums">5:00</span> <span class="text-lg text-mute">min/km</span></p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Speed</p><p id="speed-kmh" class="mt-1 text-display-sm text-ink tabular-nums">12.0 km/h</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Pace (min/mile)</p><p id="pace-mile" class="mt-1 text-display-sm text-ink tabular-nums">8:02</p></div>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/running-pace.svg" alt="Illustration of a running shoe and pace marker showing minutes per kilometer or mile." />

    <h2>How pace calculators work</h2>
    <p>A pace calculator divides total time by distance to give you minutes per kilometre or mile. It is useful for runners, walkers, and cyclists who think in time-per-distance rather than speed. This tool converts both ways so you can compare effort across activities.</p>

    <h2>Pace vs speed explained</h2>
    <p>Pace is minutes per unit of distance; speed is distance per unit of time. They are inverses:</p>
    <p><code>Speed (km/h) = 60 / pace (min/km)</code></p>
    <p>A 5:00 min/km pace equals 12 km/h. Runners prefer pace because it maps directly to training effort. Cyclists often prefer km/h because they travel faster and time-per-distance is less intuitive.</p>

    <h2>How to use pace for training</h2>
    <p>Use pace to set intensity targets:</p>
    <ul>
      <li><strong>Easy run:</strong> 60–70% of max HR or conversational pace</li>
      <li><strong>Tempo:</strong> Sustain a pace you could hold for about an hour</li>
      <li><strong>Intervals:</strong> Faster pace for shorter reps (e.g. 400m repeats)</li>
    </ul>

    <h2>Running, walking, and cycling pace</h2>
    <table>
      <thead><tr><th>Activity</th><th>Easy pace</th><th>Moderate</th><th>Fast</th></tr></thead>
      <tbody>
        <tr><td>Walking</td><td>15–18 min/km</td><td>12–14 min/km</td><td>10–11 min/km</td></tr>
        <tr><td>Running</td><td>6–8 min/km</td><td>5–6 min/km</td><td>4–5 min/km</td></tr>
        <tr><td>Cycling</td><td>15–20 km/h</td><td>20–25 km/h</td><td>25–30 km/h</td></tr>
      </tbody>
    </table>

    <h2>How to calculate calories burned from pace</h2>
    <p>Pace alone does not give calories, but combined with body weight and duration it helps you estimate burn. Use the <a href="/running-calorie-calculator/">running calorie calculator</a> or <a href="/walking-calorie-calculator/">walking calorie calculator</a> to turn pace into energy expenditure. For cycling, the <a href="/cycling-calories-calculator/">cycling calories calculator</a> uses speed and weight.</p>

    <h2>Common pace mistakes</h2>
    <ul>
      <li><strong>Starting too fast:</strong> A fast first mile often leads to a slower finish. Negative splits are more efficient.</li>
      <li><strong>Ignoring terrain:</strong> Hills, wind, and surface all change pace. Adjust expectations for trails or headwinds.</li>
      <li><strong>Chasing a number:</strong> Pace varies with fitness, sleep, and weather. Use it as a guide, not a verdict.</li>
    </ul>

    <h2>Related calculators</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/walking-calorie-calculator/">Walking Calorie Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Combine pace with calories burned for walks.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/running-calorie-calculator/">Running Calorie Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Track calories burned by pace and distance.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/cycling-calories-calculator/">Cycling Calories Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Estimate calories burned by cycling speed.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/calories-burned-calculator/">Calories Burned Calculator</a></h3>
        <p class="mt-1 text-sm text-body">General calculator for 15+ activities.</p>
      </div>
    </div>

    <Sources sources={[
      { label: "Sports Science — Pace and Speed Conversion", href: "https://www.sportscience.net/" },
      { label: "CDC — Physical Activity Guidelines", href: "https://www.cdc.gov/physicalactivity/basics/index.htm" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    let unit: "metric" | "imperial" = "metric";

    function fmtPace(min: number): string {
      const m = Math.floor(min);
      const s = Math.round((min - m) * 60);
      return `${m}:${s.toString().padStart(2, "0")}`;
    }

    function render() {
      clearDirty();
      const distKm = parseFloat(($("distance") as HTMLInputElement).value) || 0;
      const hrs = parseFloat(($("hours") as HTMLInputElement).value) || 0;
      const mins = parseFloat(($("minutes") as HTMLInputElement).value) || 0;
      const secs = parseFloat(($("seconds") as HTMLInputElement).value) || 0;
      const totalHours = hrs + mins / 60 + secs / 3600;
      if (distKm <= 0 || totalHours <= 0) return;

      const paceMinPerKm = totalHours * 60 / distKm;
      const speedKmh = distKm / totalHours;
      const paceMinPerMile = paceMinPerKm * 1.60934;
      const speedMph = speedKmh / 1.60934;

      $("pace-value").textContent = fmtPace(paceMinPerKm);
      $("speed-kmh").textContent = `${speedKmh.toFixed(1)} km/h`;
      $("pace-mile").textContent = fmtPace(paceMinPerMile);
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        const distInput = $("distance") as HTMLInputElement;
        const d = parseFloat(distInput.value) || 0;
        if (d > 0) {
          distInput.value = (unit === "imperial" ? d / 1.60934 : d * 1.60934).toFixed(2);
        }
        document.querySelectorAll(".dist-unit").forEach((e) => (e.textContent = unit === "metric" ? "(km)" : "(mi)"));
      });
    });
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
