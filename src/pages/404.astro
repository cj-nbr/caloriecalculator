---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { NAV } from "../data/site";
const calculators = NAV[0].children!.slice(0, 6);
---

<Layout
  title="Page Not Found — Calorie Calculator Free"
  description="The page you're looking for doesn't exist. Explore our free calorie and nutrition calculators instead."
  noindex={true}
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-gradient text-display-xl font-semibold">404</p>
    <h1 class="mt-2 text-display-md text-ink">Page not found</h1>
    <p class="mx-auto mt-3 max-w-md text-body">
      The page you're looking for doesn't exist or has moved. Try the calculator
      or pick a tool below.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <Button href="/" size="lg">Back to calculator</Button>
      <Button href="/guides/how-many-calories-should-i-eat/" variant="secondary" size="lg">Read the guides</Button>
    </div>
    <div class="mt-10 grid w-full max-w-2xl grid-cols-2 gap-3 sm:grid-cols-3">
      {
        calculators.map((c) => (
          <a href={c.href} class="card p-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft">{c.label}</a>
        ))
      }
    </div>
  </section>
</Layout>
