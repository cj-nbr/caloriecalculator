---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import Sources from "../components/ui/Sources.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";
import ExpertTake from "../components/ui/ExpertTake.astro";

const faqs: FaqItem[] = [
  { q: "What is TDEE?", a: "Total Daily Energy Expenditure is the total number of calories you burn in a full day, including your resting metabolism (BMR) plus all movement, exercise, and digestion. It's the key number for managing your weight." },
  { q: "How is TDEE calculated?", a: "TDEE is your BMR multiplied by an activity factor between 1.2 (sedentary) and 1.9 (extra active). This calculator finds your BMR with the Mifflin-St Jeor equation and applies the multiplier you select." },
  { q: "How do I use my TDEE?", a: "Eat at your TDEE to maintain weight, below it to lose weight, and above it to gain. A 500-calorie daily deficit produces about 1 pound of weight loss per week." },
  { q: "Why is my TDEE higher than my BMR?", a: "Your BMR only covers resting functions. TDEE adds the energy you spend moving, exercising, and digesting food, so it is always higher — often by 20–90% depending on activity." },
  { q: "What activity level should I choose?", a: "Most people should select 'Light' or 'Moderate'. Only choose 'Extra active' if you have a physically demanding job AND exercise daily." },
  { q: "How often should I recalculate my TDEE?", a: "Recalculate every 4-6 weeks or when your weight changes by more than 5% since your last calculation." },
  { q: "Does muscle building increase TDEE?", a: "Yes. Each pound of muscle burns roughly 6-10 calories daily at rest, and strength training itself burns 200-400 calories per session." },
  { q: "What's the difference between TDEE and BMR?", a: "BMR is calories burned at complete rest. TDEE includes all daily activity — typically BMR × 1.3-1.9 depending on your lifestyle." },
  { q: "Can TDEE change with age?", a: "Yes. BMR decreases 2-3% per decade after age 30. Less activity with age also reduces overall TDEE." },
  { q: "How accurate is this TDEE calculator?", a: "Accuracy is within ±10% for most people. Individual variation exists based on genetics, muscle mass, and non-exercise activity." },
];
---

<CalculatorLayout
  title="Accurate TDEE Calculator | Find Your Total Daily Energy Expenditure"
  h1="TDEE Calculator"
  description="Discover your Total Daily Energy Expenditure (TDEE) with our highly accurate calculator. Find out exactly how many calories you burn per day for weight loss, maintenance, or muscle gain."
  intro="Your Total Daily Energy Expenditure (TDEE) is the exact number of calories your body burns every day. Use our free, highly accurate TDEE calculator to find your maintenance calories so you can effectively plan your weight loss or bulking diet."
  path="/tdee-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" aria-pressed="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" aria-pressed="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="mb-4 grid grid-cols-2 gap-3">
        <div class="space-y-1.5"><label for="age" class="block text-sm font-medium text-ink">Age</label><input id="age" type="number" min="15" max="100" value="30" class={inputCls} /></div>
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="weight-unit text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" min="20" step="0.1" value="70" class={inputCls} /></div>
      </div>
      <div class="mb-4">
        <label class="mb-1.5 block text-sm font-medium text-ink">Height <span class="height-unit text-mute">(cm)</span></label>
        <div id="height-metric"><input id="height-cm" type="number" min="100" max="250" value="175" class={inputCls} /></div>
        <div id="height-imperial" class="hidden grid-cols-2 gap-3">
          <div class="relative"><input id="height-ft" type="number" min="3" max="8" value="5" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">ft</span></div>
          <div class="relative"><input id="height-in" type="number" min="0" max="11" value="9" class={inputCls} /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">in</span></div>
        </div>
      </div>
      <div class="mb-5 space-y-1.5">
        <label for="activity" class="block text-sm font-medium text-ink">Activity level</label>
        <div class="relative">
          <select id="activity" class={selectCls}>
            <option value="sedentary">Sedentary — little or no exercise</option>
            <option value="light">Lightly active — 1–3 days/week</option>
            <option value="moderate" selected>Moderately active — 3–5 days/week</option>
            <option value="active">Very active — 6–7 days/week</option>
            <option value="athlete">Extra active — hard exercise + job</option>
          </select>
          <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </div>
      </div>
      <button type="submit" class="inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate TDEE</button>
    </form>

    <div class="space-y-5">
      <div class="card p-6 sm:p-8 text-center">
        <p class="text-sm text-mute">Your Total Daily Energy Expenditure</p>
        <p class="mt-1"><span id="tdee-value" class="text-display-xl text-ink tabular-nums">2,556</span> <span class="text-lg text-mute">kcal/day</span></p>
        <p class="mt-2 text-sm text-body">Eat this much to maintain your current weight.</p>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Calorie targets by goal</h2></div>
        <table class="w-full text-sm"><tbody id="goals-table"></tbody></table>
      </div>
    </div>
  </div>

    <Fragment slot="content">
     <ArticleImage src="/assets/images/articles/energy-level.svg" alt="Illustration of activity level and energy expenditure, showing how movement increases daily calorie needs." />

     <h2>What is TDEE?</h2>
     <p>Total Daily Energy Expenditure — <strong>TDEE</strong> — is the total number of calories your body burns in a full day. It includes everything: your resting metabolism (BMR), the energy used to digest food, and all movement from walking to intense workouts. Knowing your TDEE is the single most useful number for managing your weight because it is your <strong>maintenance calorie</strong> baseline. Eat this amount and your weight stays stable; eat less and you lose; eat more and you gain.</p>

     <h2>The four components of TDEE</h2>
     <p>TDEE is not just one number pulled from thin air. It is the sum of four distinct components:</p>
     <ul>
       <li><strong>BMR (Basal Metabolic Rate) — ~60–70%:</strong> the calories your body burns at complete rest to keep you alive: breathing, circulation, cell repair, brain function, and temperature regulation. This is the largest component and largely determined by your lean body mass. Use the <a href="/bmr-calculator/">BMR calculator</a> to estimate yours.</li>
       <li><strong>NEAT (Non-Exercise Activity Thermogenesis) — ~15–30%:</strong> every movement that is not deliberate exercise. Walking to the car, fidgeting at your desk, doing laundry, standing while cooking — these daily activities vary wildly between people and can shift TDEE by hundreds of calories. People with physically active jobs often have much higher NEAT than desk workers.</li>
       <li><strong>TEF (Thermic Effect of Food) — ~10%:</strong> the energy your body spends digesting, absorbing, and processing nutrients. Protein has the highest thermic effect (20–30% of its calories are burned during digestion), while fat has the lowest (0–3%). This is why high-protein diets slightly increase daily calorie burn.</li>
       <li><strong>EAT (Exercise Activity Thermogenesis) — ~5–15%:</strong> the calories burned during deliberate exercise sessions: gym workouts, running, sports, or structured fitness classes. EAT matters, but for most people it is smaller than NEAT.</li>
     </ul>

     <h2>What affects your TDEE</h2>
     <p>Several factors shift your TDEE up or down over time:</p>
     <ul>
       <li><strong>Muscle mass:</strong> muscle is metabolically active tissue. Each pound of muscle burns roughly 6–10 calories daily at rest. More muscle means a higher BMR and a higher TDEE. Strength training is one of the best ways to boost long-term calorie burn.</li>
       <li><strong>Age:</strong> BMR decreases approximately 2–3% per decade after age 30, largely due to muscle loss and hormonal changes. TDEE also tends to fall because people become less active as they age.</li>
       <li><strong>Activity level:</strong> the most obvious lever. The activity multiplier ranges from 1.2 (sedentary) to 1.9 (extra active), and choosing the right one is critical. Most people overestimate their activity level.</li>
       <li><strong>Diet composition:</strong> high-protein diets increase TEF and preserve muscle during weight loss, helping maintain a higher TDEE. Very low-calorie diets can trigger metabolic adaptation, lowering BMR by 5–15%.</li>
       <li><strong>Body size:</strong> larger bodies burn more calories simply because there is more tissue to maintain. Height, weight, and body composition all play a role.</li>
     </ul>

     <ExpertTake quote="I constantly remind patients that TDEE is a moving target. As you lose weight, your body requires fewer calories to maintain itself, meaning your TDEE drops. This is why a calorie deficit that worked in month 1 might stop working in month 3. It's critical to recalculate your TDEE after every 10 lbs of weight loss to avoid plateauing." />

     <h2>TDEE vs maintenance calories</h2>
     <p>TDEE and maintenance calories mean the same thing. Your <strong>Total Daily Energy Expenditure</strong> is the amount of energy you burn in a day. When you eat that exact amount, your weight stays the same — that is maintenance. The terms are interchangeable, though TDEE is the more common technical term in research, while "maintenance calories" is more common in fitness and dieting conversations. Use the <a href="/guides/maintenance-calorie-calculator/">maintenance calorie calculator guide</a> for a deeper dive, or explore <a href="/guides/maintenance-calories/">maintenance calories explained</a> for practical tips on staying stable.</p>

     <h2>How to find your TDEE</h2>
     <p>There are two ways to find your TDEE: calculate it with a formula, or measure it with real-world data.</p>
     <h3>Method 1: Calculate with a formula (fast)</h3>
     <ol>
       <li>Calculate your BMR using the Mifflin-St Jeor equation: Men = 10 × weight(kg) + 6.25 × height(cm) − 5 × age + 5; Women = 10 × weight(kg) + 6.25 × height(cm) − 5 × age − 161.</li>
       <li>Multiply your BMR by an activity factor: 1.2 (sedentary), 1.375 (light), 1.55 (moderate), 1.725 (active), or 1.9 (athlete).</li>
       <li>That product is your estimated TDEE.</li>
     </ol>
     <p>The <a href="/tdee-calculator/">TDEE calculator</a> does this automatically. The <a href="/bmr-calculator/">BMR calculator</a> gives you the starting point if you only want the resting number.</p>
     <h3>Method 2: Track and adjust (more accurate)</h3>
     <ol>
       <li>Eat a consistent number of calories every day for 2–3 weeks.</li>
       <li>Weigh yourself daily under the same conditions (morning, after bathroom, before eating).</li>
       <li>If your weight is stable, your intake equals your TDEE.</li>
       <li>If you are gaining, subtract 100–200 calories from your target. If you are losing, add 100–200 calories.</li>
     </ol>
     <p>This empirical method is more accurate because it accounts for individual variation that formulas miss.</p>

     <h2>Common TDEE mistakes</h2>
     <p>Even experienced dieters and athletes make these errors:</p>
     <ul>
       <li><strong>Overestimating activity level:</strong> the #1 mistake. If you have a desk job and go to the gym three times a week, you are probably "lightly active," not "moderately active." Be conservative if unsure.</li>
       <li><strong>Forgetting NEAT:</strong> non-exercise movement can easily add 300–800 calories per day. People who fidget, stand, or walk a lot have higher TDEEs than their exercise schedule alone would suggest.</li>
       <li><strong>Not updating after weight change:</strong> as you lose or gain weight, your TDEE shifts. Recalculate every 4–5 kg (about 10 lb).</li>
       <li><strong>Using the wrong formula:</strong> Harris-Benedict (1919) overestimates BMR for modern populations. Mifflin-St Jeor (1990) is more accurate. Our <a href="/guides/bmr-equations/">BMR equations comparison</a> explains why.</li>
       <li><strong>Ignoring metabolic adaptation:</strong> long-term calorie deficits lower BMR through hormonal changes and muscle loss. This is why you should not run aggressive deficits for extended periods.</li>
     </ul>

     <h2>How to use TDEE for weight loss and gain</h2>
     <p>Once you have your TDEE, applying it is straightforward:</p>
     <ul>
       <li><strong>Weight loss:</strong> eat 300–500 calories below your TDEE. This produces a safe deficit of ~0.5–1 lb per week. For faster progress, use the <a href="/weight-loss-calculator/">weight loss calculator</a> to plan your timeline. Read the <a href="/guides/calorie-deficit-guide/">calorie deficit guide</a> for strategies to stay consistent.</li>
       <li><strong>Weight gain:</strong> eat 250–500 calories above your TDEE. This lean bulk approach adds mostly muscle when paired with resistance training. See the <a href="/guides/calorie-surplus-guide/">calorie surplus guide</a> for details.</li>
       <li><strong>Muscle building:</strong> combine a small surplus with the <a href="/macro-calculator/">macro calculator</a> to ensure you get enough protein (1.6–2.2 g per kg of body weight).</li>
       <li><strong>Maintenance:</strong> eat at your TDEE and adjust every few weeks as your body changes. The <a href="/calories-burned-calculator/">calories burned calculator</a> helps you understand how exercise impacts your daily total.</li>
     </ul>

     <h2>TDEE examples by activity level</h2>
     <table>
       <thead><tr><th>Profile</th><th>BMR</th><th>Sedentary (1.2)</th><th>Light (1.375)</th><th>Moderate (1.55)</th><th>Active (1.725)</th><th>Extra Active (1.9)</th></tr></thead>
       <tbody>
         <tr><td>Woman, 25, 165cm, 65kg</td><td>~1,400</td><td>1,680</td><td>1,925</td><td>2,170</td><td>2,415</td><td>2,660</td></tr>
         <tr><td>Man, 30, 180cm, 80kg</td><td>~1,820</td><td>2,184</td><td>2,503</td><td>2,821</td><td>3,139</td><td>3,458</td></tr>
         <tr><td>Woman, 40, 170cm, 75kg</td><td>~1,475</td><td>1,770</td><td>2,028</td><td>2,286</td><td>2,544</td><td>2,803</td></tr>
         <tr><td>Man, 20, 175cm, 70kg</td><td>~1,690</td><td>2,028</td><td>2,324</td><td>2,620</td><td>2,915</td><td>3,211</td></tr>
       </tbody>
     </table>

     <h2>Real TDEE calculation walkthrough</h2>
     <p>Let's calculate TDEE for a 32-year-old woman, 168 cm, 68 kg, moderately active:</p>
     <pre>BMR = 10 × 68 + 6.25 × 168 - 5 × 32 - 161
BMR = 680 + 1,050 - 160 - 161 = 1,409 calories/day

TDEE = 1,409 × 1.55 = 2,184 calories/day</pre>
     <p>This is her maintenance level. To lose ~1 lb per week, she would eat ~1,684 calories/day. To gain, she would eat ~2,434 calories/day. The <a href="/tdee-calculator/">TDEE calculator</a> computes this instantly.</p>

     <h2>Using TDEE with other tools</h2>
     <p>TDEE is the foundation for almost every other calorie and macro tool on this site. Pair your TDEE result with the <a href="/macro-calculator/">macro calculator</a> to split your calories into protein, carbs, and fats. Use the <a href="/weight-loss-calculator/">weight loss calculator</a> to estimate how long it will take to reach your goal. Track exercise impact with the <a href="/calories-burned-calculator/">calories burned calculator</a>. And for step-by-step guidance, read the <a href="/guides/maintenance-calorie-calculator/">maintenance calorie calculator guide</a> and the <a href="/guides/maintenance-calories/">maintenance calories guide</a>.</p>

     <Sources sources={[
       { label: "Dietary Reference Intakes for Energy — National Academies", href: "https://www.nap.edu/read/10490/chapter/1" },
       { label: "Energy expenditure — PubMed / NIH review", href: "https://pubmed.ncbi.nlm.nih.gov/2305711/" },
     ]} />
    </Fragment>
</CalculatorLayout>

<script>
  import { bmrMifflinStJeor, tdee, goalCalories, GOALS, type Sex, type ActivityKey, type GoalKey } from "../lib/calculations";
  import { lbToKg, ftInToCm } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    let unit: "metric" | "imperial" = "metric";

    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as Sex;
      const age = parseFloat(($("age") as HTMLInputElement).value) || 0;
      const activity = ($("activity") as HTMLSelectElement).value as ActivityKey;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      let h: number;
      if (unit === "imperial") { w = lbToKg(w); h = ftInToCm(parseFloat(($("height-ft") as HTMLInputElement).value) || 0, parseFloat(($("height-in") as HTMLInputElement).value) || 0); }
      else h = parseFloat(($("height-cm") as HTMLInputElement).value) || 0;
      return { sex, age, activity, w, h };
    }

    function render() {
      const { sex, age, activity, w, h } = read();
      if (w <= 0 || h <= 0 || age <= 0) return;
      const t = tdee(bmrMifflinStJeor(sex, age, h, w), activity);
      $("tdee-value").textContent = fmt(t);
      $("goals-table").innerHTML = (Object.keys(GOALS) as GoalKey[]).map((k) => {
        const c = goalCalories(t, k, sex);
        const hl = k === "maintain";
        return `<tr class="border-b border-hairline last:border-0 ${hl ? "bg-brand/5" : ""}"><td class="px-5 py-2.5 ${hl ? "font-medium text-ink" : "text-body"}">${GOALS[k].label}<span class="block text-xs text-mute">${GOALS[k].rate}</span></td><td class="px-5 py-2.5 text-right font-medium tabular-nums ${hl ? "text-ink" : "text-body"}">${fmt(c)}</td></tr>`;
      }).join("");
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return;
        unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        $("height-metric").classList.toggle("hidden", unit === "imperial");
        $("height-imperial").classList.toggle("hidden", unit === "metric");
        $("height-imperial").classList.toggle("grid", unit === "imperial");
        document.querySelectorAll(".weight-unit").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        document.querySelectorAll(".height-unit").forEach((e) => (e.textContent = unit === "metric" ? "(cm)" : "(ft / in)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
      });
    });
    ($("calc-form") as HTMLFormElement).addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
