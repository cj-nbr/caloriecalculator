---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import FaqSection from "../components/FaqSection.astro";
import Button from "../components/ui/Button.astro";
import { inputCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import {
  breadcrumbSchema,
  calculatorSchema,
  softwareApplicationSchema,
  faqSchema,
} from "../lib/seo";

const path = "/age-calculator/";
const h1 = "Age Calculator";
const description =
  "Free age calculator. Find your exact age in years, months, days, hours, and minutes from your date of birth — plus a countdown to your next birthday.";

const faqs: FaqItem[] = [
  { q: "How do I calculate my age?", a: "Enter your date of birth and the date you want to calculate your age on (today by default). The calculator works out the exact difference in years, months, and days." },
  { q: "How old am I exactly?", a: "Your exact age is the time elapsed since your birth date. This tool shows it in years, months, and days, and also as total months, weeks, days, hours, and minutes." },
  { q: "How is age calculated in years, months, and days?", a: "The calculator subtracts your birth date from the target date, borrowing days and months where needed (using the actual length of each month), so the result matches how age is counted in everyday life." },
  { q: "How many days until my next birthday?", a: "The calculator shows a countdown to your next birthday based on today's date — handy for planning celebrations." },
  { q: "Does the age calculator account for leap years?", a: "Yes. Because it uses real calendar dates, leap years (including February 29) are handled automatically." },
  { q: "Can I calculate age between two dates?", a: "Yes. Change the second date from today to any date to find the age or time difference between any two dates." },
  { q: "Is the age calculator free?", a: "Yes, completely free with no sign-up. All calculations run privately in your browser." },
];

const jsonLd = [
  breadcrumbSchema([{ name: "Home", path: "/" }, { name: h1, path }]),
  calculatorSchema(h1, description, path),
  softwareApplicationSchema(h1, description, path),
  faqSchema(faqs),
];
---

<Layout title="Age Calculator — Free Age Calculator by Date of Birth" description={description} canonical={path} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="border-b border-hairline bg-canvas-soft/40">
    <ol class="container-page flex items-center gap-2 py-3 text-xs text-mute">
      <li class="flex items-center gap-2"><a href="/" class="transition-colors hover:text-ink">Home</a></li>
      <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span class="text-body" aria-current="page">{h1}</span></li>
    </ol>
  </nav>

  <header class="relative overflow-hidden border-b border-hairline">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
    <div class="container-page py-12 sm:py-16">
      <h1 class="max-w-3xl text-display-lg text-ink">Age Calculator</h1>
      <p class="mt-4 max-w-2xl text-lg text-body">
        Find your exact age in years, months, and days from your date of birth —
        plus your age in total weeks, days, and hours, and a countdown to your
        next birthday.
      </p>
    </div>
  </header>

  <Section class="!py-12 sm:!py-16">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="age-root">
      <form id="age-form" class="card p-5 sm:p-6" novalidate>
        <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
          Example values are pre-filled. Enter your own details for accurate results.
        </p>
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label for="dob" class="block text-sm font-medium text-ink">Date of birth</label>
            <input id="dob" type="date" value="2000-01-01" class={inputCls} />
          </div>
          <div class="space-y-1.5">
            <label for="target" class="block text-sm font-medium text-ink">Age at the date of</label>
            <input id="target" type="date" class={inputCls} />
          </div>
        </div>
        <button type="submit" class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Age</button>
      </form>

      <div class="space-y-5">
        <div class="card p-6 sm:p-8 text-center">
          <p class="text-sm text-mute">Your age is</p>
          <p class="mt-1 text-display-md text-ink"><span id="a-years" class="tabular-nums">—</span> years, <span id="a-months" class="tabular-nums">—</span> months, <span id="a-days" class="tabular-nums">—</span> days</p>
          <p id="a-next" class="mt-2 text-sm text-body"></p>
        </div>
        <div class="card overflow-hidden">
          <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Your age in other units</h2></div>
          <table class="w-full text-sm"><tbody id="a-table"></tbody></table>
        </div>
        <p id="age-error" role="alert" class="hidden rounded-lg border border-error/40 bg-error/10 px-4 py-3 text-sm text-body"></p>
      </div>
    </div>
  </Section>

  <div class="border-t border-hairline">
    <div class="container-page py-12 sm:py-16">
      <div class="prose-content mx-auto max-w-3xl">
        <h2>How the age calculator works</h2>
        <p>This tool calculates the exact time between your date of birth and a target date (today by default). It counts full years first, then the remaining full months, then the leftover days — the same way age is counted in everyday life. Because it uses real calendar dates, it automatically accounts for months of different lengths and for leap years.</p>
        <h2>Age in years, months, and days</h2>
        <p>Most people give their age in whole years, but the precise figure includes the months and days since your last birthday. The headline result shows all three, while the table below breaks your age down into total months, weeks, days, hours, and minutes — useful for milestones and fun facts.</p>
        <h2>Counting down to your next birthday</h2>
        <p>The calculator also shows how many days remain until your next birthday, based on today's date, so you can plan ahead.</p>
        <h2>Using it for any two dates</h2>
        <p>You're not limited to "today" — change the second date to any date to measure the time between two dates, such as an anniversary or a future milestone.</p>
      </div>
    </div>
  </div>

  <Section class="border-t border-hairline">
    <FaqSection items={faqs} />
  </Section>

  <Section class="border-t border-hairline">
    <h2 class="text-display-sm text-ink">More calculators</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          { label: "Mortgage Calculator", href: "/mortgage-calculator/", desc: "Estimate monthly payments" },
          { label: "Calorie Calculator", href: "/", desc: "Daily calorie needs" },
          { label: "BMI Calculator", href: "/bmi-calculator/", desc: "Body mass index" },
        ].map((c) => (
          <a href={c.href} class="card group flex items-center justify-between gap-3 p-4 transition-all hover:border-hairline-strong hover:bg-canvas-soft">
            <div><span class="block text-sm font-medium text-ink">{c.label}</span><span class="block text-xs text-mute">{c.desc}</span></div>
            <svg class="h-4 w-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>

<script>
  const root = document.getElementById("age-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    const target = $("target") as HTMLInputElement;
    // default target = today
    const today = new Date();
    target.value = today.toISOString().slice(0, 10);

    function calc() {
      const dobV = ($("dob") as HTMLInputElement).value;
      const tgtV = (target.value || new Date().toISOString().slice(0, 10));
      const err = $("age-error");
      if (!dobV) return;
      const dob = new Date(dobV + "T00:00:00");
      const tgt = new Date(tgtV + "T00:00:00");
      if (tgt < dob) {
        err.textContent = "The second date is before the date of birth. Please check your dates.";
        err.classList.remove("hidden");
        return;
      }
      err.classList.add("hidden");

      let years = tgt.getFullYear() - dob.getFullYear();
      let months = tgt.getMonth() - dob.getMonth();
      let days = tgt.getDate() - dob.getDate();
      if (days < 0) {
        months--;
        // days in the month before the target month
        const prevMonth = new Date(tgt.getFullYear(), tgt.getMonth(), 0).getDate();
        days += prevMonth;
      }
      if (months < 0) { years--; months += 12; }

      $("a-years").textContent = String(years);
      $("a-months").textContent = String(months);
      $("a-days").textContent = String(days);

      const msPerDay = 86400000;
      const totalDays = Math.floor((tgt.getTime() - dob.getTime()) / msPerDay);
      const totalWeeks = Math.floor(totalDays / 7);
      const totalMonths = years * 12 + months;
      const totalHours = totalDays * 24;
      const totalMinutes = totalHours * 60;
      const fmt = (n: number) => n.toLocaleString("en-US");
      $("a-table").innerHTML =
        `<tr class="border-b border-hairline"><td class="px-5 py-2.5 text-body">Total months</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(totalMonths)}</td></tr>` +
        `<tr class="border-b border-hairline"><td class="px-5 py-2.5 text-body">Total weeks</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(totalWeeks)}</td></tr>` +
        `<tr class="border-b border-hairline"><td class="px-5 py-2.5 text-body">Total days</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(totalDays)}</td></tr>` +
        `<tr class="border-b border-hairline"><td class="px-5 py-2.5 text-body">Total hours</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(totalHours)}</td></tr>` +
        `<tr><td class="px-5 py-2.5 text-body">Total minutes</td><td class="px-5 py-2.5 text-right font-medium text-ink tabular-nums">${fmt(totalMinutes)}</td></tr>`;

      // next birthday (relative to today)
      const now = new Date(); now.setHours(0, 0, 0, 0);
      let next = new Date(now.getFullYear(), dob.getMonth(), dob.getDate());
      if (next < now) next = new Date(now.getFullYear() + 1, dob.getMonth(), dob.getDate());
      const daysToBday = Math.round((next.getTime() - now.getTime()) / msPerDay);
      $("a-next").textContent = daysToBday === 0 ? "🎉 Happy birthday — it's today!" : `${daysToBday} day${daysToBday === 1 ? "" : "s"} until your next birthday.`;
    }

    ($("age-form") as HTMLFormElement).addEventListener("submit", (e) => { e.preventDefault(); calc(); });
    calc();
  }
</script>
