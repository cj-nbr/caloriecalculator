---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "How accurate is a due date calculator?", a: "Due date calculators using LMP are accurate within 7-14 days. Only 5% of babies are born on their exact due date. First-trimester ultrasound is more precise." },
  { q: "What is Naegele's rule for due date?", a: "Naegele's rule: LMP date plus 280 days (40 weeks). This assumes 28-day cycles and conception on day 14. Our calculator applies this automatically." },
  { q: "How do I calculate due date without LMP?", a: "If LMP unknown, use IVF transfer date plus 266 days, or ultrasound measurements. Our calculator requires LMP for best accuracy." },
  { q: "Can I calculate due date from ovulation?", a: "Yes. Ovulation date plus 266 days equals estimated due date. Since ovulation is typically day 14 after LMP, this aligns with Naegele's rule." },
  { q: "What is the average pregnancy length?", a: "Full term is 40 weeks from LMP (38 weeks from conception). Normal range is 37-42 weeks. Babies can be healthy outside this range with medical support." },
];
---

<CalculatorLayout
  title="Due Date Calculator — Estimated Delivery Date from LMP"
  h1="Due Date Calculator"
  description="Calculate your estimated due date and pregnancy timeline from your last menstrual period."
  intro="Find your estimated delivery date and important pregnancy milestones."
  path="/due-date-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Enter the first day of your last menstrual period.
    </p>
      <div class="mb-4 space-y-1.5">
        <label for="lmp" class="block text-sm font-medium text-ink">Last Menstrual Period (LMP)</label>
        <input id="lmp" type="date" class={inputCls} />
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Due Date</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Estimated Due Date</p>
        <p id="due-date" class="mt-1 text-display-xl text-ink tabular-nums">—</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Conception Date (approx)</p><p id="conception" class="mt-1 text-display-sm text-ink tabular-nums">—</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Weeks Remaining</p><p id="weeks-left" class="mt-1 text-display-sm text-ink tabular-nums">—</p></div>
      </div>
      <div class="card overflow-hidden">
        <div class="border-b border-hairline px-5 py-3"><h2 class="text-sm font-semibold text-ink">Pregnancy Timeline</h2></div>
        <table class="w-full text-sm">
          <tbody id="timeline"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <MedicalNote strong />

    <ArticleImage src="/assets/images/articles/due-date-calendar.svg" alt="Illustration of a calendar showing estimated due date calculation from last menstrual period." />

    <h2>Due Date Calculation Method</h2>
    <p>Standard pregnancy is 40 weeks (280 days) from the first day of your last menstrual period. This is called Naegele's rule and is the most common method used by providers.</p>

    <h2>Why Due Dates Are Estimates</h2>
    <p>Only about 5% of babies arrive on their exact due date. Normal range is 37-42 weeks. Your provider may adjust the date based on ultrasound measurements or conception timing.</p>

    <h2>Related Calculators</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/pregnancy-calculator/">Pregnancy Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Full pregnancy timeline tracker.</p>
      </div>
      <div class="card p-4">
        <h3 class="text-lg font-semibold text-ink"><a href="/bmi-calculator/">BMI Calculator</a></h3>
        <p class="mt-1 text-sm text-body">Pre-pregnancy weight assessment.</p>
      </div>
    </div>
  </Fragment>
</CalculatorLayout>

<script>
  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
    const addDays = (date: Date, days: number) => { const d = new Date(date); d.setDate(d.getDate() + days); return d; };
    const diffDays = (a: Date, b: Date) => Math.round((b.getTime() - a.getTime()) / (1000 * 60 * 60 * 24));

    function render() {
      clearDirty();
      const lmpVal = ($("lmp") as HTMLInputElement).value;
      if (!lmpVal) return;
      const lmp = new Date(lmpVal);
      const dueDate = addDays(lmp, 280);
      const conceptionDate = addDays(lmp, 14);
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const weeksRemaining = Math.max(0, Math.ceil((dueDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24 * 7)));

      $("due-date").textContent = fmt(dueDate);
      $("conception").textContent = fmt(conceptionDate);
      $("weeks-left").textContent = `${weeksRemaining} weeks`;

      const events = [
        { t: addDays(lmp, 14), label: "Conception" },
        { t: addDays(lmp, 28), label: "4 weeks" },
        { t: addDays(lmp, 84), label: "12 weeks (end T1)" },
        { t: addDays(lmp, 140), label: "20 weeks (anatomy scan)" },
        { t: addDays(lmp, 196), label: "28 weeks (start T3)" },
        { t: dueDate, label: "40 weeks (due date)" },
      ];
      $("timeline").innerHTML = events.map(e => {
        const past = e.t < today ? " <span class='text-success'>✓</span>" : "";
        return `<tr class="border-b border-hairline last:border-0"><td class="px-5 py-2.5 text-body">${e.label}${past}</td><td class="px-5 py-2.5 text-right text-ink">${fmt(e.t)}</td></tr>`;
      }).join("");
    }

    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
