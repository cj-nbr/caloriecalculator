---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, segOptCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";
import Sources from "../components/ui/Sources.astro";
import MedicalNote from "../components/ui/MedicalNote.astro";
import ArticleImage from "../components/ui/ArticleImage.astro";

const faqs: FaqItem[] = [
  { q: "What is lean body mass?", a: "Lean body mass (LBM) is everything in your body that isn't fat — muscle, bone, organs, water, and connective tissue. It's a key reference point for setting protein needs and tracking muscle during weight changes." },
  { q: "How is lean body mass calculated?", a: "This calculator uses the Boer formula, which estimates LBM from your sex, height, and weight. It's one of the most widely used equations and works well for the general population." },
  { q: "Why does lean body mass matter?", a: "LBM drives your metabolism — more lean mass means a higher resting calorie burn. Preserving it during weight loss keeps your metabolism strong and your body looking toned rather than 'skinny fat'." },
  { q: "How can I increase lean body mass?", a: "Resistance training combined with adequate protein (1.6–2.2 g/kg) and a slight calorie surplus is the proven recipe for building lean mass over time." },
  { q: "How does LBM affect metabolism?", a: "Lean tissue burns about 15–25 kcal per kg per day at rest, while fat tissue burns less than 5 kcal/kg. More LBM means a higher BMR, which helps you burn more calories around the clock." },
  { q: "What's the difference between LBM and muscle mass?", a: "LBM includes muscle, bone, organs, and water. Muscle mass is just one part of LBM. You can have a high LBM from water weight or bones, but true muscle growth requires resistance training and protein." },
  { q: "How do I use LBM for protein calculations?", a: "Many coaches recommend 1.6–2.2 g of protein per kg of lean body mass for those in a deficit or building muscle. Our <a href='/protein-calculator/'>protein calculator</a> can help you target the right intake." },
  { q: "Is LBM more accurate than BMI for body composition?", a: "BMI is a height-to-weight ratio that cannot distinguish fat from muscle. LBM estimates your fat-free tissue directly, so it is far more useful for athletes, muscular individuals, or anyone tracking body composition changes." },
  { q: "How can I increase LBM naturally?", a: "Progressive resistance training, adequate protein, and a slight calorie surplus build LBM over months. Recovery and sleep are also essential. Avoid extreme deficits that force the body to burn muscle for energy." },
  { q: "What is a healthy lean body mass percentage?", a: "A healthy LBM is typically 70–85% of total body weight for men and 70–77% for women. Athletes often sit at the upper end. Use the <a href='/body-fat-calculator/'>body fat calculator</a> alongside LBM to get a fuller picture." },
];
---

<CalculatorLayout
  title="Lean Body Mass Calculator — Free LBM Calculator"
  h1="Lean Body Mass Calculator"
  description="Free lean body mass calculator using the Boer formula. Estimate your fat-free mass from height and weight."
  intro="Estimate your lean body mass — your fat-free weight — using the Boer formula. A key number for protein targets and muscle tracking."
  path="/lean-body-mass-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <MedicalNote />
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" role="tab" aria-selected="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" role="tab" aria-selected="false">Imperial</button>
      </div>
      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-ink">Gender</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class={segOptCls}><input type="radio" name="sex" value="male" class="sr-only" checked />Male</label>
          <label class={segOptCls}><input type="radio" name="sex" value="female" class="sr-only" />Female</label>
        </div>
      </fieldset>
      <div class="space-y-4">
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="u-wt text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" step="0.1" value="70" class={inputCls} /></div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-ink">Height <span class="u-len text-mute">(cm)</span></label>
          <div id="height-metric"><input id="height-cm" type="number" min="100" max="250" value="175" class={inputCls}  aria-label="Height in centimetres" /></div>
          <div id="height-imperial" class="hidden grid-cols-2 gap-3">
            <div class="relative"><input id="height-ft" type="number" min="3" max="8" value="5" class={inputCls}  aria-label="Height in feet" /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">ft</span></div>
            <div class="relative"><input id="height-in" type="number" min="0" max="11" value="9" class={inputCls}  aria-label="Height in inches" /><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-mute">in</span></div>
          </div>
        </div>
      </div>
      <button type="submit" id="calc-btn" class="shimmer-btn mt-5 inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate LBM</button>
    </form>

    <div class="space-y-5">
      <div id="result-box" class="card p-6 sm:p-8 text-center transition-all duration-300">
        <p class="text-sm text-mute">Lean body mass</p>
        <p class="mt-1"><span id="lbm-value" class="text-display-xl text-ink tabular-nums">57.1</span> <span class="text-lg text-mute u-wt">kg</span></p>
        <p class="mt-2 text-sm text-body"><span id="lbm-pct">82</span>% of your body weight is lean tissue.</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Lean mass</p><p id="lbm-lean" class="mt-1 text-display-sm text-ink tabular-nums">57.1</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Est. fat mass</p><p id="lbm-fat" class="mt-1 text-display-sm text-ink tabular-nums">12.9</p></div>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <ArticleImage src="/assets/images/articles/body-composition.svg" alt="Illustration of body composition showing lean mass and body fat as two parts of total body weight." />

    <h2>What lean body mass means</h2>
    <p>Lean body mass is your total weight minus fat mass. It includes skeletal muscle, organs, bones, connective tissue, blood, and water. Because muscle and organs are metabolically active, a higher LBM means you burn more calories at rest. This is why two people at the same weight can have very different energy needs.</p>

    <h2>How LBM affects metabolism</h2>
    <p>Muscle tissue is metabolically expensive. Each kilogram of lean mass adds roughly 15–25 kcal to your resting metabolic rate, while fat tissue adds less than 5 kcal/kg. When you lose weight, preserving LBM keeps your metabolism from slowing too much. When you gain muscle, your daily calorie budget rises naturally.</p>

    <h2>LBM vs muscle mass</h2>
    <p>Muscle mass is only one component of LBM. Bone mineral, organs, and body water also count. That means a high LBM does not guarantee a high muscle mass, and a low LBM does not necessarily mean low muscle. Use body fat percentage alongside LBM for a clearer body-composition picture. Check the <a href="/body-fat-calculator/">body fat calculator</a> to pair with these numbers.</p>

    <h2>How to increase LBM</h2>
    <p>Building lean mass requires three things: mechanical tension from resistance training, sufficient protein (1.6–2.2 g per kg of body weight for most active adults), and a small calorie surplus for growth. Track your protein using the <a href="/protein-calculator/">protein calculator</a> and your calories with the <a href="/macro-calculator/">macro calculator</a>. Prioritise compound lifts, progressive overload, and recovery.</p>

    <h2>LBM for protein calculations</h2>
    <p>Coaches often set protein relative to LBM rather than total weight, especially for people with higher body fat. For example, 1.8 g per kg of LBM is a common target for those in a deficit. Our <a href="/protein-calculator/">protein calculator</a> uses body weight by default, but you can adjust your target based on your LBM from this calculator.</p>

    <h2>LBM vs body fat percentage</h2>
    <p>Body fat percentage tells you what portion of your weight is fat; LBM tells you what the rest weighs. Together they show body composition more clearly than weight alone. An 80 kg person with 15% body fat has 12 kg of fat and 68 kg of LBM — a much more useful profile than simply weighing 80 kg.</p>

    <h2>LBM common questions</h2>
    <p>You can use LBM to estimate healthy weight ranges, set protein targets, and track muscle changes during a cut or bulk. It is especially valuable for lifters, athletes, and anyone who does not want the scale to hide muscle loss.</p>

    <Sources sources={[
      { label: "Boer P. Estimated lean body mass as an index for normalization of body fluid volumes in man. Am J Physiol. 1984.", href: "https://pubmed.ncbi.nlm.nih.gov/6742590/" },
      { label: "Institute of Medicine — Dietary Reference Intakes for Energy (2005)", href: "https://www.nationalacademies.org/publication/dietary-reference-intakes-for-energy" },
      { label: "American Council on Exercise — Body Composition and LBM", href: "https://www.acefitness.org/resources/everyone/exercise/1087/physical-activity-calorie-counter/" },
    ]} />
  </Fragment>
</CalculatorLayout>

<script>
  import { leanBodyMassBoer, type Sex } from "../lib/calculations";
  import { lbToKg, ftInToCm } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let isDirty = false;

    function markDirty() {
      if (isDirty) return;
      isDirty = true;
      const box = document.getElementById("result-box") || document.getElementById("calc-results");
      if (box) {
        box.querySelectorAll(".tabular-nums").forEach((el) => {
          el.textContent = "-.-";
        });
      }
      const btn = document.getElementById("calc-btn");
      if (btn) btn.classList.add("is-dirty");
    }

    function clearDirty() {
      isDirty = false;
      const box = $("result-box");
      if (box) box.classList.remove("opacity-40", "grayscale");
      const btn = $("calc-btn");
      if (btn) btn.classList.remove("is-dirty");
    }
    let unit: "metric" | "imperial" = "metric";

    function read() {
      const sex = (root!.querySelector('input[name="sex"]:checked') as HTMLInputElement).value as Sex;
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      let h: number;
      if (unit === "imperial") { w = lbToKg(w); h = ftInToCm(parseFloat(($("height-ft") as HTMLInputElement).value) || 0, parseFloat(($("height-in") as HTMLInputElement).value) || 0); }
      else h = parseFloat(($("height-cm") as HTMLInputElement).value) || 0;
      return { sex, w, h };
    }

    function render() {
      clearDirty();
      const { sex, w, h } = read();
      if (w <= 0 || h <= 0) return;
      const lbm = Math.max(0, leanBodyMassBoer(sex, h, w));
      const fat = Math.max(0, w - lbm);
      const conv = unit === "imperial" ? 2.2046226218 : 1;
      $("lbm-value").textContent = (lbm * conv).toFixed(1);
      $("lbm-lean").textContent = (lbm * conv).toFixed(1);
      $("lbm-fat").textContent = (fat * conv).toFixed(1);
      $("lbm-pct").textContent = String(Math.round((lbm / w) * 100));
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return; unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        $("height-metric").classList.toggle("hidden", unit === "imperial");
        $("height-imperial").classList.toggle("hidden", unit === "metric");
        $("height-imperial").classList.toggle("grid", unit === "imperial");
        document.querySelectorAll(".u-len").forEach((e) => (e.textContent = unit === "metric" ? "(cm)" : "(ft / in)"));
        document.querySelectorAll(".u-wt").forEach((e) => (e.textContent = unit === "metric" ? "kg" : "lb"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        markDirty();
      });
    });
    const form = $("calc-form") as HTMLFormElement;
    form.addEventListener("input", markDirty);
    form.addEventListener("submit", (e) => { e.preventDefault(); render(); });
  }
</script>
