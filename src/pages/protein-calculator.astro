---
import CalculatorLayout from "../layouts/CalculatorLayout.astro";
import { inputCls, selectCls } from "../lib/ui";
import type { FaqItem } from "../lib/seo";

const faqs: FaqItem[] = [
  { q: "How much protein do I need per day?", a: "Active adults generally need 1.2–2.0 g of protein per kilogram of body weight daily. Sedentary people need less (around 0.8 g/kg), while athletes building muscle benefit from the higher end (up to 2.2 g/kg)." },
  { q: "Is too much protein dangerous?", a: "For healthy people, high-protein diets are safe. Intakes up to about 2 g/kg show no harm in research. People with existing kidney disease should consult a doctor before increasing protein significantly." },
  { q: "When should I eat protein?", a: "Spreading protein across 3–4 meals of 25–40 g each maximizes muscle protein synthesis. Including protein at every meal also improves fullness and helps control overall calorie intake." },
  { q: "What are good protein sources?", a: "Chicken, fish, lean beef, eggs, Greek yogurt, cottage cheese, tofu, tempeh, lentils, beans, and protein powder are all excellent. Animal sources are 'complete', while combining plant sources covers all amino acids." },
];
---

<CalculatorLayout
  title="Protein Calculator — Daily Protein Intake Calculator (Free)"
  h1="Protein Calculator"
  description="Free protein calculator. Find your optimal daily protein intake in grams based on body weight and activity level."
  intro="Find how much protein you need each day to build muscle, lose fat, and stay healthy — based on your body weight and activity."
  path="/protein-calculator/"
  faqs={faqs}
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,380px)_1fr]" id="calc-root">
    <form id="calc-form" class="card p-5 sm:p-6" novalidate>
    <p role="note" class="mb-4 text-xs leading-relaxed text-mute">
      Example values are pre-filled. Enter your own details for accurate results.
    </p>
      <div class="mb-5 grid grid-cols-2 gap-1 rounded-full border border-hairline bg-canvas-soft p-1" role="tablist" aria-label="Unit system">
        <button type="button" data-unit="metric" class="unit-tab h-9 rounded-full text-sm font-medium bg-canvas text-ink shadow-sm" aria-pressed="true">Metric</button>
        <button type="button" data-unit="imperial" class="unit-tab h-9 rounded-full text-sm font-medium text-mute" aria-pressed="false">Imperial</button>
      </div>
      <div class="space-y-4">
        <div class="space-y-1.5"><label for="weight" class="block text-sm font-medium text-ink">Weight <span class="u-wt text-mute">(kg)</span></label><input id="weight" type="number" inputmode="decimal" step="0.1" value="70" class={inputCls} /></div>
        <div class="space-y-1.5">
          <label for="activity" class="block text-sm font-medium text-ink">Activity / goal</label>
          <div class="relative">
            <select id="activity" class={selectCls}>
              <option value="sedentary">Sedentary — maintain health</option>
              <option value="moderate" selected>Active — general fitness</option>
              <option value="athlete">Athlete — build / preserve muscle</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
          </div>
        </div>
      </div>
      <button type="submit" class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-full bg-ink text-base font-medium text-canvas transition-all hover:opacity-90 active:scale-[0.99]">Calculate Protein</button>
    </form>

    <div class="space-y-5">
      <div class="card p-6 sm:p-8 text-center">
        <p class="text-sm text-mute">Recommended daily protein</p>
        <p class="mt-1"><span id="p-range" class="text-display-xl text-ink tabular-nums">84–112</span> <span class="text-lg text-mute">g</span></p>
        <p class="mt-2 text-sm text-body">Aim for the higher end when building muscle or losing fat.</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">Per meal (4 meals)</p><p id="p-meal" class="mt-1 text-display-sm text-ink tabular-nums">~28 g</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wide text-mute">From protein</p><p id="p-cal" class="mt-1 text-display-sm text-ink tabular-nums">392 kcal</p></div>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <h2>Why protein matters most</h2>
    <p>Of the three macronutrients, protein deserves the most attention. It builds and repairs muscle, keeps you feeling full, has the highest thermic effect (your body burns more calories digesting it), and is the macro most strongly tied to body composition. Hitting your protein target is the single highest-leverage nutrition habit.</p>
    <h2>How much you really need</h2>
    <p>The old RDA of 0.8 g/kg prevents deficiency but is far below the optimum for active people. Research on muscle retention and growth supports 1.2–2.2 g/kg depending on your goals and training. During a <a href="/guides/weight-loss-guide/">calorie deficit</a>, higher protein is especially protective of muscle.</p>
    <h2>Putting it into practice</h2>
    <p>Spread your intake across the day — roughly 25–40 g per meal across 3–4 meals. Combine this target with your <a href="/macro-calculator/">macro split</a> and overall <a href="/">calorie target</a> for a complete nutrition plan.</p>
  </Fragment>
</CalculatorLayout>

<script>
  import { proteinTargetG, type ActivityKey } from "../lib/calculations";
  import { lbToKg } from "../lib/units";

  const root = document.getElementById("calc-root");
  if (root) {
    const $ = (id: string) => document.getElementById(id)!;
    let unit: "metric" | "imperial" = "metric";

    function render() {
      let w = parseFloat(($("weight") as HTMLInputElement).value) || 0;
      if (unit === "imperial") w = lbToKg(w);
      if (w <= 0) return;
      const activity = ($("activity") as HTMLSelectElement).value as ActivityKey;
      const { min, max } = proteinTargetG(w, activity);
      $("p-range").textContent = `${min}–${max}`;
      $("p-meal").textContent = `~${Math.round(((min + max) / 2) / 4)} g`;
      $("p-cal").textContent = `${Math.round(((min + max) / 2) * 4)} kcal`;
    }

    root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.unit as "metric" | "imperial";
        if (next === unit) return; unit = next;
        root.querySelectorAll<HTMLButtonElement>(".unit-tab").forEach((b) => { const on = b.dataset.unit === unit; b.setAttribute("aria-pressed", String(on)); b.classList.toggle("bg-canvas", on); b.classList.toggle("text-ink", on); b.classList.toggle("shadow-sm", on); b.classList.toggle("text-mute", !on); });
        document.querySelectorAll(".u-wt").forEach((e) => (e.textContent = unit === "metric" ? "(kg)" : "(lb)"));
        const wi = $("weight") as HTMLInputElement; const cv = parseFloat(wi.value) || 0;
        if (cv) wi.value = (unit === "imperial" ? cv * 2.2046226218 : cv / 2.2046226218).toFixed(1);
        render();
      });
    });
    ($("calc-form") as HTMLFormElement).addEventListener("submit", (e) => { e.preventDefault(); render(); });
    ($("activity") as HTMLSelectElement).addEventListener("change", render);
    render();
  }
</script>
